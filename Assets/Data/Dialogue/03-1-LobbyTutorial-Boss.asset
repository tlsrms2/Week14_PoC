  m_Name: 03-1-LobbyTutorial-Boss
  m_EditorClassIdentifier: Assembly-CSharp::Week14.Story.InGameStorySequenceSO
  episodeId: 5
  skippable: 0
  dialogues:
  - speaker: ERIS
    text: " \uC2E0\uC6D0\uC774 \uD2B9\uC815\uB41C \uC778\uBB3C\uB4E4\uC758 \uC704\uCE58\uB97C
      \uC804\uC220 \uD328\uB110\uC5D0 \uB4F1\uB85D\uD588\uC2B5\uB2C8\uB2E4. "
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512880
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uD574\uB2F9 \uC804\uC220 \uD328\uB110\uC744 \uD1B5\uD574 \uB300\uC0C1\uC758
      \uC815\uBCF4\uB97C \uD655\uC778\uD558\uACE0, \uD574\uB2F9 \uC704\uCE58\uB85C
      \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512881
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uD328\uB110\uC5D0 \uC811\uADFC\uD558\uBA74 \uB2E4\uC74C\uACFC \uAC19\uC740
      \uC778\uD130\uD398\uC774\uC2A4\uAC00 \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512882
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uC6D0\uD558\uB294 \uB300\uC0C1\uC744 <B><color=red>\uBC29\uBB38</b></color>\uD558\uACE0
      \uC790\uB8CC\uB97C \uD655\uBCF4\uD558\uC138\uC694. \uC720\uD6A8\uD55C \uC790\uB8CC\uAC00
      \uD655\uBCF4\uB418\uBA74 \uBC14\uB85C \uBD84\uC11D\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512883
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uC774\uBBF8 <b><color=red>\uBC29\uBB38</b></color>\uC744 \uC644\uB8CC\uD55C
      \uB300\uC0C1\uC774\uB354\uB77C\uB3C4, \uD574\uB2F9 \uC778\uBB3C\uC758 \uB370\uC774\uD130\uB97C
      \uAE30\uB85D\uD558\uC5EC \uBC18\uBCF5\uD558\uC5EC \uC804\uD22C\uAC00 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512884
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uCD94\uAC00 \uC870\uAC74\uC744 \uB2EC\uC131\uD558\uBA74 \uBD84\uC11D\uD560
      \uC0AC\uAC74 \uC790\uB8CC \uC774\uC678\uC5D0\uB3C4 \uB354 \uB9CE\uC740 \uC804\uD22C
      \uB370\uC774\uD130\uB97C \uD655\uBCF4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512885
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uC218\uC9D1\uD55C \uB370\uC774\uD130 \uCE69\uC740 \uC774\uD6C4 \uC7A5\uBE44\uC758
      \uC131\uB2A5\uC744 \uD5A5\uC0C1\uC2DC\uD0A4\uB294 \uBAA8\uB4C8 \uD655\uC7A5\uC5D0
      \uC0AC\uC6A9\uB418\uBBC0\uB85C \uC804\uD22C\uAC00 \uAE4C\uB2E4\uB86D\uB2E4\uBA74
      \uB370\uC774\uD130 \uCE69 \uD655\uBCF4\uB97C \uC6B0\uC120\uD558\uB294 \uAC83\uC744
      \uAD8C\uC7A5\uD569\uB2C8\uB2E4."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
