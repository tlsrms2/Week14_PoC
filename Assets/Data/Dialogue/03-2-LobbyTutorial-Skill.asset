  m_Script: {fileID: 11500000, guid: b2e1d52387b43224a9e8fed941adda42, type: 3}
  m_Name: 03-2-LobbyTutorial-Skill
  m_EditorClassIdentifier: Assembly-CSharp::Week14.Story.InGameStorySequenceSO
  episodeId: 6
  skippable: 0
  dialogues:
  - speaker: ERIS
    text: " \uC804\uD22C \uB370\uC774\uD130 \uCE69\uC744 \uC5B4\uB290 \uC815\uB3C4
      \uD655\uBCF4 \uD558\uC168\uC73C\uB2C8, \uBAA8\uB4C8 \uD655\uC7A5 \uAE30\uB2A5\uC5D0
      \uB300\uD574 \uC124\uBA85\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
    sfxId: 
  - speaker: ERIS
    text: " \uD574\uB2F9 \uBAA8\uB4C8 \uD328\uB110\uC5D0 \uC811\uADFC\uD558\uBA74
      \uC774\uC2DD\uD55C \uC7A5\uBE44\uC758 \uC131\uB2A5\uC744 \uD5A5\uC0C1\uC2DC\uD0AC
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    sfxId: 
  - speaker: ERIS
    text: " \uD328\uB110\uC5D0 \uC811\uADFC\uD558\uBA74 \uB2E4\uC74C\uACFC \uAC19\uC740
      \uC778\uD130\uD398\uC774\uC2A4\uAC00 \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    sfxId: 
  - speaker: ERIS
    text: " \uBCF4\uC720\uD558\uC2E0 \uC804\uD22C \uB370\uC774\uD130 \uCE69\uC744
      \uC18C\uBAA8\uD558\uC5EC \uC6D0\uD558\uC2DC\uB294 \uBAA8\uB4C8\uC744 \uD655\uC7A5\uD558\uACE0,
      \uC7A5\uCC29\uD558\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    sfxId: 
  - speaker: ERIS
    text: " \uD655\uC7A5 \uC644\uB8CC\uD55C \uBAA8\uB4C8\uC740 \uC790\uC720\uB86D\uAC8C
      \uBCC0\uACBD\uC774 \uAC00\uB2A5\uD558\uC9C0\uB9CC, \uB3D9\uC77C\uD55C \uD0C0\uC785\uC758
      \uBAA8\uB4C8\uC740 \uC911\uBCF5\uD574\uC11C \uCC29\uC6A9\uC774 \uBD88\uAC00\uB2A5\uD558\uB2C8
      \uC8FC\uC758\uD558\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4."
    sfxId: 
  - speaker: ERIS
    text: " \uC120\uD0DD\uD55C \uBAA8\uB4C8\uC744 \uB370\uC774\uD130 \uCE69\uC73C\uB85C
      \uB2E4\uC2DC \uBC18\uD658\uD560 \uC218\uB3C4 \uC788\uC73C\uB2C8, \uC804\uD22C\uAC00
      \uAE4C\uB2E4\uB86D\uB2E4\uBA74 \uC5EC\uB7EC \uBAA8\uB4C8 \uC870\uD569\uC744
      \uD65C\uC6A9\uD574\uBCF4\uC2DC\uB294 \uAC83\uC744 \uAD8C\uC7A5\uD569\uB2C8\uB2E4."
    sfxId: 
