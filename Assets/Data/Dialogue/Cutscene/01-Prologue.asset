    legacyWaitForInput: 0
  - backgroundImage: {fileID: 21300000, guid: 079e51a4c783f264e96d81a0f0e9712b, type: 3}
    dialogues:
    - name: ERIS
      text: "\uC6B0\uCE21 \uC0C1\uC9C0 \uACB0\uC190, \uC548\uBA74\uBD80\uC5D0\uC11C
        \uACAC\uBD80\uAE4C\uC9C0 \uC774\uC5B4\uC9C0\uB294 \uAD11\uBC94\uC704\uD55C
        \uD654\uC0C1 \uBC0F \uC2E0\uACBD\uACC4 \uC190\uC0C1\uC774 \uAC10\uC9C0\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
      sfxId: 
    - name: ERIS
      text: "\uCD9C\uC785 \uD5C8\uAC00. \uC989\uC2DC \uC751\uAE09\uCC98\uCE58 \uBC1B\uC744
        \uAC83\uC744 \uAD8C\uC7A5\uD569\uB2C8\uB2E4."
      sfxId: 
    - name: ERIS
      text: "\uCD94\uAC00\uB85C \uC694\uCCAD\uC0AC\uD56D\uC774 \uC788\uC73C\uC2E0\uAC00\uC694?"
      sfxId: 
    - name: "\uC774\uC628"
      text: "...R-2 \uBE14\uB85D, \uCE74\uD398 \uBCA0\uC2A4\uD37C. \uC624\uB298 17\uC2DC
        33\uBD84 \uC804\uD6C4 \uC601\uC0C1 \uAE30\uB85D \uC804\uBD80."
      sfxId: 
    skippable: 1
    bgmId: 
    bgmFadeSeconds: 0
    transitionMode: 0
    fadeInSeconds: 2
    fadeOutSeconds: 0.25
    darkHoldSeconds: 0
    motionSeconds: 0
    startOffset: {x: 0, y: 0}
    endOffset: {x: 0, y: 0}
    startZoom: 1
    endZoom: 1
    legacySpeakerName: 
    legacyDialogueText: 
    legacyWaitForInput: 0
  - backgroundImage: {fileID: 21300000, guid: a756fa2679354cc4583b66048b9fc0a6, type: 3}
    dialogues:
    - name: ERIS
      text: "\uC2E0\uCCB4 \uAE30\uB2A5 \uC218\uBCF5\uB960 79%. \uC6B0\uCE21 \uC758\uC218
        \uC2E0\uACBD \uC811\uC18D\uC744 \uC644\uB8CC\uD588\uC2B5\uB2C8\uB2E4."
      sfxId: 
    - name: ERIS
      text: "\uC694\uCCAD\uC5D0 \uB530\uB77C ARGUS \uC804\uC220 \uC758\uC548\uC758
        \uC2DC\uAC01 \uBCF4\uC815 \uAE30\uB2A5\uC744 \uC758\uC218\uC758 \uC6B4\uB3D9
        \uC81C\uC5B4\uACC4\uC640 \uC5F0\uB3D9\uD588\uC2B5\uB2C8\uB2E4."
      sfxId: 
    - name: ERIS
      text: "\uCD94\uAC00\uB85C AEGIS \uCF54\uC5B4 \uC778\uD130\uD398\uC774\uC2A4\uB97C
        \uC2E0\uACBD\uACC4\uC5D0 \uC774\uC2DD\uD588\uC2B5\uB2C8\uB2E4. \uC801\uC751
        \uD6C8\uB828\uC744 \uB9C8\uCE58\uBA74 \uBC18\uC751 \uC18D\uB3C4\uC640 \uC870\uC791
        \uC815\uBC00\uB3C4\uB97C \uC190\uC2E4 \uC774\uC804\uBCF4\uB2E4 \uD5A5\uC0C1\uC2DC\uD0AC
        \uC218 \uC788\uC744 \uAC83\uC73C\uB85C \uC608\uC0C1\uB429\uB2C8\uB2E4."
      sfxId: 
    - name: "\uC774\uC628"
      text: "\uBCA0\uC2A4\uD37C \uC790\uB8CC\uB294?"
      sfxId: 
    - name: ERIS
      text: "\uD3ED\uBC1C\uB85C \uC6D0\uBCF8 \uAE30\uB85D \uB300\uBD80\uBD84\uC774
        \uC720\uC2E4\uB418\uC5B4, \uC778\uADFC \uAE30\uB85D \uC7A5\uCE58\uC5D0 \uB0A8\uC740
        \uD30C\uD3B8\uB4E4\uB85C \uB370\uC774\uD130\uB97C \uC7AC\uAD6C\uC131 \uC911\uC785\uB2C8\uB2E4."
      sfxId: 
    - name: ERIS
      text: "\uC2DC\uAC04\uC774 \uC5B4\uB290\uC815\uB3C4 \uC18C\uC694\uB420 \uAC83\uC73C\uB85C
        \uC608\uC0C1\uB418\uBBC0\uB85C, \uAE30\uB2E4\uB9AC\uB294 \uB3D9\uC548 \uC801\uC751
        \uD6C8\uB828\uC744 \uC9C4\uD589\uD560 \uAC83\uC744 \uAD8C\uC7A5\uD569\uB2C8\uB2E4."
      sfxId: 
    - name: "\uC774\uC628"
      text: "\uC2DC\uC791\uD574."
      sfxId: 
    skippable: 1
    bgmId: 
    bgmFadeSeconds: 0
    transitionMode: 0
    fadeInSeconds: 2
    fadeOutSeconds: 0.25
    darkHoldSeconds: 0
    motionSeconds: 0
