  m_Name: 02-Past
  m_EditorClassIdentifier: Assembly-CSharp::Week14.Cutscene.CutsceneDefinition
  cutsceneId: MainStory-0
  skippable: 0
  steps:
  - backgroundImage: {fileID: 21300000, guid: ca9c35ca7a0670347ab1fdc20a8bd4b1, type: 3}
    dialogues:
    - name: ERIS
      text: "\uC2E0\uC6D0\uC744 \uD655\uC778\uD569\uB2C8\uB2E4."
      sfxId: 
    - name: ERIS
      text: "\uCF54\uB4DC\uBA85 \uC774\uC628, \uB4F1\uAE09 K26, \uC218\uD589 \uC911\uC778
        \uC784\uBB34 \uC5C6\uC74C."
      sfxId: 
    - name: ERIS
      text: "\uD2B9\uC774\uC0AC\uD56D."
      sfxId: 
    skippable: 0
    bgmId: 
    bgmFadeSeconds: 0
    transitionMode: 0
