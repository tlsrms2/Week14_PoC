  m_Script: {fileID: 11500000, guid: f36dd03c7b37aab4184bb98d7cf7c128, type: 3}
  m_Name: 07-Epilogue
  m_EditorClassIdentifier: Assembly-CSharp::Week14.Cutscene.CutsceneDefinition
  skippable: 1
  steps:
  - backgroundImage: {fileID: 21300000, guid: ccdbe1a0b7096a1458ece35bad79a014, type: 3}
    dialogues:
    - name: "\uC774\uC628"
      text: "...\uB098 \uC654\uC5B4. \uC544\uBE60."
      sfxId: 
    - name: "\uC774\uC628"
      text: ...
      sfxId: 
    - name: "\uC774\uC628"
      text: "\uB098\uB3C4 \uC544\uBE60\uCC98\uB7FC... \uC88B\uC740 \uC0AC\uB78C\uC774
        \uB418\uACE0 \uC2F6\uC5C8\uB294\uB370..."
      sfxId: 
    - name: "\uC774\uC628"
      text: "\uD615\uD0DC\uB294 \uC870\uAE08 \uB2EC\uB77C\uB3C4.. \uC0AC\uB78C\uB4E4\uC744
        \uAD6C\uD558\uB294 \uC0AC\uB78C\uC774 \uB418\uACE0 \uC2F6\uC5C8\uB294\uB370..."
      sfxId: 
    - name: "\uC774\uC628"
      text: "\uC0AC\uB791\uD558\uB294 \uAC00\uC871\uB3C4 \uC9C0\uD0A4\uC9C0 \uBABB\uD588\uC5B4..
        \uB098\uB294..."
      sfxId: 
    - name: "\uC774\uC628"
      text: "<b><color=red>\uC88B\uC740 \uC0AC\uB78C\uC774 \uB354\uB294 \uC0C1\uCC98\uBC1B\uC9C0
        \uC54A\uB294 \uC138\uC0C1\uC744 \uB9CC\uB4E4\uACE0 \uC2F6\uC5B4.</b></color>"
      sfxId: 
    - name: ERIS
      text: " \uCF54\uB4DC\uBA85 \uC774\uC628, \uC9C4\uC758 \uC790\uB8CC\uB97C \uC870\uC0AC\uD574\uBCF8
        \uACB0\uACFC \uC0AC\uAC74\uACFC \uC5F0\uAD00\uC774 \uC788\uC5B4 \uBCF4\uC774\uB294
        \uC778\uBB3C\uB4E4\uC758 \uBD84\uC11D\uC744 \uB05D\uB0C8\uC2B5\uB2C8\uB2E4."
      sfxId: 
    - name: ERIS
      text: " \uBA85\uB2E8\uC744 \uC804\uC1A1\uD574\uB4DC\uB9B4\uAE4C\uC694?"
      sfxId: 
    - name: "\uC774\uC628"
      text: ' ...'
      sfxId: 
    skippable: 0
    bgmId: 
    bgmFadeSeconds: 0
    transitionMode: 0
    fadeInSeconds: 1
    fadeOutSeconds: 0.5
    darkHoldSeconds: 0.5
    motionSeconds: 0
    startOffset: {x: 0, y: 0}
    endOffset: {x: 0, y: 0}
