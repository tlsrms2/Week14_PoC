    legacyDialogueText: 
    legacyWaitForInput: 0
  - backgroundImage: {fileID: 21300000, guid: 3af9cceafe4e9e642adcd0cf0ec43971, type: 3}
    dialogues:
    - name: "\uC544\uBC84\uC9C0"
      text: " \uD558\uC9C0\uB9CC.. \uADF8\uB798. \uB54C\uB85C\uB294 \uC218\uC220\uC774
        \uD544\uC694\uD55C \uACBD\uC6B0\uAC00 \uC788\uACA0\uC9C0. "
      sfxId: 
    - name: "\uC544\uBC84\uC9C0"
      text: " \uADF8\uB7F0\uB370 \uB9D0\uC774\uB2E4. \uC0AC\uB78C\uC744 \uC0B4\uB9B4
        \uB54C \uC911\uC694\uD55C \uAC74,"
      sfxId: 
    - name: "\uC544\uBC84\uC9C0"
      text: " <b><color=red>\uB098\uC05C \uC870\uC9C1\uC744 \uC798\uB77C\uB0B4\uB294
        \uAC83</b></color> \uBFD0 \uC544\uB2C8\uB77C, \uCE7C\uC744 \uB0B4\uB824\uB193\uACE0
        \uC0C1\uCC98\uB97C \uBD09\uD569\uD558\uB294 \uC77C\uB3C4 \uC911\uC694\uD558\uB2E8\uB2E4."
      sfxId: 
    - name: "\uC774\uC628"
      text: " \uC798 \uBAA8\uB974\uACA0\uC5B4..."
      sfxId: 
    - name: "\uC544\uBC84\uC9C0"
      text: " \uC6B0\uB9AC \uB538\uC740 \uB611\uB611\uD558\uB2C8\uAE4C \uC5B8\uC820\uAC00
        \uC774\uD574\uD560 \uAC70\uB77C \uC0DD\uAC01\uD55C\uB2E4. "
      sfxId: 
    skippable: 0
    bgmId: 
