%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f36dd03c7b37aab4184bb98d7cf7c128, type: 3}
  m_Name: PrologueCutscene
  m_EditorClassIdentifier: Assembly-CSharp::Week14.Cutscene.CutsceneDefinition
  skippable: 0
  steps:
  - backgroundImage: {fileID: 7640050904975471892, guid: 8dce11bad2a62254b8fb1827da9a9374, type: 3}
    dialogues:
    - name: AI
      text: "\uD0AC\uB7EC \uC2DC\uC124 \uC758\uB8CC\uB3D9 \uC811\uC18D \uD655\uC778.
        \uC774\uC628, \uADC0\uD658\uC744 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4."
      sfxId: 
    - name: AI
      text: "\uC88C\uCE21 \uC548\uBA74\uBD80\uC640 \uC808\uB2E8\uBD80\uC758 \uC0DD\uCCB4
        \uC2E0\uD638\uAC00 \uBD88\uC548\uC815\uD569\uB2C8\uB2E4. \uBD80\uC0C1\uC774
        \uC2EC\uAC01\uD569\uB2C8\uB2E4. \uC989\uC2DC \uC751\uAE09 \uCE58\uB8CC\uB97C
        \uAD8C\uD569\uB2C8\uB2E4."
      sfxId: 
    - name: "\uC774\uC628"
      text: "\uCE58\uB8CC\uBCF4\uB2E4 \uBA3C\uC800, \uADF8 \uCE74\uD398 \uAE30\uB85D\uC744
        \uD2C0\uC5B4."
      sfxId: 
    - name: AI
      text: "\uD574\uB2F9 \uAE30\uB85D\uC740 \uC678\uC0C1 \uAE30\uC5B5\uC744 \uAC15\uD558\uAC8C
        \uC790\uADF9\uD560 \uAC00\uB2A5\uC131\uC774 \uB192\uC2B5\uB2C8\uB2E4. \uC7AC\uC0DD
        \uC804 \uCC98\uCE58\uB97C \uBA3C\uC800 \uC9C4\uD589\uD558\uB294 \uD3B8\uC774
        \uC548\uC804\uD569\uB2C8\uB2E4."
      sfxId: 
    - name: "\uC774\uC628"
      text: "\uC548\uC804\uD55C \uAC70 \uACE0\uB974\uB824\uACE0 \uC5EC\uAE30\uAE4C\uC9C0
        \uC628 \uAC70 \uC544\uB2C8\uC57C. \uC7AC\uC0DD\uD574."
      sfxId: 
    - name: AI
      text: "\uC694\uCCAD \uD655\uC778. \uCE74\uD398 \uBCF4\uC548 \uAE30\uB85D\uC744
        \uBCF5\uC6D0\uD569\uB2C8\uB2E4."
      sfxId: 
    - name: AI
      text: "\uAE30\uB85D \uC2DC\uAC01, \uD3ED\uBC1C \uC0AC\uACE0 \uB2F9\uC77C 17\uC2DC
        42\uBD84. \uC7A5\uC18C\uB294 \uB3C4\uC2DC \uC678\uACFD\uC758 \uC18C\uD615
        \uCE74\uD398\uC785\uB2C8\uB2E4."
      sfxId: 
    - name: AI
      text: "\uC190\uC0C1\uB41C \uC74C\uC131 \uAD6C\uAC04\uC744 \uBCF4\uC815\uD569\uB2C8\uB2E4.
        \uC601\uC0C1 \uC7AC\uC0DD\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4."
      sfxId: 
    skippable: 0
    bgmId: 
    bgmFadeSeconds: 0
    transitionMode: 0
    fadeInSeconds: 1
    fadeOutSeconds: 0.5
    darkHoldSeconds: 0.5
    motionSeconds: 0
    startOffset: {x: 0, y: 0}
    endOffset: {x: 0, y: 0}
    startZoom: 1
    endZoom: 1
    legacySpeakerName: 
    legacyDialogueText: 
    legacyWaitForInput: 0
  - backgroundImage: {fileID: 4312963911456712316, guid: 09c246161e9fa17478b4d35ac0653599, type: 3}
    dialogues:
    - name: AI
      text: "\uAE30\uB85D \uC7AC\uC0DD \uC885\uB8CC. \uD3ED\uBC1C \uC9C1\uD6C4 \uBCF4\uD638\uC790\uB294
        \uD604\uC7A5\uC5D0\uC11C \uC0AC\uB9DD, \uC774\uC628\uC740 \uC88C\uCE21 \uD314\uACFC
        \uC548\uBA74\uBD80\uC5D0 \uCE58\uBA85\uC801 \uC190\uC0C1\uC744 \uC785\uC5C8\uC2B5\uB2C8\uB2E4."
      sfxId: 
    - name: AI
      text: "\uBCF5\uC218 \uC218\uD589\uC744 \uC704\uD55C \uC0AC\uC774\uBCF4\uADF8\uD654
        \uC2DC\uC220 \uC694\uCCAD \uAE30\uB85D\uC774 \uC774\uC5B4\uC9D1\uB2C8\uB2E4.
        \uBE44\uAC00\uC5ED\uC801 \uAC1C\uC870\uC774\uBA70 \uD1B5\uC99D \uD53C\uB4DC\uBC31\uC740
        \uC644\uC804\uD788 \uCC28\uB2E8\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
      sfxId: 
    - name: "\uC774\uC628"
      text: "\uC0C1\uAD00\uC5C6\uC5B4. \uC6C0\uC9C1\uC77C \uC218 \uC788\uAC8C \uB9CC\uB4E4\uACE0,
        \uC2F8\uC6B8 \uC218 \uC788\uAC8C \uB9CC\uB4E4\uC5B4."
      sfxId: 
    - name: AI
      text: "\uC2DC\uC220 \uC2B9\uC778. \uC7A5\uBE44 \uB3D9\uAE30\uD654 \uD6C4 \uC801\uC751
        \uD6C8\uB828\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4."
      sfxId: 
    - name: "\uC774\uC628"
      text: "\uC2DC\uC791\uD574."
      sfxId: 
    skippable: 0
    bgmId: 
    bgmFadeSeconds: 0
    transitionMode: 0
    fadeInSeconds: 1
    fadeOutSeconds: 0.5
    darkHoldSeconds: 0.5
