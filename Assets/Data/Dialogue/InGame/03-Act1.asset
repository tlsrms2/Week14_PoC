%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b2e1d52387b43224a9e8fed941adda42, type: 3}
  m_Name: 03-Act1
  m_EditorClassIdentifier: Assembly-CSharp::Week14.Story.InGameStorySequenceSO
  episodeId: 0
  skippable: 1
  dialogues:
  - speaker: ERIS
    text: "\uC601\uC0C1 \uAE30\uB85D\uC774 \uC885\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uCD5C\uC120\uC744 \uB2E4\uD574 \uC7AC\uAD6C\uC131\uD588\uC73C\uB098 \uC77C\uBD80\uBD84
      \uC720\uC2E4\uB41C \uC810 \uC591\uD574 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4."
    sfxId: 
  - speaker: "\uC774\uC628"
    text: "...\uC774 \uC815\uB3C4\uBA74 \uAD1C\uCC2E\uC544. \uD3ED\uBC1C\uBB3C\uC758
      \uCD9C\uCC98\uB294?"
    sfxId: 
  - speaker: AI
    text: "\uCCAB \uBC88\uC9F8 \uB300\uC0C1\uC740 \uBB34\uAE30 \uC0C1\uC778\uC785\uB2C8\uB2E4.
      \uD3ED\uBC1C\uBB3C \uD30C\uD3B8\uC5D0\uC11C \uB098\uC628 \uBD80\uD488\uC758
      \uC720\uD1B5 \uACBD\uB85C\uB97C \uC5ED\uCD94\uC801\uD588\uC2B5\uB2C8\uB2E4."
    sfxId: 
  - speaker: AI
    text: "\uD0AC\uB7EC\uB4E4\uC774 \uC790\uC8FC \uAC70\uB798\uD558\uB294 \uC0C1\uC778
      \uB370\uC774\uD130\uBCA0\uC774\uC2A4\uC640 \uB300\uC870\uD55C \uACB0\uACFC,
      \uC0AC\uAC74 \uC774\uD2C0 \uC804 \uB3D9\uC77C \uACC4\uC5F4 \uD488\uBAA9\uC758
      \uD310\uB9E4 \uAE30\uB85D\uC774 \uD655\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    sfxId: 
  - speaker: "\uC774\uC628"
    text: "\uD3ED\uD0C4\uC744 \uB9CC\uB4E0 \uB188\uC774 \uC544\uB2C8\uB77C, \uC7AC\uB8CC\uB97C
      \uD310 \uB188\uC774\uB77C\uB294 \uAC70\uAD70."
    sfxId: 
  - speaker: AI
    text: "\uC815\uD655\uD569\uB2C8\uB2E4. \uB2E4\uB9CC \uB2E8\uC21C\uD55C \uC0C1\uC778\uC740
      \uC544\uB2D9\uB2C8\uB2E4. \uBB34\uAE30\uD654\uB41C \uD0D1\uC2B9 \uC7A5\uBE44\uB97C
      \uBCF4\uC720\uD558\uACE0 \uC788\uC73C\uBA70, \uC9C1\uC811\uC801\uC778 \uAD50\uC804
      \uB2A5\uB825\uB3C4 \uD655\uC778\uB429\uB2C8\uB2E4."
    sfxId: 
  - speaker: AI
    text: "\uB450 \uBC88\uC9F8 \uB300\uC0C1\uC740 \uACBD\uD638\uC2E4\uC7A5\uC73C\uB85C
      \uCD94\uC815\uB429\uB2C8\uB2E4. \uD3ED\uD0C4\uC774 \uC120\uBB3C \uD615\uD0DC\uB85C
      \uD604\uC7A5\uC5D0 \uBC18\uC785\uB41C \uACBD\uB85C\uC640, \uD574\uB2F9 \uC778\uBB3C\uC758
      \uC774\uB3D9 \uAE30\uB85D\uC774 \uACB9\uCE69\uB2C8\uB2E4."
    sfxId: 
  - speaker: "\uC774\uC628"
    text: "\uBC30\uB2EC \uB2F4\uB2F9\uC778\uAC00."
    sfxId: 
  - speaker: AI
    text: "\uAC00\uB2A5\uC131\uC774 \uB192\uC2B5\uB2C8\uB2E4. \uAC15\uD654 \uC7A5\uBE44\uB97C
      \uC774\uC6A9\uD55C \uC721\uD0C4\uC804\uC5D0 \uD2B9\uD654\uB41C \uC778\uBB3C\uB85C
      \uBCF4\uC774\uBA70, \uADFC\uC811 \uAD50\uC804 \uAC70\uB9AC\uC5D0\uC11C\uB294
      \uC704\uD5D8\uB3C4\uAC00 \uD06C\uAC8C \uC0C1\uC2B9\uD569\uB2C8\uB2E4."
    sfxId: 
  - speaker: "\uC774\uC628"
    text: "\uB458 \uB2E4 \uAF2C\uB9AC \uCABD\uC774\uB124. \uBA38\uB9AC\uB294 \uC544\uB2C8\uC57C."
    sfxId: 
  - speaker: AI
    text: "\uADF8\uB807\uC2B5\uB2C8\uB2E4. \uB450 \uC778\uBB3C\uC740 \uAC04\uC811
      \uAD00\uC5EC\uC790\uB85C \uD310\uB2E8\uB429\uB2C8\uB2E4. \uBC30\uD6C4\uC5D0
      \uC788\uB294 \uC778\uBB3C, \uB610\uB294 \uC6D0\uB798 \uD45C\uC801\uC774\uC5C8\uB358
      \uD658\uC790 \uBCF8\uC778\uC744 \uCC3E\uC544\uC57C \uD569\uB2C8\uB2E4."
    sfxId: 
  - speaker: AI
    text: "\uD558\uC9C0\uB9CC \uBE44\uACF5\uC778 \uC784\uBB34\uC758 \uC81C\uC57D
      \uB54C\uBB38\uC5D0 \uC774 \uC774\uC0C1\uC758 \uC815\uBCF4 \uC9C0\uC6D0\uC740
      \uBD88\uAC00\uB2A5\uD569\uB2C8\uB2E4."
    sfxId: 
  - speaker: "\uC774\uC628"
    text: "\uB3C8\uC740 \uBC1B\uC558\uC73C\uBA74\uC11C \uC120\uC744 \uAE0B\uB294
      \uAC74 \uCC38 \uBE60\uB974\uB124."
    sfxId: 
  - speaker: AI
    text: "\uACF5\uC2DD \uC784\uBB34\uB97C \uC218\uB77D\uD558\uAC70\uB098, \uAE30\uC874
      \uBC29\uC2DD\uB300\uB85C \uC9C1\uC811 \uBC29\uBB38\uD574 \uC2A4\uB9C8\uD2B8\uD3F0\uACFC
      \uC11C\uB958 \uB4F1\uC758 \uC790\uB8CC\uB97C \uD655\uBCF4\uD558\uBA74 \uCD94\uAC00
      \uBD84\uC11D\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    sfxId: 
  - speaker: "\uC774\uC628"
    text: "\uBC29\uBB38\uC774\uB77C. \uC88B\uC740 \uB9D0\uC774\uB124."
    sfxId: 
  - speaker: AI
    text: "\uC6B0\uC120 \uB450 \uB300\uC0C1\uACFC \uC811\uCD09\uD558\uC2ED\uC2DC\uC624.
      \uD655\uBCF4\uD55C \uC790\uB8CC\uAC00 \uC788\uB2E4\uBA74 \uC989\uC2DC \uBD84\uC11D\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    sfxId: 
  - speaker: "\uC774\uC628"
    text: "\uC88B\uC544. \uBA3C\uC800 \uB9D0\uC774 \uD1B5\uD560 \uAC83 \uAC19\uC740
      \uB188\uBD80\uD130 \uB9CC\uB098\uBCF4\uC790."
    sfxId: 
