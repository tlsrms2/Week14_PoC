  m_Script: {fileID: 11500000, guid: b2e1d52387b43224a9e8fed941adda42, type: 3}
  m_Name: 04-Act2
  m_EditorClassIdentifier: Assembly-CSharp::Week14.Story.InGameStorySequenceSO
  episodeId: 1
  skippable: 1
  dialogues:
  - speaker: ERIS
    text: " \uC2E0\uC6D0 \uD655\uC778 \uC911. \uCF54\uB4DC\uBA85 \uC774\uC628. \uBCF5\uADC0\uB97C
      \uD658\uC601\uD569\uB2C8\uB2E4."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512839
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uD68D\uB4DD\uD558\uC2E0 \uC790\uB8CC\uB294 \uC774\uBBF8 \uBD84\uC11D\uC744
      \uAC70\uC758 \uB2E4 \uB9C8\uCE5C\uC0C1\uD0DC\uC785\uB2C8\uB2E4. \uAD81\uAE08\uD55C
      \uC810\uC774 \uC788\uC73C\uC2E0\uAC00\uC694?\t\t"
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512840
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: "\uC774\uC628"
    text: " \uD3ED\uD0C4\uC758 \uBC30\uC1A1 \uBAA9\uC801. \uC65C \uC544\uBE60\uAC00
      \uC8FD\uC5B4\uC57C\uD588\uB294\uC9C0 \uC54C\uACE0 \uC2F6\uC5B4."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512771
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512841
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uC774\uC720\uB294 \uAC04\uB2E8\uD569\uB2C8\uB2E4. \uBCA0\uC2A4\uD37C\uC5D0\uC11C\uC758
      \uD3ED\uBC1C\uC740 \uC6B0\uC5F0\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512842
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: "\uC774\uC628"
    text: "...\uBB50?"
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512771
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512843
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uB7A8 \uC758 \uB2E8\uB9D0\uAE30\uB97C \uC870\uC0AC\uD55C \uACB0\uACFC,
      \uC81C\uAC70 \uBAA9\uD45C\uB294 \uD574\uB2F9 \uC120\uBB3C\uC758 \uC6D0\uB798
      \uC218\uB839\uC778, \uC989 \uB2F9\uC2E0\uC758 \uC544\uBC84\uC9C0\uAC00 \uB2F4\uB2F9\uD558\uB358
      \uD658\uC790\uC785\uB2C8\uB2E4."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512844
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: "\uD574\uB2F9 \uC778\uBB3C\uC740 \uBB34\uAE30, \uC815\uBCF4, \uC790\uAE08
      \uC720\uD1B5\uC744 \uAD00\uB9AC\uD558\uB294 \uC870\uC9C1, \uC2E0\uB514\uCF00\uC774\uD2B8\uC758
      \uD68C\uACC4 \uB2F4\uB2F9\uC790\uB85C \uCD94\uC815\uB429\uB2C8\uB2E4."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512845
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: "\uADF8\uB7EC\uB098 \uC81C\uAC70 \uB300\uC0C1\uC73C\uB85C \uC9C0\uC815\uB41C
      \uC774\uC720\uB294 \uD655\uC778\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 1424586970947584
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uC815\uD669\uC0C1 \uD3ED\uBC1C\uBB3C\uC774 \uB2F9\uC2E0\uC758 \uC544\uBC84\uC9C0\uC5D0\uAC8C
      \uC804\uB2EC\uB41C \uAC83\uC740 \uACC4\uD68D\uC5D0 \uC5C6\uB358 \uBCC0\uC218\uB85C
      \uBCF8\uB798\uB294 \uB300\uC0C1\uC758 \uC790\uD0DD\uC5D0\uC11C \uD3ED\uBC1C\uC2DC\uD0A8
      \uB4A4, \uAC00\uC2A4 \uC0AC\uACE0\uB85C \uC704\uC7A5\uD560 \uC608\uC815\uC774\uC5C8\uB358
      \uAC83\uC73C\uB85C \uBCF4\uC785\uB2C8\uB2E4."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512846
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: "\uC774\uC628"
    text: " \uADF8\uB7FC... \uADF8 \uC0AC\uB78C\uC740 \uD604\uC7AC \uC5B4\uB514\uC5D0
      \uC788\uC9C0?"
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512771
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512847
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uBCA0\uC2A4\uD37C \uC0AC\uACE0\uAC00 \uC788\uB358 \uB2E4\uC74C \uB0A0,
      \uC790\uD0DD\uC5D0\uC11C \uC790\uC0B4\uD55C \uCC44 \uBC1C\uACAC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uAD00\uB828 \uC790\uB8CC\uB97C \uBD84\uC11D\uD574\uBCF8 \uACB0\uACFC, \"\uBCF4\uC2A44(\uC218\uC815
      \uC608\uC815)\"\uAC00 <B><color=red>\uBC29\uBB38</b></color>\uD55C \uAC83\uC73C\uB85C
      \uC608\uCE21\uB429\uB2C8\uB2E4."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512848
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: "\uC774\uC628"
    text: " \"\uBCF4\uC2A44\"\uB77C\uBA74.. \"\uBCF4\uC2A4 \uAE30\uBBF9\"\uD55C\uB2E4\uB294
      \uC18C\uBB38\uC774 \uC788\uB294 \uADF8 \uB140\uC11D\uC774\uAD70."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512771
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512849
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uD604\uC7AC \uB370\uC774\uD130\uBCA0\uC774\uC2A4\uC5D0 \uB4F1\uB85D\uB41C
      \"\uBCF4\uC2A44\"\uC758 \uC18C\uC7AC\uC9C0\uB294 \uC874\uC7AC\uD558\uC9C0\uB9CC..
      \uACF5\uC2DD \uC784\uBB34\uB85C \uB4F1\uB85D\uD558\uC9C0 \uC54A\uC73C\uBA74
      \uC81C\uACF5\uD560 \uC218 \uC5C6\uB294 \uC810 \uC591\uD574 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512850
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: "\uC774\uC628"
    text: " \uADF8\uB7F4 \uD544\uC694 \uC5C6\uC5B4. \uADF8 \uD68C\uACC4\uB2F4\uB2F9\uC790
      \uC9D1 \uADFC\uCC98\uC5D0\uC11C \uC54C\uC9F1\uAC70\uB9AC\uBA74 \uC54C\uC544\uC11C
      <b><color=red>\uBC29\uBB38</b></color>\uD558\uB7EC \uC62C\uAC70\uC57C."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512771
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512851
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4. \uB610\uD55C \uBCC4\uAC1C\uB85C,
      \uC0D0\uBCF4\uC758 \uAC70\uB798 \uB0B4\uC5ED\uC744 \uD1B5\uD574 \uD574\uB2F9
      \uC0AC\uAC74\uACFC \uC5F0\uAD00\uB41C \uC778\uBB3C\uB4E4\uC744 \uC77C\uBD80
      \uD30C\uC545\uD588\uC2B5\uB2C8\uB2E4."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512852
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: "\uC774\uC628"
    text: " \uC2E0\uB514\uCF00\uC774\uD2B8 \uCABD \uC0AC\uB78C\uC774\uACA0\uAD70."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512771
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512853
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uC815\uD655\uD569\uB2C8\uB2E4. \uD574\uB2F9 \uC791\uC804\uC744 \uC8FC\uB3C4\uD55C
      \uC778\uBB3C\uC740 \"\uBCF4\uC2A43\", \uCD5C\uC885 \uACB0\uC815\uC744 \uB0B4\uB9B0
      \uC778\uBB3C\uC740 \uC2E0\uB514\uCF00\uC774\uD2B8 \uAC04\uBD80\uC9C4\uC73C\uB85C
      \uCD94\uC815\uB418\uB294 \uC9C4 \uC774\uB77C\uB294 \uC0AC\uB78C\uC785\uB2C8\uB2E4."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512854
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: "\uC774\uC628"
    text: " \"\uBCF4\uC2A43\"? \uADF8 \uC0AC\uB78C\uC774 \uC774\uCABD \uC0AC\uB78C\uC774\uB77C\uACE0?"
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512771
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512855
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uB300\uC678\uC801\uC73C\uB85C\uB294 \uC74C\uC545\uACFC \uB4DC\uB860
      \uD37C\uD3EC\uBA3C\uC2A4\uB97C \uACB0\uD569\uD55C \uC608\uC220\uAC00\uB85C
      \uD65C\uB3D9\uD558\uC9C0\uB9CC, \uC2E4\uC81C\uB85C\uB294 \uC2E0\uB514\uCF00\uC774\uD2B8
      \uC18C\uC18D\uC73C\uB85C \uBCF4\uC785\uB2C8\uB2E4."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512856
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uC9C4\uC758 \uC704\uCE58\uB294 \uD2B9\uC815\uD560 \uC218 \uC5C6\uC73C\uB098,
      \"\uBCF4\uC2A43\"\uC740 \uC54C\uB824\uC838 \uC788\uB294 \uC815\uBCF4\uAC00
      \uB9CE\uC544 \uC27D\uAC8C \uD2B9\uC815\uD560 \uC218 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    sfxId: 
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512857
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uB2E4\uB9CC, \uC800\uD76C\uC640 \uC2E0\uB514\uCF00\uC774\uD2B8 \uC5ED\uC2DC
      \uD611\uC5C5 \uAD00\uACC4\uB97C \uB9FA\uACE0 \uC788\uAE30 \uB54C\uBB38\uC5D0,
