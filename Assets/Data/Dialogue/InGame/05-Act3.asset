        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512879
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: "\uC774\uC628"
    text: " \uC544\uB9C8 \uADF8 \uCABD\uB3C4 \uB0B4\uAC00 \uCC3E\uC544\uAC08 \uAC78
      \uC774\uBBF8 \uC54C\uACE0 \"\uBCF4\uC2A45\"\uC640 \uD568\uAED8 \uAE30\uB2E4\uB9AC\uACE0
      \uC788\uC744\uAC70\uC57C."
    sfxId: 
    expressionId: 
    portraitSlot: 1
    clearPortraitsBeforeLine: 0
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 4972079872663553
        m_Key: 
