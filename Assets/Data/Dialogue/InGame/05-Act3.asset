        m_KeyId: 43636894302208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uD569\uB9AC\uC801\uC778 \uCD94\uCE21\uC785\uB2C8\uB2E4. \uADF8\uB7FC
      \uC804\uD22C \uC804\uC5D0 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uBAA8\uB4C8\uC744
      \uC810\uAC80\uD558\uC2DC\uAE38 \uAD8C\uC7A5\uB4DC\uB9BD\uB2C8\uB2E4."
