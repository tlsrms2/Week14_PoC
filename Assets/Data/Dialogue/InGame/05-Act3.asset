  m_Name: 05-Act3
  m_EditorClassIdentifier: Assembly-CSharp::Week14.Story.InGameStorySequenceSO
  episodeId: 2
  skippable: 0
  dialogues:
  - speaker: ERIS
    text: " \uC2E0\uC6D0 \uD655\uC778 \uC911. \uCF54\uB4DC\uBA85 \uC774\uC628. \uBCF5\uADC0\uB97C
      \uD658\uC601\uD569\uB2C8\uB2E4."
    sfxId: 
    expressionId: 
    portraitSlot: 2
    clearPortraitsBeforeLine: 0
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512863
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uD604\uC7AC \uBD84\uC11D\uC774 \uC644\uB8CC\uB41C \uB450 \uAC74\uC758
      \uC815\uBCF4\uAC00 \uC788\uC2B5\uB2C8\uB2E4. \uAD00\uC6A9\uC801\uC778 \uD45C\uD604\uC744
      \uBE4C\uB9AC\uC790\uBA74, \uC88B\uC740 \uC18C\uC2DD\uACFC \uB098\uC05C \uC18C\uC2DD\uC785\uB2C8\uB2E4.
      \uC5B4\uB290 \uCABD\uBD80\uD130 \uB4E4\uC73C\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    sfxId: 
    expressionId: 
    portraitSlot: 2
    clearPortraitsBeforeLine: 0
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512864
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: "\uC774\uC628"
    text: " ...\uD558\uB098\uC529 \uB9D0\uD574. \uB4E3\uACE0 \uD310\uB2E8\uD558\uC9C0."
    sfxId: 
    expressionId: 
    portraitSlot: 1
    clearPortraitsBeforeLine: 0
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 4972079872663553
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512865
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uADF8\uB7FC \uBA3C\uC800, \uC0AC\uC8FC\uB97C \uBC1B\uC740 \uC774\uB4E4\uC758
      \uB514\uBC14\uC774\uC2A4\uB97C \uBD84\uC11D\uD55C \uACB0\uACFC, \uC9C4\uC758
      \uD604\uC7AC \uC704\uCE58\uC640 \uC774\uB3D9 \uD328\uD134\uC744 \uD2B9\uC815\uD560
      \uC218 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    sfxId: 
    expressionId: 
    portraitSlot: 2
    clearPortraitsBeforeLine: 0
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512866
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: "\uC774\uC628"
    text: " \uB098\uC05C \uC18C\uC2DD\uC740?"
    sfxId: 
    expressionId: 
    portraitSlot: 1
    clearPortraitsBeforeLine: 0
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 4972079872663553
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512867
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uC5BC\uB9C8 \uC804, \uC758\uB8B0\uC778 \uC9C4\uC758 \uBA85\uC758\uB85C
      \uC2E0\uADDC \uC784\uBB34\uAC00 1\uAC74 \uB4F1\uB85D\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uBC29\uBB38\uC790 \uCF54\uB4DC\uBA85 \"\uBCF4\uC2A45\"."
    sfxId: 
    expressionId: 
    portraitSlot: 2
    clearPortraitsBeforeLine: 0
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512868
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uBC29\uBB38 \uB300\uC0C1. \uCF54\uB4DC\uBA85 \uC774\uC628, \uB2F9\uC2E0\uC785\uB2C8\uB2E4."
    sfxId: 
    expressionId: 
    portraitSlot: 2
    clearPortraitsBeforeLine: 0
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512869
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: "\uC774\uC628"
    text: " \uADF8 \uC790\uC2DD\uC774 \uB08C\uC0C8\uB97C \uB9E1\uC558\uB098\uBCF4\uAD70.
      \"\uBCF4\uC2A45\"\uB77C\uACE0... \uD558\uD544 \uC81C\uC77C \uC131\uAC00\uC2E0
      \uC0C1\uB300\uB97C \uB370\uB824\uC624\uB2E4\uB2C8."
    sfxId: 
    expressionId: 
    portraitSlot: 1
    clearPortraitsBeforeLine: 0
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 4972079872663553
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512870
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: "\uC774\uC628"
    text: " \uADF8\uB7F0\uB370 ERIS. \uACF5\uC2DD \uC784\uBB34\uB85C \uC9C0\uC815\uB418\uC5C8\uC73C\uBA74
      \uC774\uC81C \uB0B4 \uD3B8\uC744 \uB4E4\uC5B4\uC904 \uC774\uC720\uAC00 \uC5C6\uB294\uB370,
      \uB098\uD55C\uD14C \uC54C\uB824\uC8FC\uB294 \uC774\uC720\uAC00 \uBB50\uC9C0? "
    sfxId: 
    expressionId: 
    portraitSlot: 1
    clearPortraitsBeforeLine: 0
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 4972079872663553
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512871
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uAC04\uB2E8\uD788 \uC124\uBA85\uD558\uC790\uBA74, \uC77C\uC885\uC758
      \uD22C\uC790\uC785\uB2C8\uB2E4."
    sfxId: 
    expressionId: 
    portraitSlot: 2
    clearPortraitsBeforeLine: 0
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512872
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: "\uC774\uC628"
    text: " \uD22C\uC790?"
    sfxId: 
    expressionId: 
    portraitSlot: 1
    clearPortraitsBeforeLine: 0
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 4972079872663553
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512873
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uC544\uC2DC\uB2E4\uC2DC\uD53C, \uC6B0\uB9AC\uB294 \uBC29\uBB38\uC744
      \uD1B5\uD574 \uC0AC\uD68C\uC758 \uADE0\uD615\uC744 \uC870\uC815\uD569\uB2C8\uB2E4. "
    sfxId: 
    expressionId: 
    portraitSlot: 2
    clearPortraitsBeforeLine: 0
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512874
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uADF8\uB7EC\uB098 \uC774\uC724\uC5D0 \uB530\uB77C \uC6C0\uC9C1\uC774\uB294
      \uC774\uB4E4\uC740 \uACB0\uAD6D \uD310\uB2E8\uC774 \uD750\uB824\uC9C0\uACE0
      \uBD80\uD328\uD558\uAE30 \uB9C8\uB828\uC785\uB2C8\uB2E4."
    sfxId: 
    expressionId: 
    portraitSlot: 2
    clearPortraitsBeforeLine: 0
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512875
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uBC18\uBA74\uC5D0 \uC774\uC775\uC774 \uC544\uB2C8\uB77C <b><color=red>\uC77C\uAD00\uB41C
      \uB3D9\uAE30</b></color>\uAC00 \uC6D0\uB3D9\uB825\uC774 \uB418\uC5B4 \uC6C0\uC9C1\uC774\uB294
      \uC774\uB4E4\uC740 \uC21C\uC218\uD558\uACE0 \uC608\uCE21 \uAC00\uB2A5\uD55C
      \uB3D9\uB825\uC774 \uB429\uB2C8\uB2E4."
    sfxId: 
    expressionId: 
    portraitSlot: 2
    clearPortraitsBeforeLine: 0
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512876
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uADF8\uB798\uC11C \uC774\uC628, \uB2F9\uC2E0\uC774 \uACC4\uC18D \uBC29\uBB38\uD558\uB3C4\uB85D
      \uB3D5\uB294 \uAC83\uC774 \uC0AC\uD68C \uC804\uCCB4\uC5D0\uB3C4 \uC720\uC775\uD558\uB2E4\uACE0
      \uD310\uB2E8\uB429\uB2C8\uB2E4."
    sfxId: 
    expressionId: 
    portraitSlot: 2
    clearPortraitsBeforeLine: 0
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512877
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: "\uC774\uC628"
    text: " ...\uC774\uD574\uD588\uC5B4. \uC5B4\uB290 \uC815\uB3C4\uAE4C\uC9C0 \uC9C0\uC6D0\uD574\uC904
      \uC218 \uC788\uC9C0?"
    sfxId: 
    expressionId: 
    portraitSlot: 1
    clearPortraitsBeforeLine: 0
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 4972079872663553
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333524512878
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
  - speaker: ERIS
    text: " \uC9C4\uC758 \uC704\uCE58\uB97C \uD328\uB110\uC5D0 \uB4F1\uB85D\uD574\uB450\uC5C8\uC2B5\uB2C8\uB2E4.
      \"\uBCF4\uC2A45\"\uAC00 \uC624\uAE30 \uC804\uC5D0 \uBA3C\uC800 \uBC29\uBB38\uD560
      \uAC83\uC744 \uCD94\uCC9C\uD569\uB2C8\uB2E4."
    sfxId: 
    expressionId: 
    portraitSlot: 2
    clearPortraitsBeforeLine: 0
    localizedSpeaker:
      m_TableReference:
        m_TableCollectionName: GUID:8a8e32e629c410a4c97867fa550435ab
      m_TableEntryReference:
        m_KeyId: 5333461598208
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    localizedText:
