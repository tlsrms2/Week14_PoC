--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b2e1d52387b43224a9e8fed941adda42, type: 3}
  m_Name: 06-AfterFinalBoss
  m_EditorClassIdentifier: Assembly-CSharp::Week14.Story.InGameStorySequenceSO
  episodeId: 2
  skippable: 1
  dialogues:
  - speaker: ERIS
    text: "\uC601\uC0C1 \uAE30\uB85D\uC774 \uC885\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uCD5C\uC120\uC744 \uB2E4\uD574 \uC7AC\uAD6C\uC131\uD588\uC73C\uB098 \uC77C\uBD80\uBD84
      \uC720\uC2E4\uB41C \uC810 \uC591\uD574 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4."
    sfxId: 
  - speaker: "\uC774\uC628"
    text: "...\uC774 \uC815\uB3C4\uBA74 \uAD1C\uCC2E\uC544. \uD3ED\uBC1C\uBB3C\uC758
      \uCD9C\uCC98\uB294?"
    sfxId: 
  - speaker: ERIS
    text: " \uD30C\uD3B8\uC5D0\uC11C \uB098\uC628 \uBD80\uD488\uC758 \uC720\uD1B5
      \uACBD\uB85C\uB97C \uC5ED\uCD94\uC801\uD55C \uACB0\uACFC, \uC0AC\uAC74 \uC774\uD2C0
      \uC804 \uB3D9\uC77C \uACC4\uC5F4 \uD488\uBAA9\uC758 \uD310\uB9E4 \uAE30\uB85D\uC774
      \uD655\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    sfxId: 
  - speaker: ERIS
    text: " \uC7A5\uC18C\uB294 M-8 \uBE14\uB85D \uC778\uADFC \uD3D0\uC1C4\uB41C \uC9C0\uD558\uCCA0\uC5D0
      \uC704\uCE58\uD55C \uC554\uC2DC\uC7A5. \uD310\uB9E4\uC790\uB294 <B>\uBB34\uAE30\uC0C1
      \uC0D0\uBCF4\uC785</B>\uB2C8\uB2E4."
    sfxId: 
  - speaker: "\uC774\uC628"
    text: " \uADF8 \uCD1D\uAE30\uB4E4\uC744 \uD0C0\uACE0 \uB2E4\uB2CC\uB2E4\uB294
      \uC18C\uBB38\uC774 \uC788\uB294 \uAD34\uC9DC\uB188\uC778\uAC00, \uAD6C\uB9E4\uC790\uB294?"
    sfxId: 
  - speaker: ERIS
    text: " \uC544\uC27D\uAC8C\uB3C4 \uBE44\uACF5\uC2DD \uC784\uBB34 \uD2B9\uC131
      \uC0C1 \uC2E0\uC6D0\uC774 \uBA85\uD655\uD558\uAC8C \uB4DC\uB7EC\uB098\uC9C0
      \uC54A\uC740 \uB300\uC0C1\uC744 \uCD94\uC801\uD560 \uC218 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4. "
    sfxId: 
  - speaker: "\uC774\uC628"
    text: " \uCD94\uAC00\uAE08\uC744 \uC9C0\uBD88\uD574\uB3C4 \uBD88\uAC00\uB2A5\uD55C\uAC00?"
    sfxId: 
  - speaker: ERIS
    text: " \uBD88\uAC00\uB2A5\uD569\uB2C8\uB2E4. \uC9C1\uC811 \uACF5\uC2DD \uC784\uBB34\uB85C
      \uB4F1\uB85D\uD558\uC2E0\uB2E4\uBA74 \uAC00\uB2A5\uD558\uACA0\uC9C0\uB9CC,
      \uB3D9\uC2DC\uC5D0 \uB300\uC0C1\uC5D0\uAC8C\uB3C4 \uB178\uCD9C\uB420 \uAC00\uB2A5\uC131\uC774
      \uB192\uC544 \uAD8C\uC7A5\uB4DC\uB9AC\uC9C0\uB294 \uC54A\uC2B5\uB2C8\uB2E4.
      \uB2E4\uB978 \uBC29\uBC95\uC740..."
    sfxId: 
  - speaker: "\uC774\uC628"
    text: " \uC9C1\uC811 <B><color=red>\uBC29\uBB38</B></color>\uD574\uC11C, \uC815\uBCF4\uB97C
      \uC5BB\uC5B4\uC57C\uC9C0."
    sfxId: 
  - speaker: ERIS
    text: " \uC790\uB8CC\uB9CC \uD655\uBCF4\uD558\uBA74 \uC815\uBCF4 \uBD84\uC11D\uC774
      \uAC00\uB2A5\uD560\uD150\uB370 \uC815\uB9D0 <B><color=red>\uBC29\uBB38</B></color>\uD558\uC2E4\uAC74\uAC00\uC694?"
    sfxId: 
  - speaker: "\uC774\uC628"
    text: " \uB09C \uADF8\uAC8C \uB354 \uD3B8\uD574. \uB4B7\uD0C8\uB3C4 \uC801\uACE0."
    sfxId: 
  - speaker: "\uC774\uC628"
    text: " ...\uD654\uD480\uC774 \uB300\uC0C1\uC774 \uD544\uC694\uD558\uAE30\uB3C4
      \uD558\uACE0."
    sfxId: 
  - speaker: ERIS
    text: " \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4. \uCD94\uAC00\uB85C, \uD574\uB2F9
      \uD3ED\uBC1C\uBB3C\uC744 \uBCD1\uC6D0\uC5D0 \uBC30\uC1A1\uD55C \uC6B4\uBC18\uCC45\uC740
      \uD2B9\uC815\uD560 \uC218 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    sfxId: 
  - speaker: ERIS
    text: " \uD574\uB2F9 \uC778\uBB3C\uC740 <B>\uB7A8</B> \uC774\uB77C\uB294 \uAC70\uAD6C\uC758
      \uC6A9\uBCD1\uC73C\uB85C, \uB192\uC740 \uCD9C\uB825\uC758 \uC2E0\uCCB4 \uAC15\uD654
      \uC7A5\uBE44\uB97C \uC7A5\uCC29\uD558\uACE0 \uC788\uC5B4 \uC5B4\uB835\uC9C0
      \uC54A\uAC8C \uD30C\uC545 \uAC00\uB2A5\uD588\uC2B5\uB2C8\uB2E4."
    sfxId: 
  - speaker: ERIS
    text: " \uB2E4\uB9CC \uB9C8\uCC2C\uAC00\uC9C0\uB85C \uB204\uAD6C\uC758 \uC0AC\uC8FC\uB97C
      \uBC1B\uACE0 \uD3ED\uBC1C\uBB3C\uC744 \uC62E\uACBC\uB294\uC9C0\uB294 \uCD94\uC801\uD560
      \uC218 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4."
    sfxId: 
  - speaker: "\uC774\uC628"
    text: " \uADF8 \uB140\uC11D\uB3C4 \uACB0\uAD6D \uC9C1\uC811 <B><Color=red>\uBC29\uBB38</B></Color>\uD574\uC57C\uACA0\uAD70.
      \uC5B4\uB514\uC5D0 \uC788\uC9C0?"
    sfxId: 
  - speaker: ERIS
    text: "\uAE30\uB2E4\uB824\uC8FC\uC138\uC694. \uD328\uB110\uC5D0 \uAD00\uB828
      \uC790\uB8CC\uB4E4\uC744 \uB4F1\uB85D\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    sfxId: 
