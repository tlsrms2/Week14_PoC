  episodeId: 5
  skippable: 0
  dialogues:
  - speaker: ERIS
    text: " \uC2E0\uC6D0\uC774 \uD2B9\uC815\uB41C \uC778\uBB3C\uB4E4\uC758 \uC704\uCE58\uB97C
      \uC804\uC220 \uD328\uB110\uC5D0 \uB4F1\uB85D\uD588\uC2B5\uB2C8\uB2E4. \uC774\uACF3\uC5D0\uC11C
      \uB300\uC0C1\uC758 \uC815\uBCF4\uB97C \uD655\uC778\uD558\uACE0, \uD574\uB2F9
      \uC704\uCE58\uB85C \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    sfxId: 
  - speaker: ERIS
    text: " \uC6D0\uD558\uB294 \uB300\uC0C1\uC744 \uC120\uD0DD\uD574 \uBC29\uBB38\uD558\uC138\uC694.
      \uC720\uD6A8\uD55C \uC790\uB8CC\uAC00 \uD655\uBCF4\uB418\uBA74 \uBC14\uB85C
      \uBD84\uC11D\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    sfxId: 
  - speaker: ERIS
    text: " \uCD94\uAC00 \uC870\uAC74\uC744 \uB2EC\uC131\uD558\uBA74 \uBD84\uC11D\uD560
      \uC0AC\uAC74 \uC790\uB8CC \uC774\uC678\uC5D0\uB3C4 \uB354 \uB9CE\uC740 \uC804\uD22C
      \uB370\uC774\uD130\uB97C \uD655\uBCF4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    sfxId: 
  - speaker: ERIS
    text: " \uC218\uC9D1\uD55C \uB370\uC774\uD130\uB294 \uC774\uC2DD \uC7A5\uBE44\uC758
      \uC131\uB2A5\uC744 \uD655\uC7A5\uD558\uB294 \uB370\uC774\uD130 \uCE69\uC73C\uB85C
      \uBCC0\uD658\uB429\uB2C8\uB2E4."
    sfxId: 
