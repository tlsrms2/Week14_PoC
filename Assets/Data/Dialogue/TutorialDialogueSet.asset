  - step: 3
    dialogues:
    - speaker: ERIS
      text: "AEGIS \uC2DC\uC2A4\uD15C \uC774\uC0C1 \uC5C6\uC74C. \uC774\uCC98\uB7FC
        \uC801\uC758 \uACF5\uACA9\uC5D0 \uB9DE\uB354\uB77C\uB3C4 \uD0C4\uD658\uD615
        \uC5D0\uB108\uC9C0 \uCF54\uC5B4\uAC00 \uCDA9\uBD84\uD558\uB2E4\uBA74 \uD53C\uD574\uB97C
        \uD761\uC218\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      sfxId: 
      expressionId: 
      portraitSlot: 2
      clearPortraitsBeforeLine: 0
      explanation:
        enabled: 0
        image: {fileID: 21300000, guid: fab06e0be9375cc4d823efa71629885c, type: 3}
        video: {fileID: 0}
        loopVideo: 1
        title: "\uC694\uACA9"
        text: "\uC6B0\uD074\uB9AD\n\n \uAE30\uACC4\uD654 \uC548\uAD6C\uAC00 \uC801
          \uD0C4\uD658\uC744 \uD3EC\uCC29\uD558\uBA74 \uAE30\uACC4\uD314\uC774 \uC694\uACA9
          \uADA4\uB3C4\uB97C \uBCF4\uC870\uD569\uB2C8\uB2E4.\n\n \uC801 \uD0C4\uD658\uC744
          \uC694\uACA9\uD558\uBA74 \uBB34\uB825\uD560 \uC218 \uC788\uC73C\uBA70 \uBB34\uB825\uD654\uB41C
          \uD0C4\uD658\uC758 \uC5D0\uB108\uC9C0\uB294 \uC790\uC2E0\uC758 \uCF54\uC5B4
          \uBCF4\uCDA9\uC5D0 \uC0AC\uC6A9\uB429\uB2C8\uB2E4.\n\n \uC5F0\uC18D\uC801\uC73C\uB85C "
