%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d13344fd577acb84e9fe52ecae79c17b, type: 3}
  m_Name: TutorialDialogueSet
  m_EditorClassIdentifier: Assembly-CSharp::Week14.Tutorial.TutorialDialogueSetSO
  steps:
  - step: 0
    dialogues:
    - speaker: "\uC774\uC628"
      text: "AI, \uD14C\uB7EC\uC5D0 \uB300\uD574 \uC870\uC0AC\uD574\uC918. \uACF5\uC2DD
        \uB8E8\uD2B8 \uB9D0\uACE0, \uB124\uAC00 \uC811\uADFC\uD560 \uC218 \uC788\uB294
        \uCABD\uAE4C\uC9C0."
      sfxId: 
      explanation:
        enabled: 0
        image: {fileID: 0}
        video: {fileID: 0}
        loopVideo: 1
        text: 
    - speaker: AI
      text: "\uBE44\uACF5\uC2DD \uC784\uBB34\uB294 \uCD94\uAC00 \uBE44\uC6A9\uC774
        \uBC1C\uC0DD\uD569\uB2C8\uB2E4. \uC81C\uACF5 \uAC00\uB2A5\uD55C \uC815\uBCF4\uB3C4
        \uC81C\uD55C\uB429\uB2C8\uB2E4."
      sfxId: 
      explanation:
        enabled: 0
        image: {fileID: 0}
        video: {fileID: 0}
        loopVideo: 1
        text: 
    - speaker: "\uC774\uC628"
      text: "\uC0C1\uAD00\uC5C6\uC5B4. \uC774\uC81C \uB3C8 \uC4F8 \uB370\uB3C4 \uBCC4\uB85C
        \uC5C6\uC796\uC544."
      sfxId: 
      explanation:
        enabled: 0
        image: {fileID: 0}
        video: {fileID: 0}
        loopVideo: 1
        text: 
    - speaker: AI
      text: "\uD655\uC778\uD588\uC2B5\uB2C8\uB2E4. \uC870\uC0AC\uC640 \uBCD1\uD589\uD574
        \uC7A5\uBE44 \uC801\uC751 \uD6C8\uB828\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4."
      sfxId: 
      explanation:
        enabled: 0
        image: {fileID: 0}
        video: {fileID: 0}
        loopVideo: 1
        text: 
    objectiveFormat: 
  - step: 1
    dialogues:
    - speaker: AI
      text: "\uBA3C\uC800 \uC6C0\uC9C1\uC784\uC744 \uD655\uC778\uD569\uB2C8\uB2E4."
      sfxId: 
      explanation:
        enabled: 1
        image: {fileID: 21300000, guid: fab06e0be9375cc4d823efa71629885c, type: 3}
        video: {fileID: 0}
        loopVideo: 1
        text: "<b>\uC774\uB3D9<b>: WASD"
    objectiveFormat: "\uC774\uB3D9 \uD6C8\uB828 {0}/{1}"
  - step: 10
    dialogues:
    - speaker: AI
      text: "\uD0C4\uD658\uD615 \uC5D0\uB108\uC9C0 \uCF54\uC5B4\uB97C \uD55C \uBC1C
        \uC0AC\uACA9\uD574 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
      sfxId: 
      explanation:
        enabled: 1
        image: {fileID: 21300000, guid: fab06e0be9375cc4d823efa71629885c, type: 3}
        video: {fileID: 0}
        loopVideo: 1
        text: "<b>\uAE30\uBCF8 \uACF5\uACA9</b>: \uC67C\uD074\uB9AD\n\n\uD0C4\uD658\uD615
          \uC5D0\uB108\uC9C0 \uCF54\uC5B4\uB97C \uBC1C\uC0AC\uD569\uB2C8\uB2E4."
    objectiveFormat: "\uAE30\uBCF8 \uC0AC\uACA9 {0}/{1}"
  - step: 13
    dialogues:
    - speaker: AI
      text: "\uAE30\uBCF8 \uC0AC\uACA9 \uD655\uC778 \uC644\uB8CC. \uB2E4\uC74C \uD6C8\uB828\uC2E4\uB85C
        \uC774\uB3D9\uD558\uC2ED\uC2DC\uC624."
      sfxId: 
      explanation:
        enabled: 0
        image: {fileID: 0}
        video: {fileID: 0}
        loopVideo: 1
        text: 
    - speaker: AI
      text: "\uC804\uBC29 \uACA9\uBCBD\uC744 \uAC1C\uBC29\uD569\uB2C8\uB2E4. "
      sfxId: 
      explanation:
        enabled: 0
        image: {fileID: 0}
        video: {fileID: 0}
        loopVideo: 1
        text: 
    objectiveFormat: 
  - step: 2
    dialogues:
    - speaker: AI
      text: "\uC774\uBC88\uC5D0\uB294 \uB354\uBBF8\uC5D0\uAC8C \uAE30\uBCF8 \uACF5\uACA9\uC744
        \uC801\uC911\uC2DC\uD0A4\uC2ED\uC2DC\uC624."
      sfxId: 
      explanation:
        enabled: 1
        image: {fileID: 21300000, guid: fab06e0be9375cc4d823efa71629885c, type: 3}
        video: {fileID: 0}
        loopVideo: 1
        text: "<b>\uAE30\uBCF8 \uACF5\uACA9</b>: \uC67C\uD074\uB9AD\n\n\uD0C4\uD658\uD615
          \uC5D0\uB108\uC9C0 \uCF54\uC5B4\uB97C \uBC1C\uC0AC\uD569\uB2C8\uB2E4."
    objectiveFormat: "\uAE30\uBCF8 \uACF5\uACA9 \uC801\uC911 {0}/{1}"
  - step: 12
    dialogues:
    - speaker: AI
      text: "\uB2E4\uC74C\uC740 \uCF54\uC5B4\uAC00 \uC2E4\uC81C\uB85C \uBC29\uC5B4
        \uC790\uC6D0\uC73C\uB85C \uC18C\uBAA8\uB418\uB294 \uACFC\uC815\uC744 \uD655\uC778\uD569\uB2C8\uB2E4."
      sfxId: 
      explanation:
        enabled: 0
        image: {fileID: 21300000, guid: fab06e0be9375cc4d823efa71629885c, type: 3}
        video: {fileID: 0}
        loopVideo: 1
        text: 
    - speaker: AI
      text: "\uCF54\uC5B4\uB97C \uCD5C\uB300\uB85C \uBCF4\uCDA9\uD588\uC2B5\uB2C8\uB2E4.
        \uC774\uBC88 \uD0C4\uD658\uC740 \uD53C\uD558\uC9C0 \uB9D0\uACE0 \uB9DE\uC544
        \uBCF4\uC2ED\uC2DC\uC624."
      sfxId: 
      explanation:
        enabled: 1
        image: {fileID: 21300000, guid: fab06e0be9375cc4d823efa71629885c, type: 3}
        video: {fileID: 0}
        loopVideo: 1
        text: "\uC801\uC758 \uD0C4\uD658\uC5D0 \uB9DE\uC73C\uBA74 \uD0C4\uD658\uD615
          \uC5D0\uB108\uC9C0 \uCF54\uC5B4\uAC00\n\uBA3C\uC800 \uC18C\uBAA8\uB418\uBA70
          \uD53C\uD574\uB97C \uD761\uC218\uD569\uB2C8\uB2E4.\n\n\uCF54\uC5B4\uAC00
          0\uC778 \uC0C1\uD0DC\uC5D0\uC11C \uD53C\uACA9\uB418\uBA74 \uC0AC\uB9DD\uD569\uB2C8\uB2E4."
    objectiveFormat: "\uC801 \uD0C4\uD658 \uD53C\uACA9 {0}/{1}"
  - step: 3
    dialogues:
    - speaker: AI
      text: "\uD53C\uD574\uB97C \uB300\uC2E0\uD558\uC5EC \uCF54\uC5B4\uAC00 \uC18C\uBAA8\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
      sfxId: 
      explanation:
        enabled: 0
        image: {fileID: 21300000, guid: fab06e0be9375cc4d823efa71629885c, type: 3}
        video: {fileID: 0}
        loopVideo: 1
        text: "<b>\uC694\uACA9</b>: \uC6B0\uD074\uB9AD\n\n\uAE30\uACC4\uD654 \uC548\uAD6C\uAC00
          \uC801 \uD0C4\uD658\uC744 \uD3EC\uCC29\uD558\uBA74 \uAE30\uACC4\uD314\uC774
          \uC694\uACA9 \uADA4\uB3C4\uB97C \uBCF4\uC870\uD569\uB2C8\uB2E4.\n\n\uC801
          \uD0C4\uD658\uC744 \uC694\uACA9\uD558\uBA74 \uBB34\uB825\uD654\uD569\uB2C8\uB2E4.\n\uBB34\uB825\uD654\uB41C
          \uD0C4\uD658\uC758 \uC5D0\uB108\uC9C0\uB294 \uC790\uC2E0\uC758 \uCF54\uC5B4
          \uBCF4\uCDA9\uC5D0 \uC0AC\uC6A9\uB429\uB2C8\uB2E4."
    - speaker: AI
      text: "\uD0C0\uC774\uBC0D\uC744 \uB9DE\uCDB0 \uD0C4\uD658\uC744 \uC694\uACA9\uD558\uC2ED\uC2DC\uC624."
      sfxId: 
      explanation:
        enabled: 1
        image: {fileID: 21300000, guid: fab06e0be9375cc4d823efa71629885c, type: 3}
        video: {fileID: 0}
        loopVideo: 1
        text: "<b>\uC694\uACA9</b>: \uC6B0\uD074\uB9AD\n\n\uAE30\uACC4\uD654 \uC548\uAD6C\uAC00
          \uC801 \uD0C4\uD658\uC744 \uD3EC\uCC29\uD558\uBA74 \uAE30\uACC4\uD314\uC774
          \uC694\uACA9 \uADA4\uB3C4\uB97C \uBCF4\uC870\uD569\uB2C8\uB2E4.\n\n\uC801
          \uD0C4\uD658\uC744 \uC694\uACA9\uD558\uBA74 \uBB34\uB825\uD654\uD569\uB2C8\uB2E4.\n\uBB34\uB825\uD654\uB41C
          \uD0C4\uD658\uC758 \uC5D0\uB108\uC9C0\uB294 \uC790\uC2E0\uC758 \uCF54\uC5B4
          \uBCF4\uCDA9\uC5D0 \uC0AC\uC6A9\uB429\uB2C8\uB2E4."
    objectiveFormat: "\uD0C4\uD658 \uC694\uACA9 {0}/{1}"
  - step: 7
    dialogues:
    - speaker: AI
      text: "\uCF54\uC5B4\uC5D0\uB294 \uC720\uD1B5\uAE30\uD55C\uC774 \uC801\uC6A9\uB429\uB2C8\uB2E4."
      sfxId: 
      explanation:
        enabled: 1
        image: {fileID: 21300000, guid: fab06e0be9375cc4d823efa71629885c, type: 3}
        video: {fileID: 0}
        loopVideo: 1
        text: "\uD0C4\uD658\uD615 \uC5D0\uB108\uC9C0 \uCF54\uC5B4\uB294 \uC77C\uC815
          \uC2DC\uAC04 \uBCF4\uC720\uD558\uBA74 \uACFC\uBD80\uD558\uB418\uC5B4 \uC790\uB3D9
          \uBC30\uCD9C\uB429\uB2C8\uB2E4.\n\n\uD45C\uC2DC\uAC00 \uBD89\uC5B4\uC9C0\uBA74
          \uACE7 \uC0AC\uB77C\uC9C4\uB2E4\uB294 \uB73B\uC785\uB2C8\uB2E4. \uC624\uB798
          \uBCF4\uAD00\uD558\uB294 \uAC83\uBCF4\uB2E4 \uD544\uC694\uD55C \uC21C\uAC04\uC5D0
          \uACF5\uACA9\uD558\uB294 \uD310\uB2E8\uC774 \uC911\uC694\uD569\uB2C8\uB2E4."
    objectiveFormat: 
  - step: 8
    dialogues:
    - speaker: AI
      text: "\uC2A4\uD0AC\uC740 \uAC8C\uC774\uC9C0\uAC00 \uC900\uBE44\uB410\uC744
        \uB54C\uB9CC \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      sfxId: 
      explanation:
        enabled: 1
        image: {fileID: 0}
        video: {fileID: 0}
        loopVideo: 1
        text: "<b>\uC2A4\uD0AC</b>: \uC2A4\uD398\uC774\uC2A4\uBC14\n\n\uC2A4\uD0AC\uC740
          \uC804\uC6A9 \uAC8C\uC774\uC9C0\uAC00 \uC900\uBE44\uB418\uC5B4 \uC788\uC744
          \uB54C\uB9CC \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uAC8C\uC774\uC9C0\uAC00
          \uBE44\uC5B4 \uC788\uC73C\uBA74 \uC77C\uC815 \uC2DC\uAC04\uC774 \uC9C0\uB098
          \uB2E4\uC2DC \uCDA9\uC804\uB429\uB2C8\uB2E4. "
    objectiveFormat: 
  - step: 4
    dialogues:
    - speaker: AI
      text: "\uC2A4\uD398\uC774\uC2A4\uBC14 \uC2A4\uD0AC\uB85C \uD0C4\uB9C9\uC744
        \uD68C\uD53C\uD558\uC2ED\uC2DC\uC624."
      sfxId: 
      explanation:
        enabled: 0
        image: {fileID: 21300000, guid: fab06e0be9375cc4d823efa71629885c, type: 3}
        video: {fileID: 0}
        loopVideo: 1
        text: "<b>\uC2A4\uD0AC</b>: \uC2A4\uD398\uC774\uC2A4\uBC14"
    objectiveFormat: "\uC2A4\uD0AC \uD68C\uD53C {0}/{1}"
  - step: 5
    dialogues:
    - speaker: AI
      text: "\uB9C8\uC9C0\uB9C9\uC740 \uB354\uBBF8\uC640\uC758 \uC2E4\uC804 \uB300\uC804\uC785\uB2C8\uB2E4."
      sfxId: 
      explanation:
        enabled: 0
        image: {fileID: 0}
        video: {fileID: 0}
        loopVideo: 1
        text: 
    - speaker: AI
      text: "\uACF5\uACA9, \uD328\uB9C1, \uC2A4\uD0AC\uC744 \uBAA8\uB450 \uD65C\uC6A9\uD558\uC2ED\uC2DC\uC624."
      sfxId: 
      explanation:
        enabled: 0
        image: {fileID: 0}
        video: {fileID: 0}
        loopVideo: 1
        text: 
    objectiveFormat: "\uD6C8\uB828 \uBAB9 \uACA9\uD30C {0}/{1}"
  - step: 6
    dialogues:
    - speaker: AI
      text: "\uC801\uC751 \uD6C8\uB828\uC774 \uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
        \uB85C\uBE44\uB85C \uBCF5\uADC0\uD558\uC2ED\uC2DC\uC624."
      sfxId: 
      explanation:
        enabled: 0
        image: {fileID: 0}
        video: {fileID: 0}
        loopVideo: 1
        text: 
    objectiveFormat: 
  - step: 9
    dialogues:
    - speaker: AI
      text: "\uD68C\uD53C \uC2E4\uD328\uC785\uB2C8\uB2E4. \uCF54\uC5B4\uC640 \uC2A4\uD0AC
        \uAC8C\uC774\uC9C0\uB97C \uB2E4\uC2DC \uCDA9\uC804\uD588\uC2B5\uB2C8\uB2E4."
      sfxId: 
      explanation:
        enabled: 0
        image: {fileID: 0}
        video: {fileID: 0}
        loopVideo: 1
        text: 
    - speaker: AI
      text: "\uD0C4\uB9C9\uC774 \uD37C\uC9C0\uB294 \uC21C\uAC04 \uC2A4\uD398\uC774\uC2A4\uBC14\uB85C
        \uB2E4\uC2DC \uD68C\uD53C\uD558\uC2ED\uC2DC\uC624."
      sfxId: 
      explanation:
        enabled: 0
        image: {fileID: 0}
        video: {fileID: 0}
        loopVideo: 1
        text: 
    objectiveFormat: 
  - step: 11
    dialogues:
    - speaker: AI
      text: "\uCF54\uC5B4\uAC00 \uBAA8\uB450 \uC18C\uBAA8\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
        \uB2E4\uC2DC \uBCF4\uAE09\uD569\uB2C8\uB2E4."
      sfxId: 
      explanation:
        enabled: 0
        image: {fileID: 0}
        video: {fileID: 0}
        loopVideo: 1
        text: 
    objectiveFormat: 
