  m_TableData:
  - m_Id: 63427674112
    m_Localized: Tactical Dodge Module
    m_Metadata:
      m_Items: []
  - m_Id: 238342733824
    m_Localized: Dashes a short distance and clears surrounding projectiles.
    m_Metadata:
      m_Items: []
  - m_Id: 300527484928
    m_Localized: Hologram Duplicate Module
    m_Metadata:
      m_Items: []
  - m_Id: 303861956608
    m_Localized: 'Deploys a hologram at your current position for 10 seconds.

      The
      hologram mirrors your attacks, dealing 50% of your normal damage.'
    m_Metadata:
      m_Items: []
  - m_Id: 347285585920
    m_Localized: Time Manipulation Module
    m_Metadata:
      m_Items: []
  - m_Id: 349898637312
    m_Localized: Slows down time around you for 3 seconds.
    m_Metadata:
      m_Items: []
  - m_Id: 352498637312
    m_Localized: Magnetic Module
    m_Metadata:
      m_Items: []
  - m_Id: 355098637312
    m_Localized: Absorbs surrounding projectiles for 2 seconds to recover ammo.
    m_Metadata:
      m_Items: []
  - m_Id: 357698637312
    m_Localized: Parry Module
    m_Metadata:
      m_Items: []
  - m_Id: 360298637312
    m_Localized: 'Grants invincibility for a very short time.

      Taking damage
      during this state fully recovers ammo.'
    m_Metadata:
      m_Items: []
  - m_Id: 362898637312
    m_Localized: Auto-Tracking Module
    m_Metadata:
      m_Items: []
  - m_Id: 365498637312
    m_Localized: Bullets are always fired toward enemies.
    m_Metadata:
      m_Items: []
  - m_Id: 368098637312
    m_Localized: High-Performance Intercept Module
    m_Metadata:
      m_Items: []
  - m_Id: 370698637312
    m_Localized: Slightly increases intercept range.
    m_Metadata:
      m_Items: []
  - m_Id: 373298637312
    m_Localized: Acceleration Module
    m_Metadata:
      m_Items: []
  - m_Id: 375898637312
    m_Localized: Slightly increases movement speed when out of ammo.
    m_Metadata:
      m_Items: []
  - m_Id: 378498637312
    m_Localized: Energy Conversion Module
    m_Metadata:
      m_Items: []
  - m_Id: 381098637312
    m_Localized: Active skill cooldown is reduced by 0.5 seconds upon a successful
      intercept.
    m_Metadata:
      m_Items: []
  - m_Id: 383698637312
    m_Localized: Emergency Protocol Module
    m_Metadata:
      m_Items: []
  - m_Id: 386298637312
    m_Localized: Survives fatal damage once.
    m_Metadata:
      m_Items: []
