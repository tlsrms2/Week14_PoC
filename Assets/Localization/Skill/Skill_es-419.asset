  m_TableData:
  - m_Id: 63427674112
    m_Localized: "Módulo de Evasión Táctica"
    m_Metadata:
      m_Items: []
  - m_Id: 238342733824
    m_Localized: "Avanza una corta distancia y elimina los proyectiles cercanos."
    m_Metadata:
      m_Items: []
  - m_Id: 300527484928
    m_Localized: "Módulo de Duplicado Holográfico"
    m_Metadata:
      m_Items: []
  - m_Id: 303861956608
    m_Localized: "Deja un holograma en la posición actual durante 10 segundos.\nEl holograma ataca junto al jugador e inflige un 50% del daño normal a los enemigos."
    m_Metadata:
      m_Items: []
  - m_Id: 347285585920
    m_Localized: "Módulo de Manipulación Temporal"
    m_Metadata:
      m_Items: []
  - m_Id: 349898637312
    m_Localized: "Ralentiza el tiempo a tu alrededor durante 3 segundos."
    m_Metadata:
      m_Items: []
  - m_Id: 352498637312
    m_Localized: "Módulo Magnético"
    m_Metadata:
      m_Items: []
  - m_Id: 355098637312
    m_Localized: "Absorbe proyectiles cercanos durante 2 segundos para recuperar munición."
    m_Metadata:
      m_Items: []
  - m_Id: 357698637312
    m_Localized: "Módulo de Bloqueo Perfecto"
    m_Metadata:
      m_Items: []
  - m_Id: 360298637312
    m_Localized: "Otorga invencibilidad durante un período muy breve.\nRecibir daño en este estado recupera toda la munición."
    m_Metadata:
      m_Items: []
  - m_Id: 362898637312
    m_Localized: "Módulo de Seguimiento Automático"
    m_Metadata:
      m_Items: []
  - m_Id: 365498637312
    m_Localized: "Las balas siempre se disparan hacia los enemigos."
    m_Metadata:
      m_Items: []
  - m_Id: 368098637312
    m_Localized: "Módulo de Intercepción Avanzada"
    m_Metadata:
      m_Items: []
  - m_Id: 370698637312
    m_Localized: "Aumenta ligeramente el alcance de intercepción."
    m_Metadata:
      m_Items: []
  - m_Id: 373298637312
    m_Localized: "Módulo de Aceleración"
    m_Metadata:
      m_Items: []
  - m_Id: 375898637312
    m_Localized: "Aumenta ligeramente la velocidad de movimiento cuando no tienes munición."
    m_Metadata:
      m_Items: []
  - m_Id: 378498637312
    m_Localized: "Módulo de Conversión de Energía"
    m_Metadata:
      m_Items: []
  - m_Id: 381098637312
    m_Localized: "Al interceptar con éxito, la recarga de la habilidad activa se reduce 0,5 segundos."
    m_Metadata:
      m_Items: []
  - m_Id: 383698637312
    m_Localized: "Módulo de Protocolo de Emergencia"
    m_Metadata:
      m_Items: []
  - m_Id: 386298637312
    m_Localized: "Permite sobrevivir una vez al daño fatal."
    m_Metadata:
      m_Items: []
