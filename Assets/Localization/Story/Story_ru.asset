  m_SharedData: {fileID: 11400000, guid: 8a8e32e629c410a4c97867fa550435ab, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5333532901383
    m_Localized: "\u0412\u0432\u043E\u0434 <sprite name=\"icon_leftclick\"> \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      <color=#73f3ff>\u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0438\u0442\u044C
      \u043F\u0443\u043B\u0435\u0432\u044B\u043C \u044D\u043D\u0435\u0440\u0433\u043E\u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u043E\u043C
      \u0432 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438 \u043A\u0443\u0440\u0441\u043E\u0440\u0430</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901389
    m_Localized: "\u0414\u0430\u043B\u0435\u0435 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
      \u043F\u043E\u0434\u0430\u0432\u043B\u044F\u044E\u0449\u0438\u0445 \u0441\u043D\u0430\u0440\u044F\u0434\u043E\u0432
      \u043C\u0430\u043D\u0435\u043A\u0435\u043D\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C
      <color=#73f3ff>\u0440\u0430\u0431\u043E\u0442\u0443 \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430
      AEGIS</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 1826406452789249
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0432\u0440\u0430\u0433 \u0433\u043E\u0442\u043E\u0432\u0438\u0442
      <color=#ff4c5c>\u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u043E\u0449\u043D\u044B\u0435
      \u0430\u0442\u0430\u043A\u0438</color>, <color=#73f3ff>\u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0433\u043B\u0430\u0437\u043D\u043E\u0439 \u043F\u0440\u043E\u0442\u0435\u0437
      ARGUS \u0438\u043D\u043E\u0433\u0434\u0430 \u0437\u0430\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u0443\u044F\u0437\u0432\u0438\u043C\u044B\u0439 \u044D\u043D\u0435\u0440\u0433\u043E\u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901404
    m_Localized: "\u041F\u0443\u043B\u0435\u0432\u043E\u0439 \u044D\u043D\u0435\u0440\u0433\u043E\u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B
      <color=#73f3ff>\u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0436\u0430\u0435\u0442\u0441\u044F
      \u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
      \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442\u0441\u044F, \u0435\u0441\u043B\u0438
      \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C \u0435\u0433\u043E
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u043E\u043B\u0433\u043E</color>.
      \u041F\u043E \u0437\u043D\u0430\u0447\u043A\u0443 \u043F\u0443\u043B\u0438
      \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435 \u043C\u043E\u0436\u043D\u043E
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0432\u0440\u0435\u043C\u044F
      \u0434\u043E \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512789
    m_Localized: "\u041F\u0435\u0440\u0435\u0434 \u0432\u0440\u0430\u0447\u043E\u043C
      \u0442\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C \u0432\u0441\u0435,
      \u0447\u0442\u043E \u0443\u0433\u043E\u0434\u043D\u043E, <color=#73f3ff>\u043C\u043E\u044F
      \u0434\u043E\u0447\u044C.</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512788
    m_Localized: "...\u041A\u0445\u043C. \u041D\u043E \u0435\u0441\u043B\u0438 <color=#ff4c5c>\u0443\u043C\u0440\u0435\u0442
      \u043A\u0442\u043E-\u0442\u043E, \u043A\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442
      \u0443\u0436\u0430\u0441\u043D\u044B\u0435 \u0432\u0435\u0449\u0438</color>,
      \u0440\u0430\u0437\u0432\u0435 \u044D\u0442\u043E \u043D\u0435 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E?
      \u041A\u0430\u043A \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u044F \u043F\u043E
      \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044E \u043F\u043B\u043E\u0445\u043E\u0439
      \u043E\u043F\u0443\u0445\u043E\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512781
    m_Localized: "<color=#A8B2BC>[ \u0412\u043E\u0441\u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0435\u043D\u0438\u0435
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u043E\u0433\u043E
      \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044F \u0437\u0430\u043F\u0438\u0441\u0438.
      ]</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512884
    m_Localized: "\u0414\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u0446\u0435\u043B\u044C
      \u0443\u0436\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430 <color=#FF4C5C>\u0432\u0438\u0437\u0438\u0442</color>,
      \u043C\u043E\u0436\u043D\u043E <color=#73f3ff>\u0437\u0430\u043F\u0438\u0441\u0430\u0442\u044C
      \u0434\u0430\u043D\u043D\u044B\u0435 \u044D\u0442\u043E\u0433\u043E \u043B\u0438\u0446\u0430
      \u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0442\u044C \u0431\u043E\u0439</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512885
    m_Localized: "\u0415\u0441\u043B\u0438 <color=#73f3ff>\u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C
      \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0443\u0441\u043B\u043E\u0432\u0438\u044F</color>, \u043F\u043E\u043C\u0438\u043C\u043E
      \u0434\u0430\u043D\u043D\u044B\u0445 \u0438\u043D\u0446\u0438\u0434\u0435\u043D\u0442\u0430
      \u0434\u043B\u044F \u0430\u043D\u0430\u043B\u0438\u0437\u0430 \u043C\u043E\u0436\u043D\u043E
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435
      <color=#73f3ff>\u0431\u043E\u0435\u0432\u044B\u0445 \u0434\u0430\u043D\u043D\u044B\u0445</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512886
    m_Localized: "<color=#73f3ff>\u0421\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435
      \u0447\u0438\u043F\u044B \u0434\u0430\u043D\u043D\u044B\u0445</color> \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F
      \u043F\u043E\u0437\u0436\u0435 \u0434\u043B\u044F <color=#73f3ff>\u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u044F
      \u043C\u043E\u0434\u0443\u043B\u0435\u0439, \u043F\u043E\u0432\u044B\u0448\u0430\u044E\u0449\u0438\u0445
      \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
      \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F</color>,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0435\u0441\u043B\u0438 <color=#73f3ff>\u0431\u043E\u0439
      \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u044C,
      \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F
      \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u0447\u0438\u043F\u044B \u0434\u0430\u043D\u043D\u044B\u0445</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512887
    m_Localized: "\u041F\u043E\u0441\u043A\u043E\u043B\u044C\u043A\u0443 \u0432\u044B
      \u0443\u0436\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E <color=#73f3ff>\u0447\u0438\u043F\u043E\u0432
      \u0434\u0430\u043D\u043D\u044B\u0445</color>, \u044F \u043E\u0431\u044A\u044F\u0441\u043D\u044E
      \u0444\u0443\u043D\u043A\u0446\u0438\u044E <color=#73f3ff>\u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u044F
      \u043C\u043E\u0434\u0443\u043B\u0435\u0439</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512880
    m_Localized: "\u041F\u043E\u0437\u0438\u0446\u0438\u0438 \u0438\u0434\u0435\u043D\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445
      \u043B\u0438\u0446 <color=#73f3ff>\u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u044B
      \u043D\u0430 \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u043F\u0430\u043D\u0435\u043B\u0438</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512881
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u044D\u0442\u0443 <color=#73f3ff>\u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u043F\u0430\u043D\u0435\u043B\u044C</color> \u043C\u043E\u0436\u043D\u043E
      <color=#73f3ff>\u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0434\u0430\u043D\u043D\u044B\u0435
      \u0446\u0435\u043B\u0438</color> \u0438 <color=#73f3ff>\u043F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u044C\u0441\u044F
      \u043A \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439
      \u043F\u043E\u0437\u0438\u0446\u0438\u0438</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512882
    m_Localized: "\u041F\u0440\u0438 <color=#73f3ff>\u0434\u043E\u0441\u0442\u0443\u043F\u0435
      \u043A \u043F\u0430\u043D\u0435\u043B\u0438</color> \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044F
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512883
    m_Localized: "\u0421\u043E\u0432\u0435\u0440\u0448\u0438\u0442\u0435 <color=#FF4C5C>\u0432\u0438\u0437\u0438\u0442</color>
      \u043A \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0439 \u0446\u0435\u043B\u0438
      \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435 \u0434\u0430\u043D\u043D\u044B\u0435.
      \u041A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E \u0431\u0443\u0434\u0443\u0442
      \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u044B \u043F\u0440\u0438\u0433\u043E\u0434\u043D\u044B\u0435
      \u0434\u0430\u043D\u043D\u044B\u0435, \u044F \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043D\u0430\u0447\u043D\u0443 \u0430\u043D\u0430\u043B\u0438\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512786
    m_Localized: "\u0415\u0441\u043B\u0438 \u043E\u0442\u0432\u0435\u0440\u0433\u0430\u0442\u044C
      \u0434\u0430\u0436\u0435 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C,
      \u0440\u0430\u0431\u043E\u0442\u0430 \u0432\u0440\u0430\u0447\u0430 \u0441\u0442\u0430\u043D\u0435\u0442
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0431\u0435\u0437\u0440\u0430\u0434\u043E\u0441\u0442\u043D\u043E\u0439,
      \u043D\u0435 \u0434\u0443\u043C\u0430\u0435\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512785
    m_Localized: "\u041C\u043E\u0436\u043D\u043E \u0432\u043E\u043E\u0431\u0449\u0435
      \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u044C \u0442\u0430\u043A\u043E\u0435
      \u043E\u0442 \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u043E\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512769
    m_Localized: "\u0414\u043E\u0441\u0442\u0443\u043F \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D.
      \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F
      \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0430\u044F \u043F\u0435\u0440\u0432\u0430\u044F
      \u043F\u043E\u043C\u043E\u0449\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512768
    m_Localized: "\u041E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u044B <color=#FF4C5C>\u0430\u043C\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u043F\u0440\u0430\u0432\u043E\u0439 \u0432\u0435\u0440\u0445\u043D\u0435\u0439
      \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u0438, \u043E\u0431\u0448\u0438\u0440\u043D\u044B\u0435
      \u043E\u0436\u043E\u0433\u0438 \u043E\u0442 \u043B\u0438\u0446\u0430 \u0434\u043E
      \u043F\u043B\u0435\u0447\u0430 \u0438 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
      \u043D\u0435\u0440\u0432\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512888
    m_Localized: "\u041F\u0440\u0438 <color=#73f3ff>\u0434\u043E\u0441\u0442\u0443\u043F\u0435
      \u043A \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439
      \u043F\u0430\u043D\u0435\u043B\u0438 \u043C\u043E\u0434\u0443\u043B\u0435\u0439</color>
      \u043C\u043E\u0436\u043D\u043E <color=#73f3ff>\u043F\u043E\u0432\u044B\u0441\u0438\u0442\u044C
      \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
      \u0438\u043C\u043F\u043B\u0430\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
      \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512889
    m_Localized: "\u041F\u0440\u0438 <color=#73f3ff>\u0434\u043E\u0441\u0442\u0443\u043F\u0435
      \u043A \u043F\u0430\u043D\u0435\u043B\u0438</color> \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044F
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512831
    m_Localized: "\u0422\u0430\u043A \u043C\u043D\u0435 \u0443\u0434\u043E\u0431\u043D\u0435\u0435.
      \u0418 \u0445\u0432\u043E\u0441\u0442\u043E\u0432 \u043C\u0435\u043D\u044C\u0448\u0435.
      \u041A \u0442\u043E\u043C\u0443 \u0436\u0435 \u044D\u0442\u043E\u0442 \u0442\u0438\u043F
      \u0434\u0430\u0432\u043D\u043E \u043F\u0435\u0440\u0435\u0448\u0435\u043B \u0447\u0435\u0440\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512866
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u0441\u043D\u0430\u0447\u0430\u043B\u0430:
      \u043F\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430\u043C
      \u0430\u043D\u0430\u043B\u0438\u0437\u0430 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432
      \u043D\u0430\u043D\u044F\u0442\u044B\u0445 \u043B\u0438\u0446 \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043C\u0435\u0441\u0442\u043E\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435
      <color=#ddbd78>\u0448\u0442\u0430\u0431-\u043A\u0432\u0430\u0440\u0442\u0438\u0440\u044B
      \u0421\u0438\u043D\u0434\u0438\u043A\u0430\u0442\u0430</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512867
    m_Localized: "\u0410 \u043F\u043B\u043E\u0445\u0430\u044F \u043D\u043E\u0432\u043E\u0441\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512860
    m_Localized: "\u0415\u0441\u043B\u0438 \u0431\u044B \u043C\u0435\u043D\u044F
      \u0432\u043E\u043B\u043D\u043E\u0432\u0430\u043B\u0430 \u0432\u044B\u0433\u043E\u0434\u0430,
      \u044F \u0431\u044B \u0443\u0448\u043B\u0430 \u043E\u0442\u0441\u044E\u0434\u0430,
      \u043D\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 1424586970947584
    m_Localized: "\u041E\u0434\u043D\u0430\u043A\u043E \u043F\u0440\u0438\u0447\u0438\u043D\u0430,
      \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043E\u043D \u0431\u044B\u043B
      \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0446\u0435\u043B\u044C\u044E
      \u0443\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u044F, \u043D\u0435
      \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512814
    m_Localized: "\u041D\u0435\u0442..."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512815
    m_Localized: "\u0423\u0434\u0430\u043B\u0438 \u0441\u043F\u0438\u0441\u043E\u043A."
