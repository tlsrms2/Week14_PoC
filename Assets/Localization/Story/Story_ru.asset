      m_Items: []
  - m_Id: 5333524512848
    m_Localized: "\u041D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0434\u0435\u043D\u044C \u043F\u043E\u0441\u043B\u0435 \u0438\u043D\u0446\u0438\u0434\u0435\u043D\u0442\u0430
      \u0432 Vesper \u0435\u0433\u043E <color=#FF4C5C>\u043D\u0430\u0448\u043B\u0438
      \u043C\u0435\u0440\u0442\u0432\u044B\u043C \u0443 \u0441\u0435\u0431\u044F
      \u0434\u043E\u043C\u0430, \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0432 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435 \u0441\u0430\u043C\u043E\u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430</color>.
      \u0418\u0441\u043A\u0430\u0436\u0435\u043D\u043D\u0430\u044F \u0444\u0438\u0433\u0443\u0440\u0430
      \u043D\u0430 \u0437\u0430\u043F\u0438\u0441\u044F\u0445 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0445
      \u043A\u0430\u043C\u0435\u0440 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442,
      \u0447\u0442\u043E <color=#ddbd78>\u041C\u0438\u0440\u0430\u0436</color> \u043D\u0430\u043D\u0435\u0441
      \u0435\u043C\u0443 <color=#FF4C5C>\u0432\u0438\u0437\u0438\u0442</color>."
