    m_Metadata:
      m_Items: []
  - m_Id: 5333524512813
    m_Localized: "<color=#ff4c5c>\u041F\u0435\u0440\u0435\u0434\u0430\u0442\u044C
      \u0441\u043F\u0438\u0441\u043E\u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445
      \u0446\u0435\u043B\u0435\u0439?</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901386
    m_Localized: "\u0414\u0430\u043B\u0435\u0435 \u2014 <color=#73f3ff>\u0430\u0434\u0430\u043F\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u0430\u044F
      \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0430 \u0441 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435\u043C
      \u043C\u0430\u043D\u0435\u043A\u0435\u043D\u043E\u0432</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901408
    m_Localized: "<color=#73f3ff>\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
      \u0443\u043A\u043B\u043E\u043D\u0438\u0442\u044C\u0441\u044F \u043E\u0442 \u0430\u0442\u0430\u043A\u0438
      \u0432\u0440\u0430\u0433\u0430 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
      \u043D\u0430\u0432\u044B\u043A\u0430 \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u0443\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u044F.</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 5333528707072
    m_Localized: "\u0412\u044B \u0442\u0430\u043A\u0436\u0435 \u043C\u043E\u0436\u0435\u0442\u0435
      <color=#73f3ff>\u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u0439
      \u043C\u043E\u0434\u0443\u043B\u044C \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      \u0432 \u0447\u0438\u043F\u044B \u0434\u0430\u043D\u043D\u044B\u0445</color>,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0435\u0441\u043B\u0438 <color=#73f3ff>\u0431\u043E\u0439
      \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u044C,
      \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0440\u0430\u0437\u043D\u044B\u0435
      \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0438 \u043C\u043E\u0434\u0443\u043B\u0435\u0439</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901406
    m_Localized: "\u0410\u043A\u0442\u0438\u0432\u043D\u044B\u0439 \u043D\u0430\u0432\u044B\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512818
    m_Localized: "\u0414\u0435\u043B\u043E \u043D\u0435 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0442\u0435\u043C, \u0447\u0442\u043E\u0431\u044B <color=#ff4c5c>\u0432\u044B\u0440\u0435\u0437\u0430\u0442\u044C
      \u043F\u043B\u043E\u0445\u043E\u0435</color>. \u041D\u0443\u0436\u043D\u043E
      \u0435\u0449\u0435 <color=#ddbd78>\u043F\u043E\u0437\u0430\u0431\u043E\u0442\u0438\u0442\u044C\u0441\u044F
      \u043E\u0431 \u043E\u0441\u0442\u0430\u0432\u0448\u0435\u0439\u0441\u044F \u0440\u0430\u043D\u0435.</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512819
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u044F \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u044E
      \u043D\u0430\u0439\u0442\u0438 \u044D\u0442\u043E\u0442 \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512856
    m_Localized: "\u041F\u0443\u0431\u043B\u0438\u0447\u043D\u043E \u043E\u043D \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u0435\u0442
      \u043A\u0430\u043A \u0430\u0440\u0442\u0438\u0441\u0442, \u0441\u043E\u0447\u0435\u0442\u0430\u044E\u0449\u0438\u0439
      \u043C\u0443\u0437\u044B\u043A\u0443 \u0438 \u0434\u0440\u043E\u043D-\u043F\u0435\u0440\u0444\u043E\u0440\u043C\u0430\u043D\u0441\u044B,
      \u043D\u043E \u0432 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438,
      \u0441\u0443\u0434\u044F \u043F\u043E \u0432\u0441\u0435\u043C\u0443, \u0441\u043E\u0441\u0442\u043E\u0438\u0442
      \u0432 <color=#ddbd78>\u0421\u0438\u043D\u0434\u0438\u043A\u0430\u0442\u0435</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901387
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u0440\u043E\u0442\u0435\u0441\u0442\u0438\u0440\u0443\u0435\u043C
      <color=#73f3ff>\u043C\u043E\u0434\u0443\u043B\u044C, \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
      \u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0438\u0440\u0443\u044E\u0449\u0438\u0439
      \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u0435 \u043F\u043E
      \u0432\u0440\u0430\u0436\u0434\u0435\u0431\u043D\u044B\u043C \u043E\u0431\u044A\u0435\u043A\u0442\u0430\u043C</color>.
      <color=#73f3ff>\u0412\u044B\u0441\u0442\u0440\u0435\u043B\u0438\u0442\u0435
      \u043A\u0443\u0434\u0430 \u0443\u0433\u043E\u0434\u043D\u043E.</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901401
    m_Localized: "\u0414\u0430\u043B\u0435\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435
      <color=#73f3ff>\u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043A\u0438</color>.
      \u042D\u043D\u0435\u0440\u0433\u043E\u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u044B
      \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u0438\u0441\u043F\u0443\u0441\u043A\u0430\u044E\u0442
      \u044D\u043D\u0435\u0440\u0433\u0438\u044E \u0434\u043B\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u044F
      \u0441\u0438\u0441\u0442\u0435\u043C\u044B AEGIS."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901400
    m_Localized: "\u041F\u0435\u0440\u0435\u0445\u0432\u0430\u0442 \u2014 <color=#73f3ff>\u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u0441\u043F\u043E\u0441\u043E\u0431 \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u044C
      \u043F\u0443\u043B\u0435\u0432\u044B\u0435 \u044D\u043D\u0435\u0440\u0433\u043E\u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u044B
      \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0431\u043E\u044F</color>. \u0423\u0447\u0442\u0438\u0442\u0435,
      \u0447\u0442\u043E \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u043D\u0430\u0440\u044F\u0434\u044B
      \u043D\u0435\u043B\u044C\u0437\u044F \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0438\u0442\u044C
      \u0438\u0437-\u0437\u0430 \u0438\u0445 \u0444\u043E\u0440\u043C\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901403
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901388
    m_Localized: "\u041C\u043E\u0434\u0443\u043B\u044C \u043A\u043E\u0440\u0440\u0435\u043A\u0446\u0438\u0438
      \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u044F \u0432
      \u043D\u043E\u0440\u043C\u0435. <color=#73f3ff>\u041F\u043E\u0437\u0436\u0435
      \u044D\u0442\u043E\u0442 \u043C\u043E\u0434\u0443\u043B\u044C \u043C\u043E\u0436\u043D\u043E
      \u0443\u0434\u0430\u043B\u0438\u0442\u044C, \u0435\u0441\u043B\u0438 \u043E\u043D
      \u0441\u0442\u0430\u043D\u0435\u0442 \u043D\u0435 \u043D\u0443\u0436\u0435\u043D</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 43636948828163
    m_Localized: "\u041F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0445
      \u0441\u043D\u0430\u0440\u044F\u0434\u043E\u0432 {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901409
    m_Localized: "\u0411\u0430\u0437\u043E\u0432\u0430\u044F \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0430
      \u0438\u043C\u043F\u043B\u0430\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
      \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430.
      \u0412 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043C
      <color=#73f3ff>\u0443\u0447\u0435\u0431\u043D\u044B\u0439 \u0431\u043E\u0439
      \u0441 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u043C \u043C\u0430\u043D\u0435\u043A\u0435\u043D\u043E\u043C</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512825
    m_Localized: "\u0422\u043E\u0442 \u0447\u0443\u0434\u0430\u043A, \u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u0433\u043E\u0432\u043E\u0440\u044F\u0442, \u0447\u0442\u043E \u043E\u043D
      <color=#ddbd78>\u0440\u0430\u0437\u044A\u0435\u0437\u0436\u0430\u0435\u0442
      \u043D\u0430 \u0441\u0432\u043E\u0438\u0445 \u043F\u0443\u0448\u043A\u0430\u0445</color>?
      \u0410 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512845
    m_Localized: "\u041F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
      \u044D\u0442\u043E \u043B\u0438\u0446\u043E \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u043E\u0441\u044C
      \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0438\u0435\u0439 <color=#ddbd78>\u0421\u0438\u043D\u0434\u0438\u043A\u0430\u0442\u0430</color>,
      \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438, \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0449\u0435\u0439
      \u043E\u0431\u043E\u0440\u043E\u0442\u043E\u043C \u043E\u0440\u0443\u0436\u0438\u044F,
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438 \u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512865
    m_Localized: "...\u0413\u043E\u0432\u043E\u0440\u0438 \u043F\u043E \u043F\u043E\u0440\u044F\u0434\u043A\u0443.
      \u041F\u043E\u0441\u043B\u0443\u0448\u0430\u044E \u0438 \u0440\u0435\u0448\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512792
    m_Localized: "<color=#A8B2BC>[ \u0417\u0430\u043F\u0438\u0441\u044C \u043C\u0435\u0436\u0434\u0443
      17:32:26 \u0438 17:32:41 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0430.
      ]</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 43636948828161
    m_Localized: "\u0411\u0430\u0437\u043E\u0432\u0430\u044F \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0430
      {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512820
    m_Localized: "...\u042F \u043F\u043E\u0439\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512874
    m_Localized: "\u041A\u0430\u043A \u0432\u0430\u043C \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E,
      \u043C\u044B \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u043C \u0431\u0430\u043B\u0430\u043D\u0441
      \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430 \u0447\u0435\u0440\u0435\u0437
      <color=#ff4c5c>\u0432\u0438\u0437\u0438\u0442\u044B</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 739306561925120
    m_Localized: "\u041A\u0440\u043E\u043C\u0435 \u0442\u043E\u0433\u043E, \u043F\u0440\u0438
      \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0435 <color=#73f3ff>\u0440\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442\u0441\u044F
      \u043F\u0443\u043B\u0435\u0432\u043E\u0439 \u044D\u043D\u0435\u0440\u0433\u043E\u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B,
      \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u043C\u044B\u0439 \u0432
      \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901413
    m_Localized: "<color=#ff4c5c>\u0422\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
      \u0443\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435 \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C.</color>
      \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0435
      \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512877
    m_Localized: "\u041F\u043E\u044D\u0442\u043E\u043C\u0443, <color=#73f3ff>\u0418\u043E\u043D</color>,
      \u043F\u043E\u043C\u043E\u0449\u044C \u0432\u0430\u043C \u0432 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u0438
      <color=#ff4c5c>\u0432\u0438\u0437\u0438\u0442\u043E\u0432</color> \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u0430
      \u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0439 \u0434\u043B\u044F \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430
      \u0432 \u0446\u0435\u043B\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512863
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0438.
      \u041A\u043E\u0434\u043E\u0432\u043E\u0435 \u0438\u043C\u044F: <color=#73f3ff>\u0418\u043E\u043D</color>.
      \u0421 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512794
    m_Localized: "\u041D\u0435 \u043E\u0447\u0435\u043D\u044C \u043F\u043E\u043D\u0438\u043C\u0430\u044E..."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901378
    m_Localized: "\u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901379
    m_Localized: "\u041D\u0430\u0436\u0438\u043C\u0430\u0439\u0442\u0435 \u043A\u043B\u0430\u0432\u0438\u0448\u0438
      <sprite name=\"icon_w\"><sprite name=\"icon_a\"><sprite name=\"icon_s\"><sprite
      name=\"icon_d\">, \u0447\u0442\u043E\u0431\u044B <color=#73f3ff>\u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901381
    m_Localized: "\u0414\u0430\u043B\u0435\u0435 \u0438\u0437\u043C\u0435\u0440\u0438\u043C
      \u0432\u043B\u0438\u044F\u043D\u0438\u0435 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E\u0433\u043E
      \u0438\u043C\u043F\u0443\u043B\u044C\u0441\u0430. <color=#73f3ff>\u041F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0438\u0442\u0435
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B \u0438\u0437 \u043E\u0440\u0443\u0436\u0438\u044F
      \u0432 \u043B\u0435\u0432\u043E\u0439 \u0440\u0443\u043A\u0435</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 1826406452789250
    m_Localized: "<color=#73f3ff>\u041F\u0435\u0440\u0435\u0445\u0432\u0430\u0442
      \u044D\u0442\u043E\u0433\u043E \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u0430</color>
      \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E <color=#73f3ff>\u043E\u0433\u043B\u0443\u0448\u0430\u0435\u0442
      \u0432\u0440\u0430\u0433\u0430, \u043D\u043E \u0438 \u0441\u043E\u0437\u0434\u0430\u0435\u0442
      \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
      \u044D\u043D\u0435\u0440\u0433\u0438\u044E</color>. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u044D\u0442\u043E, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E \u0432
      \u0431\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512872
    m_Localized: "\u0415\u0441\u043B\u0438 \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C
      \u043F\u0440\u043E\u0441\u0442\u043E, \u044D\u0442\u043E \u0441\u0432\u043E\u0435\u0433\u043E
      \u0440\u043E\u0434\u0430 \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512834
    m_Localized: "\u041A\u0442\u043E \u044D\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512840
    m_Localized: "\u0410\u043D\u0430\u043B\u0438\u0437 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u044B\u0445
      \u0432\u0430\u043C\u0438 \u0434\u0430\u043D\u043D\u044B\u0445 \u0443\u0436\u0435
      \u043F\u043E\u0447\u0442\u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D.
      \u0423 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C \u0432\u043E\u043F\u0440\u043E\u0441\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512878
    m_Localized: "...\u041F\u043E\u043D\u044F\u043B\u0430. \u0422\u043E\u0433\u0434\u0430
      \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
      \u043C\u0435\u043D\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901376
    m_Localized: "\u041D\u0430\u0447\u0438\u043D\u0430\u0435\u043C <color=#73f3ff>\u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0443
      \u0430\u0434\u0430\u043F\u0442\u0430\u0446\u0438\u0438 \u043A \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044E</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 4972079872663552
    m_Localized: "\u041E\u0442\u0435\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901384
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u043E\u0442\u0434\u0430\u0447\u0438
      \u0438 \u043A\u043E\u0440\u0440\u0435\u043A\u0446\u0438\u044F \u043F\u043E\u0437\u044B
      \u0432 \u043D\u043E\u0440\u043C\u0435. \u041E\u0442\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0439
      \u0432 \u0441\u0438\u0441\u0442\u0435\u043C\u0435 \u0440\u0430\u0432\u043D\u043E\u0432\u0435\u0441\u0438\u044F
      \u0442\u0435\u043B\u0430 \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512799
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512798
    m_Localized: "...\u042F \u043F\u0440\u0438\u0448\u043B\u0430. \u041F\u0430\u043F\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1108486769008640
    m_Localized: "[ \u0426\u0435\u043B\u044C ]"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512837
    m_Localized: "\u0418 \u043A \u043D\u0435\u043C\u0443 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
      <color=#FF4C5C>\u043D\u0430\u043D\u0435\u0441\u0442\u0438 \u0432\u0438\u0437\u0438\u0442</color>
      \u043B\u0438\u0447\u043D\u043E. \u0417\u043D\u0430\u0435\u0448\u044C, \u0433\u0434\u0435
      \u043E\u043D \u0441\u0435\u0439\u0447\u0430\u0441?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512793
    m_Localized: "<color=#ddbd78>...\u0436\u0438\u0442\u044C... \u043D\u0443\u0436\u043D\u043E.</color>
      \u041F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512890
    m_Localized: "\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 <color=#73f3ff>\u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432\u0430\u0442\u044C
      \u0438\u043C\u0435\u044E\u0449\u0438\u0435\u0441\u044F \u0447\u0438\u043F\u044B
      \u0434\u0430\u043D\u043D\u044B\u0445</color>, \u0447\u0442\u043E\u0431\u044B
      <color=#73f3ff>\u0440\u0430\u0441\u0448\u0438\u0440\u044F\u0442\u044C \u0438
      \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043D\u0443\u0436\u043D\u044B\u0435
      \u043C\u043E\u0434\u0443\u043B\u0438</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512891
    m_Localized: "<color=#73f3ff>\u0420\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u043D\u044B\u0435
      \u043C\u043E\u0434\u0443\u043B\u0438 \u043C\u043E\u0436\u043D\u043E \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E
      \u043C\u0435\u043D\u044F\u0442\u044C</color>, \u043D\u043E \u0443\u0447\u0442\u0438\u0442\u0435:
      <color=#ff4c5c>\u043D\u0435\u043B\u044C\u0437\u044F \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u043E\u0434\u0443\u043B\u0435\u0439
      \u043E\u0434\u043D\u043E\u0433\u043E \u0442\u0438\u043F\u0430</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512780
    m_Localized: "<color=#A8B2BC>[ \u0411\u043B\u043E\u043A R-2, \u043A\u0430\u0444\u0435
      Vesper. 21 \u0438\u044E\u043B\u044F, 17:29:20 ]</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512797
    m_Localized: "<color=#A8B2BC>[ \u0421 17:33:44 \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u0438
      \u0437\u0430\u043F\u0438\u0441\u0438 \u0431\u044B\u043B\u0438 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u044B
      \u0432\u0437\u0440\u044B\u0432\u043E\u043C. \u0414\u0430\u043D\u043D\u044B\u0435
      \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0442. ]</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512796
    m_Localized: "\u0410\u0445 \u0434\u0430, \u043D\u0430\u0434\u043E \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      <color=#ddbd78>\u043F\u043E\u0434\u0430\u0440\u0435\u043D\u043D\u044B\u0439
      \u0447\u0430\u0439</color>. \u041F\u043E\u043C\u043D\u0438\u0442\u0441\u044F,
      <color=#73f3ff>\u0442\u044B</color> \u043B\u044E\u0431\u0438\u043B\u0430 \u0437\u0435\u043B\u0435\u043D\u044B\u0439
      \u0447\u0430\u0439-"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512795
    m_Localized: "<color=#73f3ff>\u041C\u043E\u044F \u0434\u043E\u0447\u044C</color>
      \u0443\u043C\u043D\u0430\u044F. \u0414\u0443\u043C\u0430\u044E, \u043E\u0434\u043D\u0430\u0436\u0434\u044B
      \u0442\u044B \u043F\u043E\u0439\u043C\u0435\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512779
    m_Localized: "\u041D\u0430\u0447\u0438\u043D\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512778
    m_Localized: "\u041E\u0436\u0438\u0434\u0430\u0435\u0442\u0441\u044F, \u0447\u0442\u043E
      \u044D\u0442\u043E \u0437\u0430\u0439\u043C\u0435\u0442 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F
      <color=#73f3ff>\u043F\u0440\u043E\u0439\u0442\u0438 \u0430\u0434\u0430\u043F\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u0443\u044E
      \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0443</color> \u0432\u043E
      \u0432\u0440\u0435\u043C\u044F \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512842
    m_Localized: "\u041F\u0440\u0438\u0447\u0438\u043D\u0430 \u043F\u0440\u043E\u0441\u0442\u0430.
      <color=#FF4C5C>\u0412\u0437\u0440\u044B\u0432 \u0432 Vesper \u0431\u044B\u043B
      \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0441\u0442\u044C\u044E</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512843
    m_Localized: "...\u0427\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512875
    m_Localized: "\u041E\u0434\u043D\u0430\u043A\u043E <color=#ddbd78>\u0442\u0435,
      \u043A\u0442\u043E \u0434\u0432\u0438\u0436\u0438\u043C \u0432\u044B\u0433\u043E\u0434\u043E\u0439</color>,
      \u0432 \u0438\u0442\u043E\u0433\u0435 \u0442\u0435\u0440\u044F\u044E\u0442
      \u044F\u0441\u043D\u043E\u0441\u0442\u044C \u0441\u0443\u0436\u0434\u0435\u043D\u0438\u0439
      \u0438 \u043D\u0435\u0438\u0437\u0431\u0435\u0436\u043D\u043E \u043A\u043E\u0440\u0440\u0443\u043C\u043F\u0438\u0440\u0443\u044E\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512876
    m_Localized: "\u041D\u0430\u043F\u0440\u043E\u0442\u0438\u0432, \u0442\u0435,
      \u043A\u0435\u043C \u0434\u0432\u0438\u0436\u0435\u0442 \u043D\u0435 \u0432\u044B\u0433\u043E\u0434\u0430,
      \u0430 <color=#FF4C5C>\u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043C\u043E\u0442\u0438\u0432</color>, \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F
