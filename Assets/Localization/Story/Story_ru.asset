  - m_Id: 5333524512800
    m_Localized: "\u042F \u0442\u043E\u0436\u0435 \u0445\u043E\u0442\u0435\u043B\u0430...
      \u0441\u0442\u0430\u0442\u044C \u0445\u043E\u0440\u043E\u0448\u0438\u043C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C,
      \u043A\u0430\u043A \u0442\u044B, \u043F\u0430\u043F\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512801
    m_Localized: "\u041F\u0443\u0441\u0442\u044C \u0438 \u0434\u0440\u0443\u0433\u0438\u043C
      \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C... \u044F \u0445\u043E\u0442\u0435\u043B\u0430
      \u0431\u044B\u0442\u044C \u0442\u0435\u043C, \u043A\u0442\u043E \u0441\u043F\u0430\u0441\u0430\u0435\u0442
      \u043B\u044E\u0434\u0435\u0439..."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512802
    m_Localized: "\u042F \u0434\u0430\u0436\u0435 \u043B\u044E\u0431\u0438\u043C\u0443\u044E
      \u0441\u0435\u043C\u044C\u044E \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C
      \u043D\u0435 \u0441\u043C\u043E\u0433\u043B\u0430... \u042F..."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512803
    m_Localized: "<color=#FF4C5C>\u042F \u0445\u043E\u0447\u0443 \u0441\u043E\u0437\u0434\u0430\u0442\u044C
      \u043C\u0438\u0440, \u0433\u0434\u0435 \u0445\u043E\u0440\u043E\u0448\u0438\u0435
      \u043B\u044E\u0434\u0438 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435
      \u0431\u0443\u0434\u0443\u0442 \u0441\u0442\u0440\u0430\u0434\u0430\u0442\u044C.</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512835
    m_Localized: "\u042D\u0442\u043E <color=#ddbd78>\u043A\u0440\u0443\u043F\u043D\u044B\u0439
      \u043D\u0430\u0435\u043C\u043D\u0438\u043A</color> \u043F\u043E \u0438\u043C\u0435\u043D\u0438
      <color=#ddbd78>\u0420\u044D\u043C</color>. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
      <color=#ddbd78>\u0432\u044B\u0441\u043E\u043A\u043E\u043C\u043E\u0449\u043D\u043E\u043C\u0443
      \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044E \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u044F</color> \u0438\u0434\u0435\u043D\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0435\u0433\u043E \u0431\u044B\u043B\u043E \u043D\u0435\u0441\u043B\u043E\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512836
    m_Localized: "\u041E\u0434\u043D\u0430\u043A\u043E, \u043A\u0430\u043A \u0438
      \u0432 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u043C \u0441\u043B\u0443\u0447\u0430\u0435,
      \u043E\u0442\u0441\u043B\u0435\u0434\u0438\u0442\u044C, \u043A\u0442\u043E
      \u0437\u0430\u043A\u0430\u0437\u0430\u043B \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u0443
      \u0432\u0437\u0440\u044B\u0432\u0447\u0430\u0442\u043A\u0438, \u043D\u0435
      \u0443\u0434\u0430\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512784
    m_Localized: "\u041F\u0430\u0446\u0438\u0435\u043D\u0442, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u044F \u043D\u0435\u0434\u0430\u0432\u043D\u043E \u043E\u043F\u0435\u0440\u0438\u0440\u043E\u0432\u0430\u043B,
      \u043F\u043E\u0434\u0430\u0440\u0438\u043B \u043C\u043D\u0435 \u044D\u0442\u043E\u0442
      \u0434\u043E\u0440\u043E\u0433\u043E\u0439 \u0447\u0430\u0439\u043D\u044B\u0439
      \u043D\u0430\u0431\u043E\u0440 <color=#ddbd78>\u0432 \u0437\u043D\u0430\u043A
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u0438</color>.
      \u042F \u0432\u0437\u044F\u043B \u0435\u0433\u043E \u0441 \u0441\u043E\u0431\u043E\u0439,
      \u0440\u0430\u0437 \u0443\u0436 \u0434\u0430\u0432\u043D\u043E \u043D\u0435
      \u0432\u0438\u0434\u0435\u043B <color=#73f3ff>\u0441\u0432\u043E\u044E \u0434\u043E\u0447\u044C</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512830
    m_Localized: "\u0415\u0441\u043B\u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u0430\u043D\u043D\u044B\u0435,
      \u0430\u043D\u0430\u043B\u0438\u0437 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438
      \u0431\u0443\u0434\u0435\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u0435\u043D.
      \u0412\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0435\u0441\u044C \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0442\u044C
      <color=#FF4C5C>\u0432\u0438\u0437\u0438\u0442</color>?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512808
    m_Localized: "\u041D\u043E \u0437\u043D\u0430\u0435\u0448\u044C. \u041A\u043E\u0433\u0434\u0430
      \u0440\u0435\u0447\u044C \u0438\u0434\u0435\u0442 \u043E <color=#ddbd78>\u0441\u043F\u0430\u0441\u0435\u043D\u0438\u0438
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512809
    m_Localized: "<color=#ddbd78>\u0412\u0430\u0436\u043D\u043E \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0443\u0434\u0430\u043B\u0438\u0442\u044C \u043F\u043B\u043E\u0445\u0443\u044E
      \u043E\u043F\u0443\u0445\u043E\u043B\u044C, \u043D\u043E \u0438 \u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u043D\u043E\u0436 \u0438 \u0437\u0430\u0448\u0438\u0442\u044C \u0440\u0430\u043D\u0443.</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512833
    m_Localized: "\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u043E.
      \u0414\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      <color=#ddbd78>\u043A\u0443\u0440\u044C\u0435\u0440\u0430, \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0432\u0448\u0435\u0433\u043E
      \u0432\u0437\u0440\u044B\u0432\u0447\u0430\u0442\u043A\u0443</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 43636948828165
    m_Localized: "\u0423\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435 \u043D\u0430\u0432\u044B\u043A\u043E\u043C
      {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1826406452789252
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0432\u0440\u0430\u0433 \u0433\u043E\u0442\u043E\u0432\u0438\u0442
      <color=#ff4c5c>\u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u043E\u0449\u043D\u044B\u0435
      \u0430\u0442\u0430\u043A\u0438</color>, <color=#73f3ff>\u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0433\u043B\u0430\u0437\u043D\u043E\u0439 \u043F\u0440\u043E\u0442\u0435\u0437
      ARGUS \u0437\u0430\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442 \u0443\u044F\u0437\u0432\u0438\u043C\u044B\u0439
      \u0441\u0438\u043D\u0438\u0439 \u044D\u043D\u0435\u0440\u0433\u043E\u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B</color>.
      \u041F\u0440\u0438 <color=#73f3ff>\u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0435
      \u044D\u0442\u043E\u0433\u043E \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u0430</color>
      <color=#73f3ff>\u0432\u0440\u0430\u0433 \u043E\u0433\u043B\u0443\u0448\u0430\u0435\u0442\u0441\u044F,
      \u0430 \u0440\u044F\u0434\u043E\u043C \u0441\u043E\u0437\u0434\u0430\u0435\u0442\u0441\u044F
      \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u044D\u043D\u0435\u0440\u0433\u0438\u044F</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512838
    m_Localized: "\u041F\u043E\u0434\u043E\u0436\u0434\u0438\u0442\u0435. \u042F
      <color=#73f3ff>\u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u0443\u044E
      \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0435 \u0434\u0430\u043D\u043D\u044B\u0435
      \u043D\u0430 \u043F\u0430\u043D\u0435\u043B\u0438</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512839
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0438.
      \u041A\u043E\u0434\u043E\u0432\u043E\u0435 \u0438\u043C\u044F: <color=#73f3ff>\u0418\u043E\u043D</color>.
      \u0421 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512824
    m_Localized: "\u041C\u0435\u0441\u0442\u043E: \u0437\u0430\u043A\u0440\u044B\u0442\u0430\u044F
      \u0441\u0442\u0430\u043D\u0446\u0438\u044F \u043C\u0435\u0442\u0440\u043E \u0443
      <color=#ddbd78>\u0431\u043B\u043E\u043A\u0430 M-8</color>, <color=#ddbd78>\u0447\u0435\u0440\u043D\u044B\u0439
      \u0440\u044B\u043D\u043E\u043A</color>. \u041F\u0440\u043E\u0434\u0430\u0432\u0435\u0446:
      <color=#ddbd78>\u043E\u0440\u0443\u0436\u0435\u0439\u043D\u0438\u043A \u0421\u0430\u043B\u044C\u0432\u043E</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512864
    m_Localized: "\u041D\u0430 \u0434\u0430\u043D\u043D\u044B\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
      \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D \u0430\u043D\u0430\u043B\u0438\u0437
      \u0434\u0432\u0443\u0445 \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u0439.
      \u0415\u0441\u043B\u0438 \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B\u043C \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u0435\u043C,
      \u0435\u0441\u0442\u044C \u0445\u043E\u0440\u043E\u0448\u0430\u044F \u0438
      \u043F\u043B\u043E\u0445\u0430\u044F \u043D\u043E\u0432\u043E\u0441\u0442\u0438.
      \u0421 \u043A\u0430\u043A\u043E\u0439 \u043D\u0430\u0447\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901407
    m_Localized: "\u0412\u0432\u043E\u0434 <sprite name=\"icon_space\"> \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      <color=#73f3ff>\u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439 \u043D\u0430\u0432\u044B\u043A</color>.
      \u0423 <color=#73f3ff>\u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E
      \u043D\u0430\u0432\u044B\u043A\u0430 \u0435\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430</color>,
      \u0438 \u0441\u043F\u0443\u0441\u0442\u044F \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F \u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0441\u043D\u043E\u0432\u0430.
      <color=#73f3ff>\u0428\u043A\u0430\u043B\u0430 \u043D\u0430\u0432\u044B\u043A\u0430
      \u043D\u0430 \u0440\u0430\u043C\u043A\u0435 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430</color>
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442, \u0433\u043E\u0442\u043E\u0432
      \u043B\u0438 \u043D\u0430\u0432\u044B\u043A \u043A \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 1826406394068992
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u0430\u0442\u0430\u043A\u0430 {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901415
    m_Localized: "<color=#ff4c5c>\u0412\u0441\u0435 \u043F\u0443\u043B\u0435\u0432\u044B\u0435
      \u044D\u043D\u0435\u0440\u0433\u043E\u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u044B
      \u0438\u0437\u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432\u0430\u043D\u044B</color>.
      \u0412\u044B\u043F\u043E\u043B\u043D\u044F\u044E \u043F\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 5333461598208
    m_Localized: E.R.I.S.
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512827
    m_Localized: "\u0414\u0430\u0436\u0435 \u0437\u0430 \u0434\u043E\u043F\u043B\u0430\u0442\u0443
      \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512853
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u043B\u044E\u0434\u0438
      <color=#ddbd78>\u0421\u0438\u043D\u0434\u0438\u043A\u0430\u0442\u0430</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512790
    m_Localized: "\u041D\u043E... \u0434\u0430. <color=#ff4c5c>\u0418\u043D\u043E\u0433\u0434\u0430
      \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u044F \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u0430</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333520318464
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 5333520318465
    m_Localized: "\u041A\u043E\u0434\u043E\u0432\u043E\u0435 \u0438\u043C\u044F:
      <color=#73f3ff>\u0418\u043E\u043D</color>. \u041A\u043B\u0430\u0441\u0441 K26.
      \u0410\u043A\u0442\u0438\u0432\u043D\u044B\u0445 \u0437\u0430\u0434\u0430\u043D\u0438\u0439
      \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 5333520318466
    m_Localized: "\u041E\u0441\u043E\u0431\u044B\u0435 \u043E\u0442\u043C\u0435\u0442\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901391
    m_Localized: "<color=#73f3ff>\u0421\u0438\u0441\u0442\u0435\u043C\u0430 AEGIS
      \u2014 \u0432\u0430\u0436\u043D\u0430\u044F \u0444\u0443\u043D\u043A\u0446\u0438\u044F,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u0440\u0438 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0438
      \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B
      \u0438 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442
      \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435</color>.
      \u0412 \u0446\u0435\u043B\u044F\u0445 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C \u0435\u0435 \u0437\u0430\u0440\u0430\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512862
    m_Localized: "\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u043E.
      \u041F\u0435\u0440\u0435\u0434 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C
      \u043F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430:
      <color=#73f3ff>\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435 \u043C\u043E\u0434\u0443\u043B\u0438
      \u0431\u044B\u043B\u0438 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u044B</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512868
    m_Localized: "\u041D\u0435\u0434\u0430\u0432\u043D\u043E \u043E\u0442 \u0438\u043C\u0435\u043D\u0438
      \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u0430, <color=#ddbd78>\u0421\u0438\u043D\u0434\u0438\u043A\u0430\u0442\u0430</color>,
      \u0431\u044B\u043B\u043E \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u043E
      \u043D\u043E\u0432\u043E\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u0435.
      <color=#ff4c5c>\u0412\u0438\u0437\u0438\u0442\u0435\u0440</color>, \u043A\u043E\u0434\u043E\u0432\u043E\u0435
      \u0438\u043C\u044F <color=#ddbd78>\u042D\u0445\u043E</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512844
    m_Localized: "\u041F\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430\u043C
      \u0430\u043D\u0430\u043B\u0438\u0437\u0430 \u0442\u0435\u0440\u043C\u0438\u043D\u0430\u043B\u0430
      <color=#ddbd78>\u0420\u044D\u043C\u0430</color>, \u0446\u0435\u043B\u044C\u044E
      \u0443\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0431\u044B\u043B
      \u0438\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044C
      \u043F\u043E\u0434\u0430\u0440\u043A\u0430, \u0442\u043E \u0435\u0441\u0442\u044C
      <color=#ddbd78>\u043F\u0430\u0446\u0438\u0435\u043D\u0442 \u0432\u0430\u0448\u0435\u0433\u043E
      \u043E\u0442\u0446\u0430</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901380
    m_Localized: "\u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0432 \u043D\u043E\u0440\u043C\u0435.
