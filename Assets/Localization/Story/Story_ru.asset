    m_Localized: "\u041F\u0435\u0440\u0435\u0445\u0432\u0430\u0442 \u0441\u043D\u0430\u0440\u044F\u0434\u043E\u0432
      {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1826406452789248
    m_Localized: "\u041D\u0430\u043A\u043E\u043D\u0435\u0446, \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0430
      <color=#73f3ff>\u043A\u043E\u043D\u0442\u0440\u0430\u0442\u0430\u043A\u0438</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901405
    m_Localized: "\u0414\u0430\u043B\u0435\u0435 \u2014 <color=#73f3ff>\u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439
      \u043D\u0430\u0432\u044B\u043A</color>. \u0427\u0430\u0441\u0442\u044C \u044D\u043D\u0435\u0440\u0433\u0438\u0438,
      \u0438\u0441\u043F\u0443\u0441\u043A\u0430\u0435\u043C\u043E\u0439 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u043E\u043C,
      \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0434\u043B\u044F
      <color=#73f3ff>\u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E\u0433\u043E
      \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u044F \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0445
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 43636948828160
    m_Localized: "\u0422\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0430 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
      {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1345961062363136
    m_Localized: "\u0420\u0430\u0437\u0443\u043C\u043D\u043E\u0435 \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435.
      \u0422\u043E\u0433\u0434\u0430 \u043F\u0435\u0440\u0435\u0434 \u0431\u043E\u0435\u043C
      \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u044E \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0440\u0430\u0437 <color=#73f3ff>\u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u043C\u043E\u0434\u0443\u043B\u0438</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 4972079872663553
    m_Localized: "\u0418\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512854
    m_Localized: "\u0412\u0435\u0440\u043D\u043E. \u041E\u043F\u0435\u0440\u0430\u0446\u0438\u0435\u0439
      \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u043B <color=#ddbd78>\u041A\u044D\u043D\u043E\u043D</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512855
    m_Localized: "<color=#ddbd78>\u041A\u044D\u043D\u043E\u043D</color>? \u041E\u043D
      \u0438\u0437 \u044D\u0442\u043E\u0433\u043E \u043C\u0438\u0440\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512787
    m_Localized: "\u041F\u0430\u043F\u0430 \u0447\u0430\u0441\u0430\u043C\u0438 \u0432\u0435\u0441\u044C
      \u0432 \u043A\u0440\u043E\u0432\u0438 \u0441\u043F\u0430\u0441\u0430\u0435\u0442
      \u043B\u044E\u0434\u0435\u0439... \u0422\u0440\u0443\u0434\u043D\u043E \u043F\u043E\u043D\u044F\u0442\u044C,
      \u0447\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E \u0432
      \u0442\u043E\u043C, \u0447\u0442\u043E\u0431\u044B \u043B\u044E\u0434\u0438
      \u0445\u043E\u0442\u0435\u043B\u0438 \u0443\u0431\u0438\u0432\u0430\u0442\u044C
      \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512857
    m_Localized: "\u041E\u0431\u044B\u0447\u043D\u043E \u043C\u0435\u0441\u0442\u043E\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435
      \u0442\u0430\u043A\u0438\u0445 \u0432\u044B\u0441\u043E\u043A\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0445
      \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439
      \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C \u043D\u0435\u043F\u0440\u043E\u0441\u0442\u043E,
      \u043D\u043E \u043E <color=#ddbd78>\u041A\u044D\u043D\u043E\u043D\u0435</color>
      \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E \u043C\u043D\u043E\u0433\u043E
      \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0435\u0433\u043E \u043F\u043E\u0437\u0438\u0446\u0438\u044E
      \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0431\u0435\u0437 \u0442\u0440\u0443\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512850
    m_Localized: "\u0412 \u0431\u0430\u0437\u0435 \u0434\u0430\u043D\u043D\u044B\u0445
      \u0435\u0441\u0442\u044C \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u043C\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435
      <color=#ddbd78>\u041C\u0438\u0440\u0430\u0436\u0430</color>, \u043D\u043E \u043F\u0440\u043E\u0448\u0443
      \u043F\u043E\u043D\u044F\u0442\u044C: \u044F \u043D\u0435 \u043C\u043E\u0433\u0443
      \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0435\u0433\u043E
      \u0431\u0435\u0437 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438
      \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0437\u0430\u0434\u0430\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512851
    m_Localized: "\u041D\u0435 \u043D\u0443\u0436\u043D\u043E. \u0415\u0441\u043B\u0438
      \u044F \u043F\u043E\u0431\u0440\u043E\u0436\u0443 \u0443 \u0434\u043E\u043C\u0430
      <color=#ddbd78>\u0442\u043E\u0433\u043E \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0430</color>,
      \u043E\u043D \u0441\u0430\u043C \u043F\u0440\u0438\u0434\u0435\u0442 \u043D\u0430\u043D\u0435\u0441\u0442\u0438
      \u043C\u043D\u0435 <color=#FF4C5C>\u0432\u0438\u0437\u0438\u0442</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512804
    m_Localized: "\u041A\u043E\u0434\u043E\u0432\u043E\u0435 \u0438\u043C\u044F:
      <color=#73f3ff>\u0418\u043E\u043D</color>. \u041F\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430\u043C
      \u0430\u043D\u0430\u043B\u0438\u0437\u0430 \u0434\u0430\u043D\u043D\u044B\u0445
      \u0421\u0438\u043D\u0434\u0438\u043A\u0430\u0442\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D
      \u0440\u0430\u0437\u0431\u043E\u0440 \u043B\u0438\u0446, \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0445 \u0441 \u0438\u043D\u0446\u0438\u0434\u0435\u043D\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512805
    m_Localized: "<color=#ff4c5c>\u041F\u0435\u0440\u0435\u0434\u0430\u0442\u044C
      \u0441\u043F\u0438\u0441\u043E\u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445
      \u0446\u0435\u043B\u0435\u0439?</color>"
