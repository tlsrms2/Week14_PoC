      \u0432 \u043D\u0435\u0440\u0432\u043D\u0443\u044E \u0441\u0438\u0441\u0442\u0435\u043C\u0443.
      \u041F\u043E\u0441\u043B\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u044F
      <color=#73f3ff>\u0430\u0434\u0430\u043F\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439
      \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0438</color> \u043E\u0436\u0438\u0434\u0430\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0440\u0435\u0430\u043A\u0446\u0438\u0438
      \u0438 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
