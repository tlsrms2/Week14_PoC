--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Story_ko-KR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ko-KR
  m_SharedData: {fileID: 11400000, guid: 8a8e32e629c410a4c97867fa550435ab, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5333461598208
    m_Localized: ERIS
    m_Metadata:
      m_Items: []
  - m_Id: 5333520318464
    m_Localized: "\uC2E0\uC6D0\uC744 \uD655\uC778\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333520318465
    m_Localized: "\uCF54\uB4DC\uBA85 \uC774\uC628, \uB4F1\uAE09 K26, \uC218\uD589
      \uC911\uC778 \uC784\uBB34 \uC5C6\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 5333520318466
    m_Localized: "\uD2B9\uC774\uC0AC\uD56D."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512768
    m_Localized: "\uC6B0\uCE21 \uC0C1\uC9C0 \uACB0\uC190, \uC548\uBA74\uBD80\uC5D0\uC11C
      \uACAC\uBD80\uAE4C\uC9C0 \uC774\uC5B4\uC9C0\uB294 \uAD11\uBC94\uC704\uD55C
      \uD654\uC0C1 \uBC0F \uC2E0\uACBD\uACC4 \uC190\uC0C1\uC774 \uAC10\uC9C0\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512769
    m_Localized: "\uCD9C\uC785 \uD5C8\uAC00. \uC989\uC2DC \uC751\uAE09\uCC98\uCE58
      \uBC1B\uC744 \uAC83\uC744 \uAD8C\uC7A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512770
    m_Localized: "\uCD94\uAC00\uB85C \uC694\uCCAD\uC0AC\uD56D\uC774 \uC788\uC73C\uC2E0\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512771
    m_Localized: "\uC774\uC628"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512772
    m_Localized: "...R-2 \uBE14\uB85D, \uCE74\uD398 \uBCA0\uC2A4\uD37C. \uC624\uB298
      17\uC2DC 33\uBD84 \uC804\uD6C4 \uC601\uC0C1 \uAE30\uB85D \uC804\uBD80."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512773
    m_Localized: "\uC2E0\uCCB4 \uAE30\uB2A5 \uC218\uBCF5\uB960 79%. \uC6B0\uCE21
      \uC758\uC218 \uC2E0\uACBD \uC811\uC18D\uC744 \uC644\uB8CC\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512774
    m_Localized: "\uC694\uCCAD\uC5D0 \uB530\uB77C ARGUS \uC804\uC220 \uC758\uC548\uC758
      \uC2DC\uAC01 \uBCF4\uC815 \uAE30\uB2A5\uC744 \uC758\uC218\uC758 \uC6B4\uB3D9
      \uC81C\uC5B4\uACC4\uC640 \uC5F0\uB3D9\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512775
    m_Localized: "\uCD94\uAC00\uB85C AEGIS \uCF54\uC5B4 \uC778\uD130\uD398\uC774\uC2A4\uB97C
      \uC2E0\uACBD\uACC4\uC5D0 \uC774\uC2DD\uD588\uC2B5\uB2C8\uB2E4. \uC801\uC751
      \uD6C8\uB828\uC744 \uB9C8\uCE58\uBA74 \uBC18\uC751 \uC18D\uB3C4\uC640 \uC870\uC791
      \uC815\uBC00\uB3C4\uB97C \uC190\uC2E4 \uC774\uC804\uBCF4\uB2E4 \uD5A5\uC0C1\uC2DC\uD0AC
      \uC218 \uC788\uC744 \uAC83\uC73C\uB85C \uC608\uC0C1\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512776
    m_Localized: "\uBCA0\uC2A4\uD37C \uC790\uB8CC\uB294?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512777
    m_Localized: "\uD3ED\uBC1C\uB85C \uC6D0\uBCF8 \uAE30\uB85D \uB300\uBD80\uBD84\uC774
      \uC720\uC2E4\uB418\uC5B4, \uC778\uADFC \uAE30\uB85D \uC7A5\uCE58\uC5D0 \uB0A8\uC740
      \uD30C\uD3B8\uB4E4\uB85C \uB370\uC774\uD130\uB97C \uC7AC\uAD6C\uC131 \uC911\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512778
    m_Localized: "\uC2DC\uAC04\uC774 \uC5B4\uB290 \uC815\uB3C4 \uC18C\uC694\uB420
      \uAC83\uC73C\uB85C \uC608\uC0C1\uB418\uBBC0\uB85C, \uAE30\uB2E4\uB9AC\uB294
      \uB3D9\uC548 \uC801\uC751 \uD6C8\uB828\uC744 \uC9C4\uD589\uD560 \uAC83\uC744
      \uAD8C\uC7A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512779
    m_Localized: "\uC2DC\uC791\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512780
    m_Localized: "[R-2 \uBE14\uB85D \uCE74\uD398 \uBCA0\uC2A4\uD37C. 7\uC6D4 21\uC77C
      17\uC2DC 29\uBD84 20\uCD08 ]"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512781
    m_Localized: "[ \uC7AC\uAD6C\uC131\uB41C \uAE30\uB85D \uB9E4\uCCB4\uB97C \uC7AC\uC0DD\uD569\uB2C8\uB2E4.
      ]"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512782
    m_Localized: "\uC544\uBE60, \uC774 \uC0C1\uC790\uB294?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512783
    m_Localized: "\uC544\uBC84\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512784
    m_Localized: "\uC774\uBC88\uC5D0 \uC218\uC220\uD55C \uD658\uC790\uBD84\uAED8\uC11C
      \uAC10\uC0AC\uC758 \uC120\uBB3C\uB85C \uC8FC\uC2E0 \uACE0\uAE09 \uCC28 \uC138\uD2B8\uB77C\uB294\uB370,
      \uC624\uB79C\uB9CC\uC5D0 \uC6B0\uB9AC \uB538 \uBCF4\uB294 \uAE40\uC5D0 \uAC00\uC838\uC654\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512785
    m_Localized: "\uD658\uC790\uD55C\uD14C \uADF8\uB7F0 \uAC78 \uB9C9 \uBC1B\uC544\uB3C4
      \uB3FC?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512786
    m_Localized: "\uACE0\uB9D9\uB2E4\uB294 \uB9C8\uC74C\uAE4C\uC9C0 \uAC70\uC808\uD558\uBA74
      \uC758\uC0AC \uC77C\uB3C4 \uB108\uBB34 \uC0AD\uB9C9\uD574\uC9C0\uC9C0 \uC54A\uACA0\uB2C8."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512787
    m_Localized: "\uC544\uBE60\uB294 \uBA87 \uC2DC\uAC04\uC774\uB098 \uD53C\uB97C
      \uB4A4\uC9D1\uC5B4 \uC368\uAC00\uBA70 \uC0AC\uB78C\uB4E4\uC744 \uC0B4\uB9AC\uACE0
      \uC788\uB294\uB370.. \uBB50\uAC00 \uC88B\uC544\uC11C \uC0AC\uB78C\uC774 \uC0AC\uB78C\uC744
      \uC8FD\uC774\uB824 \uD558\uB294\uC9C0 \uC774\uD574\uD558\uAE30 \uC5B4\uB835\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512788
    m_Localized: "...\uD06C\uD760. \uADF8\uB798\uB3C4 \uC5C4\uCCAD \uB098\uC05C \uC9D3\uC744
      \uD558\uB294 \uC0AC\uB78C\uC774 \uC8FD\uB294 \uAC70\uB77C\uBA74 \uAD1C\uCC2E\uC9C0
      \uC54A\uC744\uAE4C? \uB098\uC05C \uC870\uC9C1\uC744 \uC798\uB77C\uB0B4\uB294
      \uC218\uC220\uCC98\uB7FC \uB9D0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512789
    m_Localized: "\uC758\uC0AC \uC55E\uC5D0\uC11C \uBABB\uD558\uB294 \uB9D0\uC774
      \uC5C6\uAD6C\uB098 \uC6B0\uB9AC \uB538."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512790
    m_Localized: "\uD558\uC9C0\uB9CC.. \uADF8\uB798. \uB54C\uB85C\uB294 \uC218\uC220\uC774
      \uD544\uC694\uD55C \uACBD\uC6B0\uAC00 \uC788\uACA0\uC9C0. "
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512791
    m_Localized: "\uADF8\uB7F0\uB370 \uB9D0\uC774\uB2E4. \uC0AC\uB78C\uC744 \uC0B4\uB9B4
      \uB54C \uC911\uC694\uD55C \uAC74-"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512792
    m_Localized: "[ 17\uC2DC 32\uBD84 26\uCD08\uBD80\uD130 41\uCD08 \uC0AC\uC774\uC758
      \uAE30\uB85D\uC774 \uC190\uC0C1\uB418\uC5C8\uC2B5\uB2C8\uB2E4. ]"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512793
    m_Localized: "...\uB824\uB193...\uC57C \uD574. \uC54C\uACA0\uB2C8?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512794
    m_Localized: "\uC798 \uBAA8\uB974\uACA0\uC5B4..."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512795
    m_Localized: "\uC6B0\uB9AC \uB538\uC740 \uB611\uB611\uD558\uB2C8\uAE4C \uC5B8\uC820\uAC00
      \uC774\uD574\uD560 \uAC70\uB77C \uC0DD\uAC01\uD55C\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512796
    m_Localized: "\uCC38, \uC120\uBB3C \uBC1B\uC740 \uCC28\uB098 \uB9C8\uC154 \uBD10\uC57C\uACA0\uAD6C\uB098.
      \uB108\uAC00 \uBD84\uBA85 \uB179\uCC28\uB97C \uC88B\uC544\uD588-"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512797
    m_Localized: "[ 17\uC2DC 33\uBD84 44\uCD08\uBD80\uD130\uB294 \uD3ED\uBC1C\uB85C
      \uAE30\uB85D \uB9E4\uCCB4\uB4E4\uC774 \uD30C\uAD34\uB418\uC5B4 \uB370\uC774\uD130\uAC00
      \uC874\uC7AC\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. ]"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512798
    m_Localized: "...\uB098 \uC654\uC5B4. \uC544\uBE60."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512799
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512800
    m_Localized: "\uB098\uB3C4 \uC544\uBE60\uCC98\uB7FC... \uC88B\uC740 \uC0AC\uB78C\uC774
      \uB418\uACE0 \uC2F6\uC5C8\uB294\uB370..."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512801
    m_Localized: "\uD615\uD0DC\uB294 \uC870\uAE08 \uB2EC\uB77C\uB3C4.. \uC0AC\uB78C\uB4E4\uC744
      \uAD6C\uD558\uB294 \uC0AC\uB78C\uC774 \uB418\uACE0 \uC2F6\uC5C8\uB294\uB370..."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512802
    m_Localized: "\uC0AC\uB791\uD558\uB294 \uAC00\uC871\uB3C4 \uC9C0\uD0A4\uC9C0
      \uBABB\uD588\uC5B4.. \uB098\uB294..."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512803
    m_Localized: "<b><color=red>\uC88B\uC740 \uC0AC\uB78C\uC774 \uB354\uB294 \uC0C1\uCC98\uBC1B\uC9C0
      \uC54A\uB294 \uC138\uC0C1\uC744 \uB9CC\uB4E4\uACE0 \uC2F6\uC5B4.</b></color>"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512804
    m_Localized: "\uCF54\uB4DC\uBA85 \uC774\uC628, \uC9C4\uC758 \uC790\uB8CC\uB97C
      \uC870\uC0AC\uD574\uBCF8 \uACB0\uACFC \uC0AC\uAC74\uACFC \uC5F0\uAD00\uC774
      \uC788\uC5B4 \uBCF4\uC774\uB294 \uC778\uBB3C\uB4E4\uC758 \uBD84\uC11D\uC744
      \uB05D\uB0C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512805
    m_Localized: "\uBA85\uB2E8\uC744 \uC804\uC1A1\uD574\uB4DC\uB9B4\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512806
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512807
    m_Localized: "\uD558\uC9C0\uB9CC.. \uADF8\uB798. \uB54C\uB85C\uB294 \uC218\uC220\uC774
      \uD544\uC694\uD55C \uACBD\uC6B0\uAC00 \uC788\uACA0\uC9C0. "
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512808
    m_Localized: "\uADF8\uB7F0\uB370 \uB9D0\uC774\uB2E4. \uC0AC\uB78C\uC744 \uC0B4\uB9B4
      \uB54C \uC911\uC694\uD55C \uAC74,"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512809
    m_Localized: "<b><color=red>\uB098\uC05C \uC870\uC9C1\uC744 \uC798\uB77C\uB0B4\uB294
      \uAC83</b></color> \uBFD0 \uC544\uB2C8\uB77C, \uCE7C\uC744 \uB0B4\uB824\uB193\uACE0
      \uC0C1\uCC98\uB97C \uBD09\uD569\uD558\uB294 \uC77C\uB3C4 \uC911\uC694\uD558\uB2E8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512810
    m_Localized: "\uC798 \uBAA8\uB974\uACA0\uC5B4..."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512811
    m_Localized: "\uC6B0\uB9AC \uB538\uC740 \uB611\uB611\uD558\uB2C8\uAE4C \uC5B8\uC820\uAC00
      \uC774\uD574\uD560 \uAC70\uB77C \uC0DD\uAC01\uD55C\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512812
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512813
    m_Localized: "\uBA85\uB2E8\uC744 \uC804\uC1A1\uD574\uB4DC\uB9B4\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512814
    m_Localized: "\uC544\uB2C8..."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512815
    m_Localized: "\uBA85\uB2E8\uC744 \uC0AD\uC81C\uD574\uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512816
    m_Localized: "...\uC54C\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512817
    m_Localized: "\uC544\uBE60. \uADF8 \uB54C \uD588\uB358 \uB9D0\uC744 \uC774\uC81C\uC57C
      \uC54C\uACA0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512818
    m_Localized: "\uB098\uC05C \uAC78 \uB3C4\uB824\uB0B4\uB294 \uAC8C \uB05D\uC774
      \uC544\uB2C8\uB77C, \uB0A8\uC740 \uC0C1\uCC98\uB3C4 \uB3CC\uBD10\uC57C \uD55C\uB2E4\uB294
      \uAC78."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512819
    m_Localized: "\uB098\uB3C4 \uC774\uC81C \uADF8 \uBC29\uBC95\uC744 \uCC3E\uC544\uBCF4\uB824\uACE0
      \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512820
    m_Localized: "...\uC774\uC81C \uAC08\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512821
    m_Localized: "\uC601\uC0C1 \uAE30\uB85D\uC774 \uC885\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uCD5C\uC120\uC744 \uB2E4\uD574 \uC7AC\uAD6C\uC131\uD588\uC73C\uB098 \uC77C\uBD80\uBD84
      \uC720\uC2E4\uB41C \uC810 \uC591\uD574 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512822
    m_Localized: "...\uC774 \uC815\uB3C4\uBA74 \uAD1C\uCC2E\uC544. \uD3ED\uBC1C\uBB3C\uC758
      \uCD9C\uCC98\uB294?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512823
    m_Localized: "\uD30C\uD3B8\uC5D0\uC11C \uB098\uC628 \uBD80\uD488\uC758 \uC720\uD1B5
      \uACBD\uB85C\uB97C \uC5ED\uCD94\uC801\uD55C \uACB0\uACFC, \uC0AC\uAC74 \uC774\uD2C0
      \uC804 \uB3D9\uC77C \uACC4\uC5F4 \uD488\uBAA9\uC758 \uD310\uB9E4 \uAE30\uB85D\uC774
      \uD655\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512824
    m_Localized: "\uC7A5\uC18C\uB294 M-8 \uBE14\uB85D \uC778\uADFC \uD3D0\uB41C \uC9C0\uD558\uCCA0\uC5D0
      \uC704\uCE58\uD55C \uC554\uC2DC\uC7A5. \uD310\uB9E4\uC790\uB294 <B>\uBB34\uAE30\uC0C1
      \uC0B4\uBCF4</B>\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512825
    m_Localized: "\uADF8 \uCD1D\uAE30\uB4E4\uC744 \uD0C0\uACE0 \uB2E4\uB2CC\uB2E4\uB294
      \uC18C\uBB38\uC774 \uC788\uB294 \uAD34\uC9DC\uB188\uC778\uAC00, \uAD6C\uB9E4\uC790\uB294?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512826
    m_Localized: "\uAC00\uBA85\uC744 \uC0AC\uC6A9\uD558\uC5EC \uCD94\uC801\uC774
      \uC5B4\uB835\uC2B5\uB2C8\uB2E4. \uC544\uC2DC\uB2E4\uC2DC\uD53C \uBE44\uACF5\uC2DD
      \uC784\uBB34 \uD2B9\uC131 \uC0C1 \uC2E0\uC6D0\uC774 \uBA85\uD655\uD558\uAC8C
      \uB4DC\uB7EC\uB098\uC9C0 \uC54A\uC740 \uB300\uC0C1\uC744 \uCD94\uC801\uD558\uB294
      \uB370\uC5D0\uB294 \uC81C\uC57D\uC774 \uAC15\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512827
    m_Localized: "\uCD94\uAC00\uAE08\uC744 \uC9C0\uBD88\uD574\uB3C4 \uBD88\uAC00\uB2A5\uD55C\uAC00?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512828
    m_Localized: "\uBD88\uAC00\uB2A5\uD569\uB2C8\uB2E4. \uC9C1\uC811 \uACF5\uC2DD
      \uC784\uBB34\uB85C \uB4F1\uB85D\uD558\uC2E0\uB2E4\uBA74 \uAC00\uB2A5\uD558\uACA0\uC9C0\uB9CC,
      \uB3D9\uC2DC\uC5D0 \uB300\uC0C1\uC5D0\uAC8C\uB3C4 \uB178\uCD9C\uB420 \uAC00\uB2A5\uC131\uC774
      \uB192\uC544 \uAD8C\uC7A5\uB4DC\uB9AC\uC9C0\uB294 \uC54A\uC2B5\uB2C8\uB2E4.
      \uB2E4\uB978 \uBC29\uBC95\uC740..."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512829
    m_Localized: "\uC9C1\uC811 \uC0B4\uBCF4\uB97C <B><color=red>\uBC29\uBB38</B></color>\uD574\uC11C,
      \uC815\uBCF4\uB97C \uC5BB\uC5B4\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512830
    m_Localized: "\uC790\uB8CC\uB9CC \uD655\uBCF4\uD558\uBA74 \uC815\uBCF4 \uBD84\uC11D\uC774
      \uAC00\uB2A5\uD560\uD150\uB370 \uC815\uB9D0 <B><color=red>\uBC29\uBB38</B></color>\uD558\uC2E4\uAC74\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512831
    m_Localized: "\uB09C \uADF8\uAC8C \uB354 \uD3B8\uD574. \uB4B7\uD0C8\uB3C4 \uC801\uACE0.
      \uAC8C\uB2E4\uAC00 \uADF8\uB188\uC740 \uCDA9\uBD84\uD788 \uC120\uC744 \uB118\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512832
    m_Localized: "...\uD654\uD480\uC774 \uB300\uC0C1\uC774 \uD544\uC694\uD558\uAE30\uB3C4
      \uD558\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512833
    m_Localized: "\uD655\uC778\uD588\uC2B5\uB2C8\uB2E4. \uCD94\uAC00\uB85C, \uD574\uB2F9
      \uD3ED\uBC1C\uBB3C\uC744 \uBCD1\uC6D0\uC5D0 \uBC30\uC1A1\uD55C \uC6B4\uBC18\uCC45\uC740
      \uD2B9\uC815\uD560 \uC218 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512834
    m_Localized: "\uADF8\uAC8C \uB204\uAD6C\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512835
    m_Localized: "\uD574\uB2F9 \uC778\uBB3C\uC740 <B>\uB7A8</B> \uC774\uB77C\uB294
      \uAC70\uAD6C\uC758 \uC6A9\uBCD1\uC73C\uB85C, \uB192\uC740 \uCD9C\uB825\uC758
      \uC2E0\uCCB4 \uAC15\uD654 \uC7A5\uBE44\uB97C \uC7A5\uCC29\uD558\uACE0 \uC788\uC5B4
      \uC5B4\uB835\uC9C0 \uC54A\uAC8C \uD30C\uC545 \uAC00\uB2A5\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512836
    m_Localized: "\uB2E4\uB9CC \uB9C8\uCC2C\uAC00\uC9C0\uB85C \uB204\uAD6C\uC758
      \uC0AC\uC8FC\uB97C \uBC1B\uACE0 \uD3ED\uBC1C\uBB3C\uC744 \uC62E\uACBC\uB294\uC9C0\uB294
      \uCD94\uC801\uD560 \uC218 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512837
    m_Localized: "\uADF8 \uB140\uC11D\uB3C4 \uC9C1\uC811 <B><Color=red>\uBC29\uBB38</B></Color>\uD574\uC57C\uACA0\uAD70.
      \uD604\uC7AC \uC5B4\uB514\uC5D0 \uC788\uB294\uC9C0 \uC54C\uACE0 \uC788\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512838
    m_Localized: "\uAE30\uB2E4\uB824\uC8FC\uC138\uC694. \uD328\uB110\uC5D0 \uAD00\uB828
      \uC790\uB8CC\uB4E4\uC744 \uB4F1\uB85D\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512839
    m_Localized: "\uC2E0\uC6D0 \uD655\uC778 \uC911. \uCF54\uB4DC\uBA85 \uC774\uC628.
      \uBCF5\uADC0\uB97C \uD658\uC601\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512840
    m_Localized: "\uD68D\uB4DD\uD558\uC2E0 \uC790\uB8CC\uB294 \uC774\uBBF8 \uBD84\uC11D\uC744
      \uAC70\uC758 \uB2E4 \uB9C8\uCE5C \uC0C1\uD0DC\uC785\uB2C8\uB2E4. \uAD81\uAE08\uD55C
      \uC810\uC774 \uC788\uC73C\uC2E0\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512841
    m_Localized: "\uD3ED\uD0C4\uC758 \uBC30\uC1A1 \uBAA9\uC801. \uC65C \uC544\uBE60\uAC00
      \uC8FD\uC5B4\uC57C \uD588\uB294\uC9C0 \uC54C\uACE0 \uC2F6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512842
    m_Localized: "\uC774\uC720\uB294 \uAC04\uB2E8\uD569\uB2C8\uB2E4. \uBCA0\uC2A4\uD37C\uC5D0\uC11C\uC758
      \uD3ED\uBC1C\uC740 \uC6B0\uC5F0\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512843
    m_Localized: "...\uBB50?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512844
    m_Localized: "\uB7A8\uC758 \uB2E8\uB9D0\uAE30\uB97C \uC870\uC0AC\uD55C \uACB0\uACFC,
      \uC81C\uAC70 \uBAA9\uD45C\uB294 \uD574\uB2F9 \uC120\uBB3C\uC758 \uC6D0\uB798
      \uC218\uB839\uC778, \uC989 \uB2F9\uC2E0\uC758 \uC544\uBC84\uC9C0\uAC00 \uB2F4\uB2F9\uD558\uB358
      \uD658\uC790\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512845
    m_Localized: "\uD574\uB2F9 \uC778\uBB3C\uC740 \uBB34\uAE30, \uC815\uBCF4, \uC790\uAE08
      \uC720\uD1B5\uC744 \uAD00\uB9AC\uD558\uB294 \uC870\uC9C1, \uC2E0\uB514\uCF00\uC774\uD2B8\uC758
      \uD68C\uACC4 \uB2F4\uB2F9\uC790\uB85C \uCD94\uC815\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512846
    m_Localized: "\uC815\uD669\uC0C1 \uD3ED\uBC1C\uBB3C\uC774 \uB2F9\uC2E0\uC758
      \uC544\uBC84\uC9C0\uC5D0\uAC8C \uC804\uB2EC\uB41C \uAC83\uC740 \uACC4\uD68D\uC5D0
      \uC5C6\uB358 \uBCC0\uC218\uB85C \uBCF8\uB798\uB294 \uB300\uC0C1\uC758 \uC790\uD0DD\uC5D0\uC11C
      \uD3ED\uBC1C\uC2DC\uD0A8 \uB4A4, \uAC00\uC2A4 \uC0AC\uACE0\uB85C \uC704\uC7A5\uD560
      \uC608\uC815\uC774\uC5C8\uB358 \uAC83\uC73C\uB85C \uBCF4\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512847
    m_Localized: "\uADF8\uB7FC... \uADF8 \uC0AC\uB78C\uC740 \uD604\uC7AC \uC5B4\uB514\uC5D0
      \uC788\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512848
    m_Localized: "\uBCA0\uC2A4\uD37C \uC0AC\uACE0\uAC00 \uC788\uB358 \uB2E4\uC74C
      \uB0A0, \uC790\uD0DD\uC5D0\uC11C \uC790\uC0B4\uD55C \uCC44 \uBC1C\uACAC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uAD00\uB828 \uC790\uB8CC\uB97C \uBD84\uC11D\uD574\uBCF8 \uACB0\uACFC, <B>\uBBF8\uB77C\uC8FC</B>\uAC00
      <B><color=red>\uBC29\uBB38</b></color>\uD55C \uAC83\uC73C\uB85C \uC608\uCE21\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512849
    m_Localized: "<B>\uBBF8\uB77C\uC8FC</B>\uB77C\uBA74.. \uB208 \uC55E\uC5D0\uC11C
      \uC0AC\uB77C\uC84C\uB2E4\uAC00 \uAC11\uC790\uAE30 \uB098\uD0C0\uB098\uC11C
      \uB4F1 \uB4A4\uB97C \uCC0C\uB978\uB2E4\uB294 \uADF8 \uB140\uC11D\uC778\uAC00?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512850
    m_Localized: "\uD604\uC7AC \uB370\uC774\uD130\uBCA0\uC774\uC2A4\uC5D0 \uB4F1\uB85D\uB41C
      <B>\uBBF8\uB77C\uC8FC</B>\uC758 \uCD94\uC815 \uC704\uCE58\uB294 \uC874\uC7AC\uD558\uC9C0\uB9CC..
      \uACF5\uC2DD \uC784\uBB34\uB85C \uB4F1\uB85D\uD558\uC9C0 \uC54A\uC73C\uBA74
      \uC81C\uACF5\uD560 \uC218 \uC5C6\uB294 \uC810 \uC591\uD574 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512851
    m_Localized: "\uADF8\uB7F4 \uD544\uC694 \uC5C6\uC5B4. \uADF8 \uD68C\uACC4\uB2F4\uB2F9\uC790
      \uC9D1 \uADFC\uCC98\uC5D0\uC11C \uC54C\uC9F1\uAC70\uB9AC\uBA74 \uC54C\uC544\uC11C
      <b><color=red>\uBC29\uBB38</b></color>\uD558\uB7EC \uC62C\uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512852
    m_Localized: "\uD655\uC778\uD588\uC2B5\uB2C8\uB2E4. \uB610\uD55C \uBCC4\uAC1C\uB85C,
      \uC0D0\uBCF4\uC758 \uAC70\uB798 \uB0B4\uC5ED\uC744 \uD1B5\uD574 \uD574\uB2F9
      \uC0AC\uAC74\uACFC \uC5F0\uAD00\uB41C \uC778\uBB3C\uB4E4\uC744 \uC77C\uBD80
      \uD30C\uC545\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512853
    m_Localized: "\uC2E0\uB514\uCF00\uC774\uD2B8 \uCABD \uC0AC\uB78C\uC774\uACA0\uAD70."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512854
    m_Localized: "\uC815\uD655\uD569\uB2C8\uB2E4. \uD574\uB2F9 \uC791\uC804\uC744
      \uC8FC\uB3C4\uD55C \uC778\uBB3C\uC740 <B>\uCE90\uB10C</B>, \uADF8\uB9AC\uACE0
      \uCD5C\uC885 \uACB0\uC815\uC744 \uB0B4\uB9B0 \uC778\uBB3C\uC740 \uC2E0\uB514\uCF00\uC774\uD2B8
      \uAC04\uBD80\uC9C4\uC73C\uB85C \uCD94\uC815\uB418\uB294 \uC9C4 \uC774\uB77C\uB294
      \uC0AC\uB78C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512855
    m_Localized: "<B>\uCE90\uB10C</B>? \uADF8 \uC0AC\uB78C\uC774 \uC774\uCABD \uC0AC\uB78C\uC774\uB77C\uACE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512856
    m_Localized: "\uB300\uC678\uC801\uC73C\uB85C\uB294 \uC74C\uC545\uACFC \uB4DC\uB860
      \uD37C\uD3EC\uBA3C\uC2A4\uB97C \uACB0\uD569\uD55C \uC608\uC220\uAC00\uB85C
      \uD65C\uB3D9\uD558\uC9C0\uB9CC, \uC2E4\uC81C\uB85C\uB294 \uC2E0\uB514\uCF00\uC774\uD2B8
      \uC18C\uC18D\uC73C\uB85C \uBCF4\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512857
    m_Localized: "\uC9C4\uC758 \uC704\uCE58\uB294 \uD2B9\uC815\uD560 \uC218 \uC5C6\uC73C\uB098,
      <B>\uCE90\uB10C</B>\uC740 \uC54C\uB824\uC838 \uC788\uB294 \uC815\uBCF4\uAC00
      \uB9CE\uC544 \uC27D\uAC8C \uD2B9\uC815\uD560 \uC218 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512858
    m_Localized: "\uB2E4\uB9CC, \uC800\uD76C\uC640 \uC2E0\uB514\uCF00\uC774\uD2B8
      \uC5ED\uC2DC \uD611\uC5C5 \uAD00\uACC4\uB97C \uB9FA\uACE0 \uC788\uAE30 \uB54C\uBB38\uC5D0,
      \uAD00\uB828 \uC778\uBB3C\uC744 \uC808\uCC28 \uC5C6\uC774 <b><color=red>\uBC29\uBB38</b></color>\uD55C\uB2E4\uBA74
      \uD3B8\uC758\uB97C \uC81C\uACF5\uD558\uAE30 \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512859
    m_Localized: "\uADF8\uB798\uB3C4 \uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512860
    m_Localized: "\uB0B4\uAC00 \uC774\uB4DD\uC744 \uB530\uC84C\uC73C\uBA74 \uC5EC\uAE30\uC11C
      \uC190\uC744 \uB5BC\uACA0\uC9C0\uB9CC.."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512861
    m_Localized: "<b><color=red>\uC774\uAC74 \uC9C0\uADF9\uD788 \uAC1C\uC778\uC801\uC778
      \uBCF5\uC218\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512862
    m_Localized: "\uD655\uC778\uD588\uC2B5\uB2C8\uB2E4. \uCD9C\uBC1C\uD558\uC2DC\uAE30
      \uC804\uC5D0, \uC0AC\uC6A9 \uAC00\uB2A5\uD55C \uBAA8\uB4C8\uC744 \uD655\uC7A5\uD574\uB450\uC5C8\uC73C\uB2C8
      \uD655\uC778\uD574\uC8FC\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512863
    m_Localized: "\uC2E0\uC6D0 \uD655\uC778 \uC911. \uCF54\uB4DC\uBA85 \uC774\uC628.
      \uBCF5\uADC0\uB97C \uD658\uC601\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512864
    m_Localized: "\uD604\uC7AC \uBD84\uC11D\uC774 \uC644\uB8CC\uB41C \uB450 \uAC74\uC758
      \uC815\uBCF4\uAC00 \uC788\uC2B5\uB2C8\uB2E4. \uAD00\uC6A9\uC801\uC778 \uD45C\uD604\uC744
      \uBE4C\uB9AC\uC790\uBA74, \uC88B\uC740 \uC18C\uC2DD\uACFC \uB098\uC05C \uC18C\uC2DD\uC774
      \uC788\uC2B5\uB2C8\uB2E4. \uC5B4\uB290 \uCABD\uBD80\uD130 \uB4E4\uC73C\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512865
    m_Localized: "...\uD558\uB098\uC529 \uB9D0\uD574. \uB4E3\uACE0 \uD310\uB2E8\uD558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512866
    m_Localized: "\uADF8\uB7FC \uBA3C\uC800, \uC0AC\uC8FC\uB97C \uBC1B\uC740 \uC774\uB4E4\uC758
      \uB514\uBC14\uC774\uC2A4\uB97C \uBD84\uC11D\uD55C \uACB0\uACFC, \uC9C4\uC758
      \uD604\uC7AC \uC704\uCE58\uC640 \uC774\uB3D9 \uD328\uD134\uC744 \uD2B9\uC815\uD560
      \uC218 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512867
    m_Localized: "\uB098\uC05C \uC18C\uC2DD\uC740?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512868
    m_Localized: "\uC5BC\uB9C8 \uC804, \uC758\uB8B0\uC778 \uC9C4\uC758 \uBA85\uC758\uB85C
      \uC2E0\uADDC \uC784\uBB34\uAC00 1\uAC74 \uB4F1\uB85D\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uBC29\uBB38\uC790 \uCF54\uB4DC\uBA85 <B>\uC5D0\uCF54</B>."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512869
    m_Localized: "\uBC29\uBB38 \uB300\uC0C1. \uCF54\uB4DC\uBA85 \uC774\uC628, \uB2F9\uC2E0\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512870
    m_Localized: "\uADF8 \uC790\uC2DD\uC774 \uB08C\uC0C8\uB97C \uB9E1\uC558\uB098\uBCF4\uAD70.
      <B>\uC5D0\uCF54</B>... \uD558\uD544 \uC81C\uC77C \uC131\uAC00\uC2E0 \uC0C1\uB300\uB97C
      \uB370\uB824\uC624\uB2E4\uB2C8."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512871
    m_Localized: "\uADF8\uB7F0\uB370 ERIS. \uACF5\uC2DD \uC784\uBB34\uB85C \uC9C0\uC815\uB418\uC5C8\uC73C\uBA74
      \uC774\uC81C \uB0B4 \uD3B8\uC744 \uB4E4\uC5B4\uC904 \uC774\uC720\uAC00 \uC5C6\uB294\uB370,
      \uB098\uD55C\uD14C \uC54C\uB824\uC8FC\uB294 \uC774\uC720\uAC00 \uBB50\uC9C0? "
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512872
    m_Localized: "\uAC04\uB2E8\uD788 \uC124\uBA85\uD558\uC790\uBA74, \uC77C\uC885\uC758
      \uD22C\uC790\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512873
    m_Localized: "\uD22C\uC790?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512874
    m_Localized: "\uC544\uC2DC\uB2E4\uC2DC\uD53C, \uC6B0\uB9AC\uB294 \uBC29\uBB38\uC744
      \uD1B5\uD574 \uC0AC\uD68C\uC758 \uADE0\uD615\uC744 \uC870\uC815\uD569\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512875
    m_Localized: "\uADF8\uB7EC\uB098 \uC774\uC724\uC5D0 \uB530\uB77C \uC6C0\uC9C1\uC774\uB294
      \uC774\uB4E4\uC740 \uACB0\uAD6D \uD310\uB2E8\uC774 \uD750\uB824\uC9C0\uACE0
      \uBD80\uD328\uD558\uAE30 \uB9C8\uB828\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512876
    m_Localized: "\uBC18\uBA74\uC5D0 \uC774\uC775\uC774 \uC544\uB2C8\uB77C <b><color=red>\uC77C\uAD00\uB41C
      \uB3D9\uAE30</b></color>\uAC00 \uC6D0\uB3D9\uB825\uC774 \uB418\uC5B4 \uC6C0\uC9C1\uC774\uB294
      \uC774\uB4E4\uC740 \uC21C\uC218\uD558\uACE0 \uC608\uCE21 \uAC00\uB2A5\uD55C
      \uB3D9\uB825\uC774 \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512877
    m_Localized: "\uADF8\uB798\uC11C \uC774\uC628, \uB2F9\uC2E0\uC774 \uACC4\uC18D
      \uBC29\uBB38\uD558\uB3C4\uB85D \uB3D5\uB294 \uAC83\uC774 \uC0AC\uD68C \uC804\uCCB4\uC5D0\uB3C4
      \uC720\uC775\uD558\uB2E4\uACE0 \uD310\uB2E8\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512878
    m_Localized: "...\uC774\uD574\uD588\uC5B4. \uADF8\uB7FC \uC5B4\uB290 \uC815\uB3C4\uAE4C\uC9C0
      \uC9C0\uC6D0\uD574\uC904 \uC218 \uC788\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512879
    m_Localized: "\uC9C4\uC758 \uC704\uCE58\uB97C \uD328\uB110\uC5D0 \uB4F1\uB85D\uD574
      \uB450\uC5C8\uC2B5\uB2C8\uB2E4. \uCF54\uB4DC\uBA85 \uC5D0\uCF54\uAC00 \uC624\uAE30
      \uC804\uC5D0 \uBA3C\uC800 \uBC29\uBB38\uD560 \uAC83\uC744 \uCD94\uCC9C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512880
    m_Localized: "\uC2E0\uC6D0\uC774 \uD2B9\uC815\uB41C \uC778\uBB3C\uB4E4\uC758
      \uC704\uCE58\uB97C \uC804\uC220 \uD328\uB110\uC5D0 \uB4F1\uB85D\uD588\uC2B5\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512881
    m_Localized: "\uD574\uB2F9 \uC804\uC220 \uD328\uB110\uC744 \uD1B5\uD574 \uB300\uC0C1\uC758
      \uC815\uBCF4\uB97C \uD655\uC778\uD558\uACE0, \uD574\uB2F9 \uC704\uCE58\uB85C
      \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512882
    m_Localized: "\uD328\uB110\uC5D0 \uC811\uADFC\uD558\uBA74 \uB2E4\uC74C\uACFC
      \uAC19\uC740 \uC778\uD130\uD398\uC774\uC2A4\uAC00 \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512883
    m_Localized: "\uC6D0\uD558\uB294 \uB300\uC0C1\uC744 <B><color=red>\uBC29\uBB38</b></color>\uD558\uACE0
      \uC790\uB8CC\uB97C \uD655\uBCF4\uD558\uC138\uC694. \uC720\uD6A8\uD55C \uC790\uB8CC\uAC00
      \uD655\uBCF4\uB418\uBA74 \uBC14\uB85C \uBD84\uC11D\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512884
    m_Localized: "\uC774\uBBF8 <b><color=red>\uBC29\uBB38</b></color>\uC744 \uC644\uB8CC\uD55C
      \uB300\uC0C1\uC774\uB354\uB77C\uB3C4, \uD574\uB2F9 \uC778\uBB3C\uC758 \uB370\uC774\uD130\uB97C
      \uAE30\uB85D\uD558\uC5EC \uBC18\uBCF5\uD558\uC5EC \uC804\uD22C\uAC00 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512885
    m_Localized: "\uCD94\uAC00 \uC870\uAC74\uC744 \uB2EC\uC131\uD558\uBA74 \uBD84\uC11D\uD560
      \uC0AC\uAC74 \uC790\uB8CC \uC774\uC678\uC5D0\uB3C4 \uB354 \uB9CE\uC740 \uC804\uD22C
      \uB370\uC774\uD130\uB97C \uD655\uBCF4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512886
    m_Localized: "\uC218\uC9D1\uD55C \uB370\uC774\uD130 \uCE69\uC740 \uC774\uD6C4
      \uC7A5\uBE44\uC758 \uC131\uB2A5\uC744 \uD5A5\uC0C1\uC2DC\uD0A4\uB294 \uBAA8\uB4C8
      \uD655\uC7A5\uC5D0 \uC0AC\uC6A9\uB418\uBBC0\uB85C \uC804\uD22C\uAC00 \uAE4C\uB2E4\uB86D\uB2E4\uBA74
      \uB370\uC774\uD130 \uCE69 \uD655\uBCF4\uB97C \uC6B0\uC120\uD558\uB294 \uAC83\uC744
      \uAD8C\uC7A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512887
    m_Localized: "\uC804\uD22C \uB370\uC774\uD130 \uCE69\uC744 \uC5B4\uB290 \uC815\uB3C4
      \uD655\uBCF4 \uD558\uC168\uC73C\uB2C8, \uBAA8\uB4C8 \uD655\uC7A5 \uAE30\uB2A5\uC5D0
      \uB300\uD574 \uC124\uBA85\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512888
    m_Localized: "\uD574\uB2F9 \uBAA8\uB4C8 \uD328\uB110\uC5D0 \uC811\uADFC\uD558\uBA74
      \uC774\uC2DD\uD55C \uC7A5\uBE44\uC758 \uC131\uB2A5\uC744 \uD5A5\uC0C1\uC2DC\uD0AC
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512889
    m_Localized: "\uD328\uB110\uC5D0 \uC811\uADFC\uD558\uBA74 \uB2E4\uC74C\uACFC
      \uAC19\uC740 \uC778\uD130\uD398\uC774\uC2A4\uAC00 \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512890
    m_Localized: "\uBCF4\uC720\uD558\uC2E0 \uC804\uD22C \uB370\uC774\uD130 \uCE69\uC744
      \uC18C\uBAA8\uD558\uC5EC \uC6D0\uD558\uC2DC\uB294 \uBAA8\uB4C8\uC744 \uD655\uC7A5\uD558\uACE0,
      \uC7A5\uCC29\uD558\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333524512891
    m_Localized: "\uD655\uC7A5 \uC644\uB8CC\uD55C \uBAA8\uB4C8\uC740 \uC790\uC720\uB86D\uAC8C
      \uBCC0\uACBD\uC774 \uAC00\uB2A5\uD558\uC9C0\uB9CC, \uB3D9\uC77C\uD55C \uD0C0\uC785\uC758
      \uBAA8\uB4C8\uC740 \uC911\uBCF5\uD574\uC11C \uCC29\uC6A9\uC774 \uBD88\uAC00\uB2A5\uD558\uB2C8
      \uC8FC\uC758\uD558\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333528707072
    m_Localized: "\uC120\uD0DD\uD55C \uBAA8\uB4C8\uC744 \uB370\uC774\uD130 \uCE69\uC73C\uB85C
      \uB2E4\uC2DC \uBC18\uD658\uD560 \uC218\uB3C4 \uC788\uC73C\uB2C8, \uC804\uD22C\uAC00
      \uAE4C\uB2E4\uB86D\uB2E4\uBA74 \uC5EC\uB7EC \uBAA8\uB4C8 \uC870\uD569\uC744
      \uD65C\uC6A9\uD574\uBCF4\uC2DC\uB294 \uAC83\uC744 \uAD8C\uC7A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901376
    m_Localized: "\uC7A5\uBE44 \uC801\uC751 \uD6C8\uB828\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901377
    m_Localized: "\uBA3C\uC800 \uC7A5\uBE44 \uC774\uC2DD\uC774 \uC2E0\uACBD\uACC4\uC5D0
      \uC545\uC601\uD5A5\uC744 \uB07C\uCE58\uC9C0 \uC54A\uC558\uB294\uC9C0 \uD655\uC778\uD558\uACA0\uC2B5\uB2C8\uB2E4.
      \uC804\uBC29\uC73C\uB85C \uC774\uB3D9\uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901378
    m_Localized: "\uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901379
    m_Localized: "<sprite name=\"icon_w\"><sprite name=\"icon_a\"><sprite name=\"icon_s\"><sprite
      name=\"icon_d\"> \uD0A4\uB97C \uB20C\uB7EC \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901380
    m_Localized: "\uC6C0\uC9C1\uC784 \uC815\uC0C1. \uD2B9\uC774\uC0AC\uD56D \uC5C6\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901381
    m_Localized: "\uB2E4\uC74C\uC740 \uC21C\uAC04\uC801\uC778 \uCDA9\uACA9\uC5D0
      \uB300\uD55C \uC601\uD5A5\uC744 \uCE21\uC815\uD569\uB2C8\uB2E4. \uC67C\uC190\uC5D0
      \uB4E0 \uCD1D\uC73C\uB85C \uC0AC\uACA9\uC744 \uC2E4\uC2DC\uD574\uC8FC\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901382
    m_Localized: "\uAE30\uBCF8 \uACF5\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901383
    m_Localized: "<sprite name=\"icon_leftclick\"> \uC785\uB825\uC744 \uD1B5\uD574
      \uCEE4\uC11C \uBC29\uD5A5\uC73C\uB85C \uD0C4\uD658\uD615 \uC5D0\uB108\uC9C0
      \uCF54\uC5B4\uB97C \uBC1C\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901384
    m_Localized: "\uBC18\uB3D9 \uC81C\uC5B4 \uBC0F \uC790\uC138 \uBCF4\uC815 \uC815\uC0C1.
      \uC2E0\uCCB4 \uADE0\uD615 \uACC4\uD1B5\uC5D0 \uC774\uC0C1 \uC5C6\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901385
    m_Localized: "\uC804\uBC29 \uACA9\uBCBD\uC744 \uAC1C\uBC29\uD569\uB2C8\uB2E4.
      \uC804\uC9C4\uD574\uC8FC\uC138\uC694. "
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901386
    m_Localized: "\uB2E4\uC74C\uC740 \uB354\uBBF8\uB97C \uD65C\uC6A9\uD55C \uC801\uC751
      \uD6C8\uB828\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901387
    m_Localized: "\uBA3C\uC800, \uC801\uB300\uC801 \uAC1C\uCCB4\uC5D0\uAC8C \uC790\uB3D9\uC73C\uB85C
      \uC870\uC900\uC774 \uBCF4\uC815\uB418\uB294 \uBAA8\uB4C8\uC744 \uD14C\uC2A4\uD2B8\uD558\uACA0\uC2B5\uB2C8\uB2E4.
      \uC544\uBB34 \uACF3\uC774\uB098 \uC0AC\uACA9\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901388
    m_Localized: "\uC870\uC900 \uBCF4\uC815 \uBAA8\uB4C8 \uC774\uC0C1 \uC5C6\uC74C.
      \uD574\uB2F9 \uBAA8\uB4C8\uC740 \uC774\uD6C4 \uBD88\uD544\uC694\uD55C \uACBD\uC6B0
      \uC81C\uAC70\uD558\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901389
    m_Localized: "\uB2E4\uC74C\uC740 \uB354\uBBF8\uC758 \uC81C\uC555\uD0C4\uC744
      \uD1B5\uD574 AEGIS \uC778\uD130\uD398\uC774\uC2A4\uC758 \uC791\uB3D9 \uC5EC\uBD80\uB97C
      \uD655\uC778\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901390
    m_Localized: "\uC7A0\uC2DC\uB9CC, \uB098 \uBC29\uAE08 \uC218\uC220\uD588\uB294\uB370?"
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901391
    m_Localized: "AEGIS \uC2DC\uC2A4\uD15C\uC740 \uD53C\uACA9 \uC2DC \uCF54\uC5B4\uB97C
      \uC18C\uBAA8\uD558\uC5EC \uCE58\uBA85\uC801\uC778 \uC190\uC0C1\uC744 \uC21C\uAC04\uC801\uC73C\uB85C
      \uCC28\uB2E8\uD558\uB294 \uC911\uC694\uD55C \uAE30\uB2A5\uC73C\uB85C, \uC548\uC804\uC744
      \uC704\uD574 \uBBF8\uB9AC \uD655\uC778\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901392
    m_Localized: "\uD53C\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901393
    m_Localized: "\uC801\uC758 \uACF5\uACA9\uC5D0 \uB9DE\uC73C\uBA74 \uD0C4\uD658\uD615
      \uC5D0\uB108\uC9C0 \uCF54\uC5B4\uB97C \uBA3C\uC800 \uC18C\uBAA8\uD558\uC5EC
      \uD53C\uD574\uB97C \uD761\uC218\uD569\uB2C8\uB2E4.\n\n\uCF54\uC5B4\uAC00 \uD558\uB098\uB3C4
      \uC5C6\uB294 \uC0C1\uD0DC\uC5D0\uC11C \uD53C\uACA9\uB418\uBA74 \uC0AC\uB9DD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901394
    m_Localized: "AEGIS \uC2DC\uC2A4\uD15C \uC774\uC0C1 \uC5C6\uC74C. \uC2E0\uCCB4\uC758
      \uC190\uC0C1\uC740 \uBB34\uD6A8\uD654\uD560 \uC218 \uC788\uC73C\uB098 \uCDA9\uACA9\uACFC
      \uD1B5\uC99D\uAE4C\uC9C0\uB294 \uC644\uD654\uD560 \uC218 \uC5C6\uC73C\uB2C8
      \uCC38\uACE0\uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901395
    m_Localized: "\uB098\uB3C4 \uC54C\uC544..."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901396
    m_Localized: "\uADF8\uB9AC\uACE0 \uB9CC\uC57D \uACF5\uACA9\uC744 \uCC28\uB2E8\uD560
      \uD0C4\uD658\uD615 \uC5D0\uB108\uC9C0 \uCF54\uC5B4\uAC00 \uC874\uC7AC\uD558\uC9C0
      \uC54A\uB294\uB2E4\uBA74 AEGIS \uC2DC\uC2A4\uD15C\uC774 \uC791\uB3D9\uD558\uC9C0
      \uC54A\uC544 \uCE58\uBA85\uC0C1\uC744 \uC785\uC744 \uC218 \uC788\uC73C\uB2C8
      \uAC01\uBCC4\uD788 \uC8FC\uC758\uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901397
    m_Localized: "\uB2E4\uC74C\uC740 ARGUS \uC804\uC220 \uC758\uC548\uACFC \uC758\uC218
      \uC6B4\uB3D9 \uC81C\uC5B4\uACC4\uB97C \uD65C\uC6A9\uD55C \uD6C8\uB828\uC785\uB2C8\uB2E4.
      \uB354\uBBF8\uAC00 \uC3D8\uB294 \uD0C4\uD658\uC744 \uC694\uACA9\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901398
    m_Localized: "\uC694\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901399
    m_Localized: "<sprite name=\"icon_rightclick\"> \uC785\uB825\uC744 \uD1B5\uD574
      ARGUS \uC548\uAD6C\uB85C \uC801 \uD0C4\uB9C9\uC744 \uD3EC\uCC29\uD558\uBA74
      \uC758\uC218\uAC00 \uC790\uB3D9\uC73C\uB85C \uC694\uACA9\uC744 \uC218\uD589\uD569\uB2C8\uB2E4.\n\n\uD3EC\uCC29
      \uBC0F \uC694\uACA9\uC5D0 \uC131\uACF5\uD558\uBA74 \uC801 \uACF5\uACA9\uC744
      \uBB34\uB825\uD654\uD558\uBA70, \uD574\uB2F9 \uC5D0\uB108\uC9C0\uB97C \uC790\uB3D9\uC73C\uB85C
      \uCF54\uC5B4\uC5D0 \uD761\uC218\uD569\uB2C8\uB2E4.\n\n\uC9E7\uC740 \uC2DC\uAC04
      \uC548\uC5D0 \uC694\uACA9\uC744 \uC5F0\uC18D\uD574\uC11C \uC2E4\uD328\uD560
      \uACBD\uC6B0 ARGUS \uC548\uAD6C\uC5D0 \uBB34\uB9AC\uAC00 \uAC00\uD574\uC838
      \uC810\uC810 \uD3EC\uCC29 \uBC94\uC704\uAC00 \uAC10\uC18C\uD558\uAC8C \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901400
    m_Localized: "\uC694\uACA9\uC740 \uC804\uD22C \uC911 \uD0C4\uD658\uD615 \uC5D0\uB108\uC9C0
      \uCF54\uC5B4\uB97C \uBCF4\uCDA9\uD560 \uC218 \uC788\uB294 \uC720\uC77C\uD55C
      \uC218\uB2E8\uC785\uB2C8\uB2E4. \uD615\uD0DC\uC5D0 \uB530\uB77C \uC694\uACA9\uC774
      \uBD88\uAC00\uB2A5\uD55C \uD0C4\uB9C9\uB3C4 \uC788\uC73C\uBBC0\uB85C \uC8FC\uC758\uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901401
    m_Localized: "\uB2E4\uC74C\uC740 \uACFC\uBD80\uD558\uC5D0 \uB300\uD55C \uC124\uBA85\uC785\uB2C8\uB2E4.
      \uC5D0\uB108\uC9C0 \uCF54\uC5B4\uB294 AEGIS \uC2DC\uC2A4\uD15C\uC744 \uC720\uC9C0\uD558\uAE30
      \uC704\uD574 \uC9C0\uC18D\uC801\uC73C\uB85C \uC5D0\uB108\uC9C0\uB97C \uBC29\uCD9C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901402
    m_Localized: "\uB3D9\uC77C\uD55C \uCF54\uC5B4\uB97C \uC624\uB7AB\uB3D9\uC548
      \uC18C\uBAA8\uD558\uC9C0 \uC54A\uC73C\uBA74 \uACFC\uBD80\uD558\uB418\uC5B4
      \uC0AC\uC6A9\uC790\uC5D0\uAC8C \uC5F4\uAE30\uC5D0 \uC758\uD55C \uD53C\uD574\uB97C
      \uC785\uD790 \uC218 \uC788\uC73C\uBBC0\uB85C \uC790\uB3D9\uC73C\uB85C \uBC30\uCD9C\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901403
    m_Localized: "\uACFC\uBD80\uD558"
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901404
    m_Localized: "\uD0C4\uD658\uD615 \uC5D0\uB108\uC9C0 \uCF54\uC5B4\uB294 \uB108\uBB34
      \uC624\uB798 \uBCF4\uC720\uD558\uBA74 \uACFC\uBD80\uD558\uB418\uC5B4 \uC790\uB3D9\uC73C\uB85C
      \uBC30\uCD9C\uB429\uB2C8\uB2E4.\n\n\uD0C4\uCC3D\uC758 \uD0C4\uD658 \uC544\uC774\uCF58\uC744
      \uD1B5\uD574 \uACFC\uBD80\uD558\uAE4C\uC9C0 \uB0A8\uC740 \uC2DC\uAC04\uC744
      \uD30C\uC545\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901405
    m_Localized: "\uB2E4\uC74C\uC740 \uC804\uC220 \uD68C\uD53C\uC785\uB2C8\uB2E4.
      \uCF54\uC5B4\uAC00 \uBC29\uCD9C\uD558\uB294 \uC5D0\uB108\uC9C0\uB97C \uC77C\uBD80
      \uC7AC\uD65C\uC6A9\uD558\uC5EC, \uC21C\uAC04\uC801\uC778 \uC2E0\uCCB4 \uB2A5\uB825
      \uAC15\uD654\uB85C \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901406
    m_Localized: "\uC561\uD2F0\uBE0C \uC2A4\uD0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901407
    m_Localized: "<sprite name=\"icon_space\"> \uC785\uB825\uC744 \uD1B5\uD574 \uC561\uD2F0\uBE0C
      \uC2A4\uD0AC\uC744 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC561\uD2F0\uBE0C
      \uC2A4\uD0AC\uC5D0\uB294 \uCFE8\uD0C0\uC784\uC774 \uC788\uC73C\uBA70 \uC77C\uC815
      \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA74 \uB2E4\uC2DC \uC2A4\uD0AC\uC744 \uC0AC\uC6A9\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uD0C4\uCC3D \uD14C\uB450\uB9AC\uC758 \uC2A4\uD0AC
      \uAC8C\uC774\uC9C0\uB97C \uD1B5\uD574 \uC2A4\uD0AC \uC0AC\uC6A9 \uAC00\uB2A5
      \uC5EC\uBD80\uB97C \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901408
    m_Localized: "\uC804\uC220 \uD68C\uD53C \uC2A4\uD0AC\uC744 \uD1B5\uD574 \uC801
      \uACF5\uACA9\uC744 \uD53C\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901409
    m_Localized: "\uC774\uC2DD\uB41C \uC7A5\uBE44\uB4E4\uC758 \uAE30\uBCF8 \uD6C8\uB828\uC774
      \uB05D\uB0AC\uC2B5\uB2C8\uB2E4. \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC801 \uB354\uBBF8\uC640\uC758
      \uBAA8\uC758 \uC804\uD22C\uB97C \uC2E4\uC2DC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901410
    m_Localized: "\uACF5\uACA9, \uC694\uACA9, \uC561\uD2F0\uBE0C \uC2A4\uD0AC\uC744
      \uC801\uC808\uD558\uAC8C \uD65C\uC6A9\uD558\uC5EC \uB354\uBBF8\uB97C \uD30C\uAD34\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901411
    m_Localized: "\uC801\uC751 \uD6C8\uB828 \uC885\uB8CC. \uC815\uBCF4 \uAC31\uC2E0.
      \uCF54\uB4DC\uBA85 \uC774\uC628\uC758 \uC2E0\uCCB4 \uB2A5\uB825 \uC815\uBCF4\uB97C
      \uC0C1\uD5A5 \uC870\uC815\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901412
    m_Localized: "\uCE74\uD398 \uBCA0\uC2A4\uD37C \uAD00\uB828 \uB370\uC774\uD130
      \uBD84\uC11D\uC774 98% \uB9C8\uBB34\uB9AC\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uB85C\uBE44\uB85C
      \uBCF5\uADC0\uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901413
    m_Localized: "\uC804\uC220 \uD68C\uD53C \uC2E4\uD328. \uB2E4\uC2DC \uC2DC\uB3C4\uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901414
    m_Localized: "\uD0C4\uD658\uC5D0 \uB2FF\uAE30 \uC9C1\uC804, \uC804\uC220 \uD68C\uD53C\uB97C
      \uC218\uD589\uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 5333532901415
    m_Localized: "\uD0C4\uD658\uD615 \uC5D0\uB108\uC9C0 \uCF54\uC5B4\uAC00 \uBAA8\uB450
      \uC18C\uBAA8\uB418\uC5B4 \uC7AC\uBCF4\uAE09\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 43636894302208
    m_Localized: "\uC544\uB9C8 \uADF8 \uCABD\uB3C4 \uB0B4\uAC00 \uCC3E\uC544\uAC08
      \uAC78 \uC774\uBBF8 \uC54C\uACE0 \uC5D0\uCF54\uC640 \uD568\uAED8 \uAE30\uB2E4\uB9AC\uACE0
      \uC788\uC744\uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 43636948828160
    m_Localized: "\uC774\uB3D9 \uD6C8\uB828 {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 43636948828161
    m_Localized: "\uAE30\uBCF8 \uC0AC\uACA9 {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 43636948828162
    m_Localized: "\uAE30\uBCF8 \uACF5\uACA9 \uC801\uC911 {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 43636948828163
    m_Localized: "\uC801 \uD0C4\uD658 \uD53C\uACA9 {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 43636948828164
    m_Localized: "\uD0C4\uD658 \uC694\uACA9 {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 43636948828165
    m_Localized: "\uC2A4\uD0AC \uD68C\uD53C {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 43636948828166
    m_Localized: "\uB354\uBBF8 \uD30C\uAD34 {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 739306561925120
    m_Localized: "\uB610\uD55C \uC0AC\uACA9 \uC2DC\uC5D0\uB294 \uD0C4\uCC3D\uC5D0
      \uD45C\uC2DC\uB418\uB294 \uD0C4\uD658\uD615 \uC5D0\uB108\uC9C0 \uCF54\uC5B4\uAC00
      \uC18C\uBAA8\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1108486769008640
    m_Localized: "[ \uBAA9\uD45C ]"
    m_Metadata:
      m_Items: []
  - m_Id: 1345961062363136
    m_Localized: "\uD569\uB9AC\uC801\uC778 \uCD94\uCE21\uC785\uB2C8\uB2E4. \uADF8\uB7FC
      \uC804\uD22C \uC804\uC5D0 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uBAA8\uB4C8\uC744
      \uC810\uAC80\uD558\uC2DC\uAE38 \uAD8C\uC7A5\uB4DC\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1424586970947584
    m_Localized: "\uADF8\uB7EC\uB098 \uC81C\uAC70 \uB300\uC0C1\uC73C\uB85C \uC9C0\uC815\uB41C
      \uC774\uC720\uB294 \uD655\uC778\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1826406394068992
    m_Localized: "\uD328\uD134 \uC5B5\uC81C {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1826406452789248
    m_Localized: "\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uD328\uD134 \uC5B5\uC81C \uD6C8\uB828\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1826406452789249
    m_Localized: "\uBCF4\uC2A4\uB4E4\uC774 \uAC15\uD55C \uACF5\uACA9\uC744 \uC900\uBE44\uD560
      \uB54C \uD30C\uB780\uC0C9\uC758 \uC5D0\uB108\uC9C0 \uCF54\uC5B4\uAC00 \uB4DC\uB7EC\uB0A0
      \uB54C\uAC00 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1826406452789250
    m_Localized: "\uD574\uB2F9 \uCF54\uC5B4\uB97C \uC694\uACA9\uD560 \uC2DC \uBCF4\uC2A4\uB97C
      \uAE30\uC808\uC2DC\uD0AC \uBFD0\uB9CC \uC544\uB2C8\uB77C \uC5EC\uBD84\uC758
      \uC5D0\uB108\uC9C0\uAC00 \uC0DD\uC131\uB418\uB2C8 \uC774\uB97C \uD65C\uC6A9\uD55C\uB2E4\uBA74
      \uC804\uD22C\uB97C \uC720\uB9AC\uD558\uAC8C \uC774\uB04C\uC5B4\uAC08 \uC218
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1826406452789251
    m_Localized: "\uD328\uD134 \uC5B5\uC81C"
    m_Metadata:
      m_Items: []
  - m_Id: 1826406452789252
    m_Localized: "\uBCF4\uC2A4\uAC00 \uAC15\uD55C \uACF5\uACA9\uC744 \uC900\uBE44
      \uD560\uB54C \uD30C\uB780\uC0C9 \uC5D0\uB108\uC9C0 \uCF54\uC5B4\uAC00 \uC0DD\uC131\uB429\uB2C8\uB2E4.\n\n\uD574\uB2F9
      \uCF54\uC5B4\uB97C \uC694\uACA9\uD560 \uC2DC \uBCF4\uC2A4\uB97C \uAE30\uC808\uC2DC\uD0A4\uACE0
      \uBCF4\uC2A4 \uC8FC\uBCC0\uC5D0 \uC5EC\uBD84\uC758 \uC5D0\uB108\uC9C0\uAC00
      \uC0DD\uC131\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
