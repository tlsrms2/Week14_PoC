  - m_Id: 10790502489489408
    m_Localized: "\u3088\u308A\u826F\u3044\u30B2\u30FC\u30E0\u4F53\u9A13\u306E\u305F\u3081\u306E\u30C7\u30FC\u30BF\u53CE\u96C6\u306B\u95A2\u3059\u308B\u3054\u6848\u5185"
    m_Metadata:
      m_Items: []
  - m_Id: 10790558126931968
    m_Localized: "UNLOAD\u306F\u3001\u3088\u308A\u5B89\u5B9A\u3057\u305F\u697D\u3057\u3044\u30B2\u30FC\u30E0\u4F53\u9A13\u3092\u63D0\u4F9B\u3059\u308B\u305F\u3081\u306B\u3001Unity
      Analytics\u3092\u4F7F\u7528\u3057\u3066\u30B2\u30FC\u30E0\u30D7\u30EC\u30A4\u30C7\u30FC\u30BF\u3092\u53CE\u96C6\u3057\u307E\u3059\u3002\r\n\r\n\u53CE\u96C6\u3055\u308C\u308B\u60C5\u5831\u306B\u306F\u3001\u4EE5\u4E0B\u304C\u542B\u307E\u308C\u308B\u5834\u5408\u304C\u3042\u308A\u307E\u3059\u3002\r\n\r\n-
      \u53CE\u96C6\u9805\u76EE\uFF1A\u6A5F\u5668\u304A\u3088\u3073\u5B9F\u884C\u74B0\u5883\u60C5\u5831\u3001\u30B2\u30FC\u30E0\u9032\u884C\u72B6\u6CC1\u3001\u30D7\u30EC\u30A4\u8A18\u9332\u3001\u30A8\u30E9\u30FC\u304A\u3088\u3073\u30AF\u30E9\u30C3\u30B7\u30E5\u60C5\u5831\r\n-
      \u53CE\u96C6\u76EE\u7684\uFF1A\u30B2\u30FC\u30E0\u5185\u30A8\u30E9\u30FC\u5206\u6790\u3001\u30B2\u30FC\u30E0\u30D0\u30E9\u30F3\u30B9\u8ABF\u6574\u3001\u30B3\u30F3\u30C6\u30F3\u30C4\u6539\u5584\u304A\u3088\u3073\u30B5\u30FC\u30D3\u30B9\u54C1\u8CEA\u5411\u4E0A\r\n\r\n\u53CE\u96C6\u3055\u308C\u305F\u60C5\u5831\u306F\u3001\u30B2\u30FC\u30E0\u6539\u5584\u306E\u305F\u3081\u306E\u5206\u6790\u76EE\u7684\u306B\u306E\u307F\u4F7F\u7528\u3055\u308C\u3001\u30E6\u30FC\u30B6\u30FC\u3092\u76F4\u63A5\u7279\u5B9A\u3067\u304D\u308B\u500B\u4EBA\u60C5\u5831\u306F\u53CE\u96C6\u3057\u307E\u305B\u3093\u3002\r\n\r\n\u8A73\u7D30\u306B\u3064\u3044\u3066\u306F\u3001\u4EE5\u4E0B\u306E\u30C9\u30AD\u30E5\u30E1\u30F3\u30C8\u3092\u3054\u78BA\u8A8D\u304F\u3060\u3055\u3044\u3002\n\r\n<link=\"https://store.steampowered.com/news/app/4911370/view/715660216997250625\"><color=#00B0F0><u>\u500B\u4EBA\u60C5\u5831\u51E6\u7406\u65B9\u91DD</u></color></link>\n<link=\"https://unity.com/legal/privacy-policy\"><color=#00B0F0><u>Unity
      Privacy Policy</u></color></link>"
    m_Metadata:
      m_Items: []
