      m_Items: []
  - m_Id: 8736093915938816
    m_Localized: "\uC608"
    m_Metadata:
      m_Items: []
  - m_Id: 8736125926866944
    m_Localized: "\uC544\uB2C8\uC624"
    m_Metadata:
      m_Items: []
  - m_Id: 8737385946120192
    m_Localized: "\uC815\uB9D0 \uC774 \uC138\uC774\uBE0C \uB370\uC774\uD130\uB97C
      \uC0AD\uC81C\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 10790502489489408
    m_Localized: "\uB354 \uB098\uC740 \uAC8C\uC784 \uACBD\uD5D8\uC744 \uC704\uD55C
      \uB370\uC774\uD130 \uC218\uC9D1 \uC548\uB0B4"
    m_Metadata:
      m_Items: []
  - m_Id: 10790558126931968
    m_Localized: "UNLOAD\uB294 \uBCF4\uB2E4 \uC548\uC815\uC801\uC774\uACE0 \uC7AC\uBBF8\uC788\uB294
      \uAC8C\uC784 \uACBD\uD5D8\uC744 \uC81C\uACF5\uD558\uAE30 \uC704\uD574 Unity
      Analytics\uB97C \uC0AC\uC6A9\uD558\uC5EC \uAC8C\uC784 \uD50C\uB808\uC774 \uB370\uC774\uD130\uB97C
      \uC218\uC9D1\uD569\uB2C8\uB2E4.\r\n\r\n\uC218\uC9D1\uB418\uB294 \uC815\uBCF4\uC5D0\uB294
      \uB2E4\uC74C\uC774 \uD3EC\uD568\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n-
      \uC218\uC9D1 \uD56D\uBAA9: \uAE30\uAE30 \uBC0F \uC2E4\uD589 \uD658\uACBD \uC815\uBCF4,
      \uAC8C\uC784 \uC9C4\uD589 \uC0C1\uD669, \uD50C\uB808\uC774 \uAE30\uB85D, \uC624\uB958
      \uBC0F \uCDA9\uB3CC \uC815\uBCF4\r\n- \uC218\uC9D1 \uBAA9\uC801: \uAC8C\uC784
      \uB0B4 \uC624\uB958 \uBD84\uC11D, \uAC8C\uC784 \uBC38\uB7F0\uC2A4 \uC870\uC815,
      \uCF58\uD150\uCE20 \uAC1C\uC120 \uBC0F \uC11C\uBE44\uC2A4 \uD488\uC9C8 \uD5A5\uC0C1\r\n\r\n\uC218\uC9D1\uB41C
      \uC815\uBCF4\uB294 \uAC8C\uC784 \uAC1C\uC120\uC744 \uC704\uD55C \uBD84\uC11D
      \uBAA9\uC801\uC73C\uB85C\uB9CC \uC0AC\uC6A9\uB418\uBA70, \uC774\uC6A9\uC790\uB97C
      \uC9C1\uC811 \uC2DD\uBCC4\uD560 \uC218 \uC788\uB294 \uAC1C\uC778\uC815\uBCF4\uB294
      \uC218\uC9D1\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC790\uC138\uD55C
      \uB0B4\uC6A9\uC740 \uC544\uB798 \uBB38\uC11C\uC5D0\uC11C \uD655\uC778\uD558\uC2E4
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n<link=\"https://store.steampowered.com/news/app/4911370/view/715660216997250625\"><color=#00B0F0><u>\uAC1C\uC778\uC815\uBCF4\uCC98\uB9AC\uBC29\uCE68</u></color></link>\n<link=\"https://unity.com/legal/privacy-policy\"><color=#00B0F0><u>Unity
      Privacy Policy</u></color></link>"
    m_Metadata:
      m_Items: []
