      m_Items: []
  - m_Id: 3316497654317056
    m_Localized: "\u0410\u043A\u0442\u0438\u0432\u043D\u044B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10790558126931968
    m_Localized: "UNLOAD \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442
      Unity Analytics \u0434\u043B\u044F \u0441\u0431\u043E\u0440\u0430 \u0434\u0430\u043D\u043D\u044B\u0445
      \u0438\u0433\u0440\u043E\u0432\u043E\u0433\u043E \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0430,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0442\u044C
      \u0431\u043E\u043B\u0435\u0435 \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0439
      \u0438 \u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0439 \u0438\u0433\u0440\u043E\u0432\u043E\u0439
      \u043E\u043F\u044B\u0442.\n\n\u0421\u043E\u0431\u0438\u0440\u0430\u0435\u043C\u0430\u044F
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u043C\u043E\u0436\u0435\u0442
      \u0432\u043A\u043B\u044E\u0447\u0430\u0442\u044C \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435:\n\n-
      \u0421\u043E\u0431\u0438\u0440\u0430\u0435\u043C\u044B\u0435 \u0434\u0430\u043D\u043D\u044B\u0435:
      \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043E\u0431 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0435
      \u0438 \u0441\u0440\u0435\u0434\u0435 \u0437\u0430\u043F\u0443\u0441\u043A\u0430,
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u0438\u0433\u0440\u044B,
      \u0437\u0430\u043F\u0438\u0441\u0438 \u0438\u0433\u0440\u043E\u0432\u043E\u0433\u043E
      \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0430, \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F
      \u043E\u0431 \u043E\u0448\u0438\u0431\u043A\u0430\u0445 \u0438 \u0441\u0431\u043E\u044F\u0445\n-
      \u0426\u0435\u043B\u044C \u0441\u0431\u043E\u0440\u0430: \u0430\u043D\u0430\u043B\u0438\u0437
      \u0432\u043D\u0443\u0442\u0440\u0438\u0438\u0433\u0440\u043E\u0432\u044B\u0445
      \u043E\u0448\u0438\u0431\u043E\u043A, \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430
      \u0431\u0430\u043B\u0430\u043D\u0441\u0430, \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435
      \u043A\u043E\u043D\u0442\u0435\u043D\u0442\u0430 \u0438 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435
      \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0441\u0435\u0440\u0432\u0438\u0441\u0430\n\n\u0421\u043E\u0431\u0440\u0430\u043D\u043D\u0430\u044F
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
      \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0434\u043B\u044F \u0430\u043D\u0430\u043B\u0438\u0437\u0430 \u0441 \u0446\u0435\u043B\u044C\u044E
      \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F \u0438\u0433\u0440\u044B.
      \u041C\u044B \u043D\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u043C
      \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0435 \u0434\u0430\u043D\u043D\u044B\u0435,
      \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0438\u0435 \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E
      \u0438\u0434\u0435\u043D\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u0439.\n\n\u041F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435
      \u0441\u043C. \u0432 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0445
      \u043D\u0438\u0436\u0435.\n\n<link=\"https://store.steampowered.com/news/app/4911370/view/715660216997250625\"><color=#00B0F0><u>\u041F\u043E\u043B\u0438\u0442\u0438\u043A\u0430
      \u043A\u043E\u043D\u0444\u0438\u0434\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438</u></color></link>\n<link=\"https://unity.com/legal/privacy-policy\"><color=#00B0F0><u>\u041F\u043E\u043B\u0438\u0442\u0438\u043A\u0430
      \u043A\u043E\u043D\u0444\u0438\u0434\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438
      Unity</u></color></link>"
    m_Metadata:
