  - m_Id: 10790502489489408
    m_Localized: "\u4E3A\u4E86\u66F4\u4F73\u6E38\u620F\u4F53\u9A8C\u7684\u6570\u636E\u6536\u96C6\u6307\u5357"
    m_Metadata:
      m_Items: []
  - m_Id: 10790558126931968
    m_Localized: "UNLOAD\u4E3A\u4E86\u63D0\u4F9B\u66F4\u7A33\u5B9A\u3001\u66F4\u6709\u8DA3\u7684\u6E38\u620F\u4F53\u9A8C\uFF0C\u5C06\u4F7F\u7528Unity
      Analytics\u6536\u96C6\u6E38\u620F\u73A9\u6CD5\u6570\u636E\u3002\r\n\r\n\u6536\u96C6\u7684\u4FE1\u606F\u53EF\u80FD\u5305\u62EC\u4EE5\u4E0B\u5185\u5BB9\uFF1A\r\n\r\n-
      \u6536\u96C6\u9879\u76EE\uFF1A\u8BBE\u5907\u53CA\u8FD0\u884C\u73AF\u5883\u4FE1\u606F\u3001\u6E38\u620F\u8FDB\u5EA6\u3001\u6E38\u73A9\u8BB0\u5F55\u3001\u9519\u8BEF\u53CA\u5D29\u6E83\u4FE1\u606F\r\n-
      \u6536\u96C6\u76EE\u7684\uFF1A\u6E38\u620F\u5185\u9519\u8BEF\u5206\u6790\u3001\u6E38\u620F\u5E73\u8861\u8C03\u6574\u3001\u5185\u5BB9\u6539\u5584\u53CA\u670D\u52A1\u8D28\u91CF\u63D0\u5347\r\n\r\n\u6536\u96C6\u7684\u4FE1\u606F\u4EC5\u7528\u4E8E\u6E38\u620F\u6539\u5584\u7684\u5206\u6790\u76EE\u7684\uFF0C\u4E0D\u6536\u96C6\u53EF\u76F4\u63A5\u8BC6\u522B\u7528\u6237\u8EAB\u4EFD\u7684\u4E2A\u4EBA\u4FE1\u606F\u3002\r\n\r\n\u8BE6\u7EC6\u5185\u5BB9\u53EF\u5728\u4EE5\u4E0B\u6587\u6863\u4E2D\u8FDB\u884C\u786E\u8BA4\u3002\n\r\n<link=\"https://store.steampowered.com/news/app/4911370/view/715660216997250625\"><color=#00B0F0><u>\u4E2A\u4EBA\u4FE1\u606F\u5904\u7406\u65B9\u9488</u></color></link>\n<link=\"https://unity.com/legal/privacy-policy\"><color=#00B0F0><u>Unity
      Privacy Policy</u></color></link>"
