  - m_Id: 10790502489489408
    m_Localized: "\u70BA\u4E86\u66F4\u4F73\u904A\u6232\u9AD4\u9A57\u7684\u8CC7\u6599\u6536\u96C6\u6307\u5357"
    m_Metadata:
      m_Items: []
  - m_Id: 10790558126931968
    m_Localized: "UNLOAD\u70BA\u4E86\u63D0\u4F9B\u66F4\u7A69\u5B9A\u3001\u66F4\u6709\u8DA3\u7684\u904A\u6232\u9AD4\u9A57\uFF0C\u5C07\u4F7F\u7528Unity
      Analytics\u6536\u96C6\u904A\u6232\u904A\u73A9\u8CC7\u6599\u3002\r\n\r\n\u6536\u96C6\u7684\u8CC7\u8A0A\u53EF\u80FD\u5305\u62EC\u4EE5\u4E0B\u5167\u5BB9\uFF1A\r\n\r\n-
      \u6536\u96C6\u9805\u76EE\uFF1A\u8A2D\u5099\u53CA\u904B\u884C\u74B0\u5883\u8CC7\u8A0A\u3001\u904A\u6232\u9032\u5EA6\u3001\u904A\u73A9\u8A18\u9304\u3001\u932F\u8AA4\u53CA\u5D29\u6F70\u8CC7\u8A0A\r\n-
      \u6536\u96C6\u76EE\u7684\uFF1A\u904A\u6232\u5167\u932F\u8AA4\u5206\u6790\u3001\u904A\u6232\u5E73\u8861\u8ABF\u6574\u3001\u5167\u5BB9\u6539\u5584\u53CA\u670D\u52D9\u54C1\u8CEA\u63D0\u5347\r\n\r\n\u6536\u96C6\u7684\u8CC7\u8A0A\u50C5\u7528\u65BC\u904A\u6232\u6539\u5584\u7684\u5206\u6790\u76EE\u7684\uFF0C\u4E0D\u6536\u96C6\u53EF\u76F4\u63A5\u8B58\u5225\u7528\u6236\u8EAB\u4EFD\u7684\u500B\u4EBA\u8CC7\u8A0A\u3002\r\n\r\n\u8A73\u7D30\u5167\u5BB9\u53EF\u5728\u4EE5\u4E0B\u6587\u4EF6\u4E2D\u9032\u884C\u78BA\u8A8D\u3002\n\n<link=\"https://unity.com/legal/privacy-policy\"><color=#00B0F0><u>Unity
      Privacy Policy</u></color></link>\r\n<link=\"https://store.steampowered.com/news/app/4911370/view/715660216997250625\"><color=#00B0F0><u>\u500B\u4EBA\u8CC7\u8A0A\u8655\u7406\u65B9\u91DD</u></color></link>"
