  m_TableData:
  - m_Id: 3331155001966592
    m_Localized: "Ca\xF1\xF3n de riel"
    m_Metadata:
      m_Items: []
  - m_Id: 20524924928
    m_Localized: Pistola
    m_Metadata:
      m_Items: []
  - m_Id: 201567862784
    m_Localized: "El arma m\xE1s b\xE1sica.\n\nMunici\xF3n m\xE1xima: 5\nDa\xF1o
      de bala: 1-2-3-4-5"
    m_Metadata:
      m_Items: []
  - m_Id: 465628659712
    m_Localized: Escopeta
    m_Metadata:
      m_Items: []
  - m_Id: 753810898944
    m_Localized: "Dispara balas que se dividen en tres direcciones.\n\nMunici\xF3n
      m\xE1xima: 3\nDa\xF1o de bala: 1-2-3"
    m_Metadata:
      m_Items: []
  - m_Id: 3331352159420416
    m_Localized: "Consume toda la munici\xF3n y la dispara en una sola r\xE1faga.\n\nMunici\xF3n
      m\xE1xima: 5\nDa\xF1o de bala: 5-4-3-2-1"
    m_Metadata:
      m_Items: []
  - m_Id: 4219302263316480
    m_Localized: "Balancea el bate para reflejar proyectiles enemigos dentro del
      alcance.\nMant\xE9n presionado el bot\xF3n de ataque para ampliar el radio
      de reflejo.\nAumenta mucho la velocidad de movimiento base.\n\nMunici\xF3n
      m\xE1xima: 0\nDa\xF1o de bala: 3"
    m_Metadata:
      m_Items: []
  - m_Id: 913773264896
    m_Localized: "Mant\xE9n presionado el bot\xF3n de ataque para cargar el disparo.\nLos
      ataques cargados infligen m\xE1s da\xF1o.\n\nMunici\xF3n m\xE1xima: 3\nDa\xF1o
      de bala: 2-3-4"
    m_Metadata:
      m_Items: []
  - m_Id: 4219156515446784
    m_Localized: "Bate de b\xE9isbol"
    m_Metadata:
      m_Items: []
  - m_Id: 860581101568
    m_Localized: Rifle de francotirador
    m_Metadata:
      m_Items: []
