  m_TableData:
  - m_Id: 3331155001966592
    m_Localized: "レールガン"
    m_Metadata:
      m_Items: []
  - m_Id: 20524924928
    m_Localized: "ハンドガン"
    m_Metadata:
      m_Items: []
  - m_Id: 201567862784
    m_Localized: "最も基本的な武器です。\\n\\n最大弾数: 5\\n弾ダメージ: 1-2-3-4-5"
    m_Metadata:
      m_Items: []
  - m_Id: 465628659712
    m_Localized: "ショットガン"
    m_Metadata:
      m_Items: []
  - m_Id: 753810898944
    m_Localized: "弾が三方向に分裂して発射されます。\\n\\n最大弾数: 3\\n弾ダメージ: 1-2-3"
    m_Metadata:
      m_Items: []
  - m_Id: 3331352159420416
    m_Localized: "すべての弾薬を消費し、一度に発射します。\\n\\n最大弾数: 5\\n弾ダメージ: 5-4-3-2-1"
    m_Metadata:
      m_Items: []
  - m_Id: 4219302263316480
    m_Localized: "バットを振り、範囲内の敵投射物を反射します。\\n攻撃ボタンを長押しすると反射範囲が広がります。\\n基本移動速度が大幅に上昇します。\\n\\n最大弾数: 0\\n弾ダメージ: 3"
    m_Metadata:
      m_Items: []
  - m_Id: 913773264896
    m_Localized: "攻撃ボタンを長押ししてチャージ攻撃を行えます。\\nチャージ攻撃時はダメージが増加します。\\n\\n最大弾数: 3\\n弾ダメージ: 2-3-4"
    m_Metadata:
      m_Items: []
  - m_Id: 4219156515446784
    m_Localized: "野球バット"
    m_Metadata:
      m_Items: []
  - m_Id: 860581101568
    m_Localized: "スナイパーライフル"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
