  m_TableData:
  - m_Id: 3331155001966592
    m_Localized: "Canh\xE3o el\xE9trico"
    m_Metadata:
      m_Items: []
  - m_Id: 20524924928
    m_Localized: Pistola
    m_Metadata:
      m_Items: []
  - m_Id: 201567862784
    m_Localized: "A arma mais b\xE1sica.\n\nMuni\xE7\xE3o m\xE1xima: 5\nDano da bala:
      1-2-3-4-5"
    m_Metadata:
      m_Items: []
  - m_Id: 465628659712
    m_Localized: Escopeta
    m_Metadata:
      m_Items: []
  - m_Id: 753810898944
    m_Localized: "Dispara balas que se dividem em tr\xEAs dire\xE7\xF5es.\n\nMuni\xE7\xE3o
      m\xE1xima: 3\nDano da bala: 1-2-3"
    m_Metadata:
      m_Items: []
  - m_Id: 3331352159420416
    m_Localized: "Consome toda a muni\xE7\xE3o e dispara tudo em uma \xFAnica rajada.\n\nMuni\xE7\xE3o
      m\xE1xima: 5\nDano da bala: 5-4-3-2-1"
    m_Metadata:
      m_Items: []
  - m_Id: 4219302263316480
    m_Localized: "Balance o taco para refletir proj\xE9teis inimigos dentro do alcance.\nSegure
      o bot\xE3o de ataque para aumentar o raio de reflex\xE3o.\nAumenta bastante
      a velocidade de movimento base.\n\nMuni\xE7\xE3o m\xE1xima: 0\nDano da bala:
      3"
    m_Metadata:
      m_Items: []
  - m_Id: 913773264896
    m_Localized: "Segure o bot\xE3o de ataque para carregar o disparo.\nAtaques carregados
      causam mais dano.\n\nMuni\xE7\xE3o m\xE1xima: 3\nDano da bala: 2-3-4"
    m_Metadata:
      m_Items: []
  - m_Id: 4219156515446784
    m_Localized: Taco de beisebol
    m_Metadata:
      m_Items: []
  - m_Id: 860581101568
    m_Localized: "Rifle de precis\xE3o"
    m_Metadata:
      m_Items: []
