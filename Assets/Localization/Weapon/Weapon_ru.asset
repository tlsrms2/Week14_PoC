  - m_Id: 3331155001966592
    m_Localized: "\u0420\u0435\u043B\u044C\u0441\u043E\u0442\u0440\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 20524924928
    m_Localized: "\u041F\u0438\u0441\u0442\u043E\u043B\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 201567862784
    m_Localized: "\u0421\u0430\u043C\u043E\u0435 \u0431\u0430\u0437\u043E\u0432\u043E\u0435
      \u043E\u0440\u0443\u0436\u0438\u0435.\n\n\u041C\u0430\u043A\u0441. \u0431\u043E\u0435\u0437\u0430\u043F\u0430\u0441:
      5\n\u0423\u0440\u043E\u043D \u043F\u0443\u043B\u0438: 1-2-3-4-5"
    m_Metadata:
      m_Items: []
  - m_Id: 465628659712
    m_Localized: "\u0414\u0440\u043E\u0431\u043E\u0432\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 753810898944
    m_Localized: "\u0412\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u043F\u0443\u043B\u0438,
      \u0440\u0430\u0437\u0434\u0435\u043B\u044F\u044E\u0449\u0438\u0435\u0441\u044F
      \u043D\u0430 \u0442\u0440\u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F.\n\n\u041C\u0430\u043A\u0441.
      \u0431\u043E\u0435\u0437\u0430\u043F\u0430\u0441: 3\n\u0423\u0440\u043E\u043D
      \u043F\u0443\u043B\u0438: 1-2-3"
    m_Metadata:
      m_Items: []
  - m_Id: 3331352159420416
    m_Localized: "\u0420\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442 \u0432\u0435\u0441\u044C
      \u0431\u043E\u0435\u0437\u0430\u043F\u0430\u0441 \u0438 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442
      \u0435\u0433\u043E \u043E\u0434\u043D\u0438\u043C \u0437\u0430\u043B\u043F\u043E\u043C.\n\n\u041C\u0430\u043A\u0441.
      \u0431\u043E\u0435\u0437\u0430\u043F\u0430\u0441: 5\n\u0423\u0440\u043E\u043D
      \u043F\u0443\u043B\u0438: 5-4-3-2-1"
    m_Metadata:
      m_Items: []
  - m_Id: 4219302263316480
    m_Localized: "\u0412\u0437\u043C\u0430\u0445\u043D\u0438\u0442\u0435 \u0431\u0438\u0442\u043E\u0439,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u0440\u0430\u0436\u0430\u0442\u044C
      \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0435 \u0441\u043D\u0430\u0440\u044F\u0434\u044B
      \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F.\n\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435
      \u043A\u043D\u043E\u043F\u043A\u0443 \u0430\u0442\u0430\u043A\u0438, \u0447\u0442\u043E\u0431\u044B
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u044C \u0440\u0430\u0434\u0438\u0443\u0441
      \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u044F.\n\u0417\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442 \u0431\u0430\u0437\u043E\u0432\u0443\u044E
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F.\n\n\u041C\u0430\u043A\u0441.
      \u0431\u043E\u0435\u0437\u0430\u043F\u0430\u0441: 0\n\u0423\u0440\u043E\u043D
      \u043F\u0443\u043B\u0438: 3"
    m_Metadata:
      m_Items: []
  - m_Id: 913773264896
    m_Localized: "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435
      \u043A\u043D\u043E\u043F\u043A\u0443 \u0430\u0442\u0430\u043A\u0438, \u0447\u0442\u043E\u0431\u044B
      \u0437\u0430\u0440\u044F\u0434\u0438\u0442\u044C \u0432\u044B\u0441\u0442\u0440\u0435\u043B.\n\u0417\u0430\u0440\u044F\u0436\u0435\u043D\u043D\u044B\u0435
      \u0430\u0442\u0430\u043A\u0438 \u043D\u0430\u043D\u043E\u0441\u044F\u0442 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u044B\u0439
      \u0443\u0440\u043E\u043D.\n\n\u041C\u0430\u043A\u0441. \u0431\u043E\u0435\u0437\u0430\u043F\u0430\u0441:
      3\n\u0423\u0440\u043E\u043D \u043F\u0443\u043B\u0438: 2-3-4"
    m_Metadata:
      m_Items: []
  - m_Id: 4219156515446784
    m_Localized: "\u0411\u0435\u0439\u0441\u0431\u043E\u043B\u044C\u043D\u0430\u044F
      \u0431\u0438\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 860581101568
    m_Localized: "\u0421\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0430\u044F
      \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430"
    m_Metadata:
