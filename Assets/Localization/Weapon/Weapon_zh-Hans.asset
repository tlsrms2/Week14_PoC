  m_TableData:
  - m_Id: 3331155001966592
    m_Localized: "轨道炮"
    m_Metadata:
      m_Items: []
  - m_Id: 20524924928
    m_Localized: "手枪"
    m_Metadata:
      m_Items: []
  - m_Id: 201567862784
    m_Localized: "最基础的武器。\\n\\n最大弹药量: 5\\n子弹伤害: 1-2-3-4-5"
    m_Metadata:
      m_Items: []
  - m_Id: 465628659712
    m_Localized: "霰弹枪"
    m_Metadata:
      m_Items: []
  - m_Id: 753810898944
    m_Localized: "子弹会分裂成三个方向发射。\\n\\n最大弹药量: 3\\n子弹伤害: 1-2-3"
    m_Metadata:
      m_Items: []
  - m_Id: 3331352159420416
    m_Localized: "消耗所有弹药，一次性发射。\\n\\n最大弹药量: 5\\n子弹伤害: 5-4-3-2-1"
    m_Metadata:
      m_Items: []
  - m_Id: 4219302263316480
    m_Localized: "挥动球棒，反射范围内的敌方投射物。\\n按住攻击按钮会扩大反射范围。\\n基础移动速度大幅提升。\\n\\n最大弹药量: 0\\n子弹伤害: 3"
    m_Metadata:
      m_Items: []
  - m_Id: 913773264896
    m_Localized: "按住攻击按钮可进行蓄力攻击。\\n蓄力攻击时伤害会提高。\\n\\n最大弹药量: 3\\n子弹伤害: 2-3-4"
    m_Metadata:
      m_Items: []
  - m_Id: 4219156515446784
    m_Localized: "棒球棒"
    m_Metadata:
      m_Items: []
  - m_Id: 860581101568
    m_Localized: "狙击步枪"
    m_Metadata:
      m_Items: []
  references:
