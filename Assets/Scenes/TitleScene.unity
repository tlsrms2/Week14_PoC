  titleLabel: "\uB85C\uADF8 \uC218\uC9D1 \uB3D9\uC758"
  contentLabel: "\uC774 \uAC8C\uC784\uC740 \uC11C\uBE44\uC2A4 \uAC1C\uC120\uC744
    \uC704\uD574 \uC544\uB798\uC640 \uAC19\uC740 \uB85C\uADF8 \uB370\uC774\uD130\uB97C
